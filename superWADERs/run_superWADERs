    return 0


def check_request(args):
    """Checks with the standard library only (before the environment is looked for)."""
    run_name, files = read_inputs(args.input)
    if args.campaign:
        out = os.path.abspath(os.path.expanduser(args.campaign))
        if os.path.isdir(out) and os.listdir(out) and not os.path.exists(os.path.join(out, "campaign.json")):
            die(f"{out} exists and is not a campaign folder (no campaign.json); give a new or a campaign folder")
        if args.overwrite:
            die("--overwrite cannot be used with --campaign (inputs already there are kept and skipped; --reprocess "
                "processes them again; to start from nothing, give a new folder)")
    else:
        out = os.path.join(os.path.abspath(args.parent), OUT_PREFIX + run_name)
        if os.path.exists(out) and os.listdir(out) and not args.overwrite:
            die(f"{out} already exists; use --overwrite to replace it, or --campaign {out} to add these inputs to it")
    if args.criteria and not os.path.isfile(args.criteria):
        die(f"--criteria {args.criteria} not found")
    if args.jobs < 1:
        die("-j/--jobs must be at least 1")
    stems = {}
    for p in files:
        if not RAW_INPUT.search(p):            # the channel files of one raw image share a name
            stems.setdefault(image_stem(p), []).append(p)
    dup = {s: ps for s, ps in stems.items() if len(ps) > 1}
    if dup:
        die("images with the same name would overwrite each other's results: "
            + "; ".join(f"{s}: {', '.join(ps)}" for s, ps in sorted(dup.items())))
    try:
        auto = shlex.split(args.autoconfig_args)
    except ValueError as e:
        die(f"--autoconfig-args cannot be parsed ({e})")
    bad = sorted({a.split("=")[0] for a in auto} & set(RESERVED_AUTOCONFIG))
    if bad:
        die(f"{', '.join(bad)} cannot be given in --autoconfig-args (use --tune, --gain, --thresholds)")
    if args.thresholds not in ("auto", "sigma0"):
        try:
            _ = [float(v) for v in args.thresholds.split(",")]
            assert len(_) == 2
        except (ValueError, AssertionError):
            die("--thresholds: auto, sigma0 or PIX,SEED in electrons (e.g. 2.5,9.5)")
    if args.composite:
        if args.no_clusters:
            die("--composite needs the cluster files; it cannot be used with --no-clusters")
        args.composite_macro = os.path.abspath(os.path.expanduser(args.composite_macro))
        if not os.path.isfile(args.composite_macro):
            die(f"MakeComposite macro {args.composite_macro} not found; give --composite-macro PATH")
    if args.packet and (args.gain_correction or args.composite or args.dc_series or args.defect_map or args.sr):
        die("--packet makes the packet reports only; run the other tools separately")
    return run_name, files, out, parse_modules(args.module)


def prepare_output(run):
    if not run.args.campaign and os.path.exists(run.out) and os.listdir(run.out):
        shutil.rmtree(run.out)                 # --overwrite (checked in check_request)
    run.dirs = {k: os.path.join(run.out, k) for k in ("root", "logs")}
    for d in run.dirs.values():
        os.makedirs(d, exist_ok=True)
    if "_ext" in run.out:
        print("WARNING: the output path contains '_ext'; scripts that read the extension from '_ext<N>' in the path "
              "(MakeComposite_Fe55_Clusters_Extensions.cc) may misread it")


def raw_inputs(run, l1_skips=None):
    """Level-0 traces -> L0/ (only those not yet in the campaign); level-1 images -> L1/ FITS images, which join the
    images (converted once; later runs reuse the FITS). Returns (images, the FITS made from level-1 data)."""
    raw = [p for p in run.images if RAW_INPUT.search(p)]
    images = [p for p in run.images if not RAW_INPUT.search(p)]
    if not raw:
        return images, []
    import raw_data as RD
    args, lines, camp = run.args, run.lines["raw"], run.camp
    kinds = {p: RD.kind(p) for p in raw}
    l0 = [p for p, k in kinds.items() if k == "L0"]
    new0 = [p for p in l0 if args.reprocess or not camp.has(p, "L0")]
    if l0:
        run.say(f"level-0 traces: {len(new0)} new of {len(l0)}")
        if new0:
            lines += RD.report_l0(new0, os.path.join(run.out, "L0"), html=not args.l0_no_html) + [""]
        for p in new0:
            camp.add(p, "L0", kind="L0")
    l1 = [p for p, k in kinds.items() if k == "L1"]
    made = []
    by_base = {}
    for p in l1:
        by_base.setdefault(RD.base_of(p), []).append(p)
    for base, chans in sorted(by_base.items()):
        prev = [f for p in chans for f in ((camp.entry(p) or {}).get("made") or [])]
        if not args.reprocess and prev and all(camp.has(p, "L1") for p in chans) and all(os.path.exists(f) for f in prev):
            made += sorted(set(prev))
            continue
        run.say(f"level-1 image {os.path.basename(base)} -> FITS")
        mk, ls = RD.convert_l1(chans, l1_skips or args.l1_skips, args.l1_skip_first, os.path.join(run.out, "L1"))
        lines += [f"level-1 image -> FITS images with N skips (L1/; header from the .meta):"] + ls + [""]
        for p in chans:
            camp.add(p, "L1", kind="L1")
            camp.entry(p)["made"] = mk
        made += mk
    other = [p for p, k in kinds.items() if k == "raw"]
    if other:
        lines += ["not read (DAQ binaries of averaged images: give their avg_*.fits): "
                  + ", ".join(os.path.basename(p) for p in other), ""]
    return images + made, made


def packet_traces(run, paths):
    """--packet: the level-0 traces / PSD traces not yet in the campaign -> records/packet/ (packet_report.file_items)."""
    import packet_report as PR
    cls = PR.classify(paths)
    for kind in ("trace", "psd"):
        for p in sorted(cls[kind]):
            if not run.args.reprocess and run.camp.has(p, "packet") and run.camp.has_record("packet", os.path.basename(p)):
                continue
            run.say(f"{kind} {os.path.basename(p)}")
            run.camp.save_record("packet", os.path.basename(p), PR.file_items(p, kind))
            run.camp.add(p, "packet", kind=kind, dataset=run.dataset)
    return cls


def front_end(run, NP, images, base_kw):
    """characterisation of every image (engine/characterise.py) and one task (path to process, keyword arguments)
    per image. Returns (tasks, records)."""
    args = run.args
    run.say(f"characterisation of {len(images)} image(s)")
    tasks, recs, skipped = NP.auto_tasks(images, run.out, base_kw, args.gain, args.gain_file, args.skip_start,
                                         log=lambda m: run.say(m.strip()), pool=args.clusterer == "auto")
    lines = run.lines["front"]
    for f, why in skipped:
        lines.append(f"  NOT PROCESSED {os.path.basename(f)}: {why}")
        run.failed.append((image_stem(f), "all", why))
    for rec in recs:
        if not rec.get("process"):
            continue
        if rec.get("compressed"):
            lines.append(f"  {rec['stem']}: skip-resolved raw file, compressed to {rec['process_path']}")
        for fb in rec.get("fallbacks", []):
            lines.append(f"  {rec['stem']}: {fb}")
        for ext, c in sorted(rec.get("ccds", {}).items()):
            gsrc = (c.get("gain") or {}).get("source")
            if gsrc not in (None, "comb"):
                lines.append(f"  {rec['stem']} {ext}: GAIN NOT MEASURED ON THIS CCD -> {c['gain']['value']:.4f} "
                             f"ADU/e- from {gsrc}")
            if c.get("channel", {}).get("value") == "quiet":
                lines.append(f"  {rec['stem']} {ext}: 'no CCD signal' by autoconfig but a sharp zero peak -> kept "
                             f"('quiet': cannot be told from a very low dark charge)")
    return tasks, recs


def native_record(img, s):
    """The per-image record of the gain-correction, composite and summary steps, from a process_image summary."""
    ccds = s["ccds"]
    notes = []
    for e, c in sorted(ccds.items()):
        if "gain_note" in c:
            notes.append(f"  {e}: {c['gain_note']}")
            if c.get("pedestal_note"):
                notes.append(f"  {e}: NOTE {c['pedestal_note']}")
        else:
            notes.append(f"  {e}: not run ({c.get('skipped')})")
    return dict(stem=s["stem"], src=img, orig=img, summary=s, notes=notes,
                fits={"dc": {e: c["fits"]["dc"] for e, c in ccds.items() if "fits" in c and "dc" in c["fits"]}},
                final={e: c["fits"]["final"] for e, c in ccds.items() if "fits" in c},
                held={e: tuple(c["held"]) for e, c in ccds.items() if c.get("held")},
                refs={e: c["lam01"] for e, c in ccds.items() if c.get("lam01") is not None},
                skipped=sorted(e for e, c in ccds.items() if "skipped" in c))


def save_image_record(run, rec):
    """The record in the campaign: the core (records/images/) and the big parts apart (records/images_packet/,
    records/images_sr/), so that the overviews read only the cores."""
    parts = {k: rec.pop(k) for k in ("packet", "sr") if k in rec}
    rec["parts"] = sorted(parts)
    run.camp.save_record("images", rec["stem"], rec)
    for k, v in parts.items():
        run.camp.save_record(f"images_{k}", rec["stem"], v)


def process(run, NP, tasks, records=True):
    """The worker on every task (path, out, process_image keyword arguments, record options), -j images at a time
    (one process each). records: make and keep the campaign record (False: fits only, e.g. the g(n) pre-pass).
    Returns {path: record core (records) or native summary}."""
    from multiprocessing import get_context
    import worker as W
    done = {}
    if not tasks:
        return done
    fn = W.image_job if records else NP._job
    with cf.ProcessPoolExecutor(max_workers=max(1, min(run.args.jobs, len(tasks))), mp_context=get_context("spawn")) as ex:
        futs = {ex.submit(fn, t if records else t[:3]): t[0] for t in tasks}
        for fut in cf.as_completed(futs):
            img = futs[fut]
            res = fut.result()
            rec, err = (res[1], res[2]) if records else res
            if err:
                run.say(f"{image_stem(img)}: FAILED ({err.splitlines()[0]})")
                with open(os.path.join(run.dirs["logs"], f"{image_stem(img)}.log"), "w") as fh:
                    fh.write(err)
                run.failed.append((image_stem(img), "all", err.splitlines()[0]))
                continue
            s = rec["summary"] if records else rec
            if records:
                save_image_record(run, rec)
            done[img] = rec
            for e, c in sorted(s["ccds"].items()):
                if "gain" not in c:
                    run.say(f"{s['stem']} {e}: not run ({c.get('skipped')})")
                    continue
                nc = ", ".join(f"{k} {v['n_clusters']} ({v.get('chain')})" for k, v in c.items()
                               if isinstance(v, dict) and "n_clusters" in v)
                run.say(f"{s['stem']} {e}: gain {c['gain']:.4f} ADU/e-, noise {c['noise_e']:.3f} e-, "
                        f"DC {c['dc_e']:.4f} e-/pix" + (f"; clusters: {nc}" if nc else ""))
    return done


# ---- g(n) curves (--gain-correction) ---------------------------------------------------------------------------
def _image_time(stem):
    m = re.search(r"_(\d{8})_(\d{6})(?:_|$)", stem)
    return m.group(1) + m.group(2) if m else ""


def module_groups(run, configs, GVC, FQ):
    """Images sharing one g(n) curve: ({key: [records]}, {key: module}, lines). key = ACM id, or <ACM>_period<k>
    where the gain of all the module's CCDs steps (--gain-periods auto; gain_vs_charge.gain_periods)."""
    import numpy as np
    modules = {}
    for r in configs.values():
        modules.setdefault(acm_id(r["stem"]) or r["stem"], []).append(r)
    groups, parent, lines = {}, {}, []
    for key, rs in sorted(modules.items()):
        rs = sorted(rs, key=lambda r: (_image_time(r["stem"]), r["stem"]))
        gains = []
        for r in rs:
            fits = r.get("fits", {}).get("dc", {})
            q = {e: FQ.quality(f) for e, f in fits.items() if e not in r.get("skipped", ())}
            gains.append({e: (v["gain"], max(v["gain_err_s"], 1e-4)) for e, v in q.items() if v.get("gain")})
        exts = sorted({e for g in gains for e in g})
        med = {e: float(np.median([g[e][0] for g in gains if e in g])) for e in exts}
        x, s, have = [], [], []
        for i, g in enumerate(gains):
            if g:
                d = np.array([np.log(v / med[e]) for e, (v, _) in g.items()])
                w = np.array([(v / err) ** 2 for e, (v, err) in g.items()])
                x.append(float(np.sum(w * d) / w.sum()))
                s.append(float(w.sum() ** -0.5))
                have.append(i)
        label = np.zeros(len(rs), int)
        bad = []
        if run.args.gain_periods == "auto" and len(have) >= 4:
            lab, bad = GVC.gain_periods(x, s)
            for i in range(len(rs)):
                j = max([k for k, h in enumerate(have) if h <= i], default=0)
                label[i] = lab[j]
        if label.max() == 0:
            groups[key], parent[key] = rs, key
            continue
        lines.append(f"  module {key}: {label.max() + 1} gain periods (the gain of its CCDs steps; one curve each):")
        rel = dict(zip(have, x))
        for k in range(label.max() + 1):
            members = [r for r, lb in zip(rs, label) if lb == k]
            ids = [i for i, lb in enumerate(label) if lb == k]
            gk = f"{key}_period{k + 1}"
            groups[gk], parent[gk] = members, key
            v = [rel[i] for i in ids if i in rel]
            lines.append(f"    period {k + 1}: {len(members)} image(s), {members[0]['stem']} .. {members[-1]['stem']}"
                         + (f", gain {np.median(v) * 100:+.2f} % vs module median" if v else ""))
        out = [rs[i]["stem"] for i, b in zip(have, bad) if b]
        if out:
            lines.append(f"    single-image gain outliers (kept in their period): {', '.join(out)}")
    return groups, parent, lines


def measure_curve(run, GVC, rs, name, title, run_exts):
    res = GVC.measure([r["src"] for r in rs], run_exts, verbose=False, model=run.args.gain_model,
                      combine=run.args.gain_combine, autoconfig_args=shlex.split(run.args.autoconfig_args),
                      memory=run.args.gain_memory)
    mpath = os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.json")
    with open(mpath, "w") as fh:
        json.dump({"images": [r["orig"] for r in rs], "e_per_electron_eV": GVC.E_PER_E, "extensions": res}, fh, indent=1)
    GVC.plot(res, os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.png"), title)
    GVC.plot_nonlinearity(res, os.path.join(run.dirs["gc"], f"{name}_nonlinearity.png"), title)
    return mpath, res


def report_curve(lines, title, res):
    for ext, rr in sorted(res.items()):
        if rr.get("ok"):
            m = rr["model"]
            lines.append(f"  {title} {ext}: g(0) = {m['a']:.4f} ADU/e- (comb gain {rr['g_1e']:.4f}), "
                         f"{rr['drop_at_1000'] * 100:.1f}% lower at 1000 e-, measured to {rr['n_max_measured']:.0f} e-"
                         + (f" -- module curve: own comb not usable ({rr.get('own_reason')})"
                            if rr.get("source") == "module" else "")
                         + (f" [readout memory removed, kL {rr['memory']['kL']:.2e}]" if rr.get("memory") else ""))
        else:
            lines.append(f"  {title} {ext}: no correction ({rr.get('reason')})")


def gain_curves(run, GVC, FQ, configs, run_exts, modes):
    """g(n) curves in gain_vs_charge/: per module or gain period, and per image with 'per-image' in modes (module
    curve where the image's own comb is not usable). Returns {(mode, image stem): model file}."""
    lines = run.lines["gc"]
    groups, parent, period_lines = module_groups(run, configs, GVC, FQ)
    curves, module_res, whole = {}, {}, {}
    lines.append(f"gain vs charge per pixel (--gain-correction {run.args.gain_correction}, --gain-model "
                 f"{run.args.gain_model}; from the electron comb in clean rows):")
    lines += period_lines
    for key, rs in sorted(groups.items()):
        run.say(f"g(n) for module {key} ({len(rs)} image(s))")
        mpath, res = measure_curve(run, GVC, rs, f"module_{key}", f"module {key}", run_exts)
        if key != parent[key] and not all(rr.get("ok") for rr in res.values()):
            m = parent[key]
            if m not in whole:
                whole[m] = measure_curve(run, GVC, [r for k, v in groups.items() if parent[k] == m for r in v],
                                         f"module_{m}", f"module {m}", run_exts)[1]
            replaced = False
            for ext, rr in res.items():
                rr.setdefault("source", "own")
                if not rr.get("ok") and whole[m].get(ext, {}).get("ok"):
                    res[ext] = dict(whole[m][ext], source="module", own_reason=rr.get("reason"))
                    replaced = True
            if replaced:
                with open(mpath, "w") as fh:
                    json.dump({"images": [r["orig"] for r in rs], "e_per_electron_eV": GVC.E_PER_E, "extensions": res},
                              fh, indent=1)
        report_curve(lines, f"module {key}", res)
        module_res[key] = res
        if "pooled" in modes:
            curves.update({("pooled", r["stem"]): mpath for r in rs})
    if "per-image" in modes:
        lines.append("one curve per image (a CCD whose own comb is not usable gets the module curve):")
        for key, rs in sorted(groups.items()):
            for r in sorted(rs, key=lambda r: r["stem"]):
                run.say(f"g(n) for image {r['stem']}")
                mpath, res = measure_curve(run, GVC, [r], f"image_{r['stem']}", r["stem"], run_exts)
                for ext, rr in res.items():
                    rr["source"] = "image"
                    mod = module_res[key].get(ext, {})
                    if not rr.get("ok") and mod.get("ok"):
                        res[ext] = dict(mod, source="module", own_reason=rr.get("reason"))
                with open(mpath, "w") as fh:
                    json.dump({"images": [r["orig"]], "e_per_electron_eV": GVC.E_PER_E, "extensions": res}, fh, indent=1)
                report_curve(lines, r["stem"], res)
                curves[("per-image", r["stem"])] = mpath
    return curves


def front_kalpha(files):
    """Front-side Fe-55 K-alpha (sigma_xy < 1, 4.5 < E < 7 keV, as MakeComposite): unbinned fit of K-alpha + K-beta
    (6.490/5.899 x K-alpha, same width) + flat background. Returns (mu, err, n) or None."""
    import numpy as np
    import ROOT
    from scipy import optimize
    E = []
    for f in files:
        tf = ROOT.TFile.Open(f)
        t = tf.Get("clustersRec") if tf else None
        if t and isinstance(t, ROOT.TTree):
            for i in range(t.GetEntries()):
                t.GetEntry(i)
                sx, sy = np.array(list(t.fSTD_X)), np.array(list(t.fSTD_Y))
                e = np.array(list(t.Energy))
                E.append(e[(np.sqrt(0.5 * (sx ** 2 + sy ** 2)) < 1) & (e > 4.5) & (e < 7.0)])
        if tf:
            tf.Close()
    e = np.concatenate(E) if E else np.array([])
    if e.size < 30:
        return None
    lo, hi, r = 4.5, 7.0, 6.490 / 5.899

    def nll(p):
        mu, s, fb, fbg = p
        g = lambda m: np.exp(-0.5 * ((e - m) / s) ** 2) / (s * np.sqrt(2 * np.pi))
        v = (1 - fbg) * ((1 - fb) * g(mu) + fb * g(mu * r)) + fbg / (hi - lo)
        return np.inf if np.any(v <= 0) else -np.sum(np.log(v))
    sel = e[(e > 5.0) & (e < 6.2)]
    res = optimize.minimize(nll, [np.median(sel) if sel.size else 5.8, 0.1, 0.15, 0.1], method="L-BFGS-B",
                            bounds=[(5.0, 6.3), (0.03, 0.5), (0.0, 0.5), (1e-4, 0.9)])
    h = 1e-3
    curv = (nll(res.x + [h, 0, 0, 0]) - 2 * nll(res.x) + nll(res.x - [h, 0, 0, 0])) / h ** 2
    return float(res.x[0]), float(1 / np.sqrt(curv)) if curv > 0 else float("nan"), int(e.size)


def compare_gain_corrections(run, configs, curves, gc_dirs):
    """--gain-correction both: per image and CCD, the image's own curve vs the module curve
    (gain_vs_charge/per_image_vs_pooled.csv). Returns summary lines."""
    import csv
    import numpy as np
    import ROOT
    rows = []
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        mp = json.load(open(curves[("pooled", r["stem"])]))["extensions"]
        mi = json.load(open(curves[("per-image", r["stem"])]))["extensions"]
        for ext in sorted(set(mp) | set(mi)):
            p, q = mp.get(ext, {}), mi.get(ext, {})
            row = dict(image=r["stem"], ext=ext, pooled_ok=bool(p.get("ok")), per_image_ok=bool(q.get("ok")),
                       per_image_source=q.get("source", "image"))
            for tag, m in (("pooled", p), ("per_image", q)):
                row[f"a_{tag}"] = round(m["model"]["a"], 5) if m.get("ok") else ""
                row[f"drop1000_{tag}_pct"] = round(m["drop_at_1000"] * 100, 3) if m.get("ok") else ""
            if not run.args.no_clusters:
                name = f"panaSKImg_clustersRec_{r['stem']}_ext{ext[3:]}.root"
                fp, fi = os.path.join(gc_dirs["pooled"], name), os.path.join(gc_dirs["per-image"], name)
                ratios, fk_p, fk_i = [], None, None
                if os.path.exists(fp) and os.path.exists(fi):
                    tp, ti = ROOT.TFile.Open(fp), ROOT.TFile.Open(fi)
                    a_, b_ = tp.Get("clustersRec"), ti.Get("clustersRec")
                    if a_ and b_ and isinstance(a_, ROOT.TTree) and isinstance(b_, ROOT.TTree) \
                            and a_.GetEntries() == b_.GetEntries():
                        for k in range(a_.GetEntries()):
                            a_.GetEntry(k)
                            b_.GetEntry(k)
                            ep, ei = np.array(list(a_.Energy)), np.array(list(b_.Energy))
                            w = ep > 1.0
                            if ep.shape == ei.shape:
                                ratios += list(ei[w] / ep[w])
                    tp.Close()
                    ti.Close()
                    fk_p, fk_i = front_kalpha([fp]), front_kalpha([fi])
                ratios = np.array(ratios)
                row["median_E_per_image_over_pooled"] = round(float(np.median(ratios)), 5) if ratios.size else ""
                for tag, fk in (("pooled", fk_p), ("per_image", fk_i)):
                    row[f"front_kalpha_{tag}_keV"] = round(fk[0], 4) if fk else ""
            rows.append(row)
    path = os.path.join(run.dirs["gc"], "per_image_vs_pooled.csv")
    if rows:
        keys = list(dict.fromkeys(k for row in rows for k in row))
        with open(path, "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=keys)
            w.writeheader()
            w.writerows(rows)
    lines = [f"per-image vs pooled gain correction (details in {path}):"]
    for row in rows:
        if not (row["pooled_ok"] and row["per_image_ok"]):
            lines.append(f"  {row['image']} {row['ext']}: curve missing (pooled ok {row['pooled_ok']}, "
                         f"per-image ok {row['per_image_ok']})")
            continue
        txt = (f"  {row['image']} {row['ext']}: a {(row['a_per_image'] / row['a_pooled'] - 1) * 100:+.3f}%, drop at "
               f"1000 e- {row['drop1000_per_image_pct'] - row['drop1000_pooled_pct']:+.2f} points")
        if row["per_image_source"] == "module":
            txt += " (own comb not usable: module curve)"
        if row.get("median_E_per_image_over_pooled", "") != "":
            txt += f", cluster E per-image/pooled median {row['median_E_per_image_over_pooled']:.5f}"
        if row.get("front_kalpha_pooled_keV", "") != "":
            txt += (f", front K-alpha {row['front_kalpha_pooled_keV']:.4f} (pooled) vs "
                    f"{row['front_kalpha_per_image_keV']:.4f} keV (per image)")
        lines.append(txt)
    return lines


