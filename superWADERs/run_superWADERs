def build_parser(full=False):
    ap = argparse.ArgumentParser(
        prog=PROG, usage=f"{PROG} INPUT [options]      (-h: flags, -h -v: full guide)",
        description=(__doc__ if full else SHORT_DESCRIPTION), epilog=(HELP_EPILOG if full else SHORT_EPILOG),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", metavar="INPUT", nargs="?", default=None,
                    help="an image, a raw DAQ file or a .txt list (one path per line); without it (and with --campaign "
                         "DIR): only take in the reviews")
    ap.add_argument("-o", "--parent", metavar="DIR", default=".",
                    help="folder in which superWADERs_<run name> is made (default: current folder)")
    ap.add_argument("-j", "--jobs", metavar="N", type=int, default=min(2, os.cpu_count() or 1),
                    help="images processed at the same time, one process each (default 2)")
    ap.add_argument("--overwrite", action="store_true", help="replace an existing superWADERs_<run name> folder")
    g = ap.add_argument_group("campaign (data arriving packet by packet)")
    g.add_argument("--campaign", metavar="DIR", default=None,
                   help="add this input to the campaign folder DIR (made on first use): only inputs not yet in it (or "
                        "changed) are processed; the pages of this run's tools and the campaign overview are rebuilt "
                        "from everything it holds. Without it, the run is on its own (a fresh folder)")
    g.add_argument("--criteria", metavar="FILE", default=None,
                   help="pass / warn / fail limits (JSON, see commissioning/criteria_default.json); kept in the campaign "
                        "(criteria.json) and used for every page; a new file re-judges everything without new fits")
    g.add_argument("--reprocess", action="store_true",
                   help="process the inputs again even if the campaign already has them")
    g.add_argument("--dataset", metavar="NAME", default=None,
                   help="the data set these inputs belong to (e.g. packet2, cooldown2): a module with several data sets "
                        "gets one report per data set and one overview view each (newest first; the campaign overview "
                        "uses the newest). Without it, inputs join the data set they had, or the default one")
    g.add_argument("--no-review-helper", action="store_true",
                   help="do not start the review helper (the local web server through which the pages save reviews)")
    g.add_argument("--port", type=int, default=8765, help="first port the review helper tries (default 8765)")
    g.add_argument("--reviews", metavar="FILE", nargs="+", default=[],
                   help="review files downloaded from the pages (reviews.js): merged into DIR/reviews.js (also without INPUT)")
    g.add_argument("--refresh-all", action="store_true",
                   help="rebuild every tool's pages from the kept results (default: only the tools of this run, and all "
                        "of them after --criteria / --reprocess)")
    g = ap.add_argument_group("clustering")
    g.add_argument("--stitch", choices=("time", "order"), default=None,
                   help="continuous readout: join consecutive images of one setting row by row before clustering, so "
                        "events across image boundaries are one cluster (time: by DATEINI / DATEEND, order: the list "
                        "order); stitched/<name>.stitch.json maps rows back to the images (engine/stitch.py)")
    g.add_argument("--clusterer", choices=("auto", "agmx", "threshold"), default="auto",
                   help="auto (default): one chain per CCD from the characterisation (Bayes / A_GMX / crowded A_GMX / "
                        "unmodelled / threshold); agmx or threshold: that clusterer on every CCD (details: -h -v)")
    g.add_argument("--thresholds", metavar="auto|sigma0|PIX,SEED", default="auto",
                   help="threshold clusterer: auto (default; in electrons from the dark charge, sigma0 rule where the "
                        "peaks are not resolved), sigma0 (panaSKImg's 10 / 30 sigma0) or PIX,SEED in electrons")
    g.add_argument("--no-clusters", action="store_true", help="fits only: no cluster files (much faster)")
    g.add_argument("--gain", metavar="G|EXT1=G1,...", default=None,
                   help="gain [ADU/e-] for CCDs whose electron comb cannot be measured (flagged in the summary)")
    g.add_argument("--gain-file", metavar="JSON", default=None,
                   help="gains for CCDs without a comb: {EXTn: G}, {acm: {EXTn: G}} or a native_summary.json")
    g.add_argument("--skip-start", metavar="K", type=int, default=0,
                   help="skip-resolved raw FITS files: first skip averaged (0-based, default 0)")
    g.add_argument("--tune", action="store_true",
                   help="per resolved CCD: pedestal method by smallest total fit error and fit window on the histogram")
    g.add_argument("--autoconfig-args", metavar='"ARGS"', default="",
                   help='extra settings for the measurement, in one quoted string (e.g. "--ccd-cols 6200")')
