def composite(run, configs, gc_dirs):
    """MakeComposite_Fe55_Clusters_Extensions.cc once per image type and module, on the gain-corrected files if there
    are any (with 'both' also on the per-image ones -> composite_per_image/), else on root/."""
    args, D = run.args, run.dirs
    lines, failed = run.lines["comp"], []
    sets = [(D.get("root_gc", D["root"]), os.path.join(run.out, "composite"), "")]
    if len(gc_dirs) == 2:
        sets.append((gc_dirs["per-image"], os.path.join(run.out, "composite_per_image"), "_per_image"))
    root_exe = shutil.which("root") or os.path.join(os.path.dirname(sys.executable), "root")
    for rootdir, cdir, tag in sets:
        os.makedirs(os.path.join(cdir, "lists"), exist_ok=True)
        groups = {}
        lines.append(f"MakeComposite ({args.composite_macro}) on the cluster files in {rootdir}:")
        for r in sorted(configs.values(), key=lambda r: r["stem"]):
            m = re.search(r"Image_(\d+)", r["stem"])
            num = args.image_number if args.image_number is not None else (int(m.group(1)) if m else None)
            module, why = module_name(acm_id(r["stem"]), r["orig"], run.modules)
            lines.append(f"  {r['stem']}: Image {num if num is not None else '?'}, module {module} ({why})")
            if num is None:
                lines.append("    not run: no Image_<N> in the name (use --image-number N)")
                continue
            groups.setdefault((num, module), []).extend(
                sorted(glob.glob(os.path.join(rootdir, f"panaSKImg_clustersRec_{r['stem']}_ext*.root"))))
        for (num, module), files in sorted(groups.items()):     # one at a time: the first run compiles the macro
            name = f"Image_{num}_{module}"
            if not files:
                lines.append(f"  {name}: not run (no cluster files)")
                continue
            lst = os.path.join(cdir, "lists", f"{name}_list.txt")
            with open(lst, "w") as fh:
                fh.write("".join(f + "\n" for f in files))
            log = os.path.join(D["logs"], f"composite{tag}_{name}.log")
            run.say(f"MakeComposite {name}{tag} ({len(files)} file(s))")
            with open(log, "w") as fh:
                rc = subprocess.run([root_exe, "-l", "-q", "-b", f'{args.composite_macro}+("{lst}",{num},"{module}","{cdir}")'],
                                    stdout=fh, stderr=subprocess.STDOUT).returncode
            plots = os.path.join(cdir, "Fe_55_Analysis_Plots", module, f"{name}_list")
            ok = rc == 0 and bool(glob.glob(os.path.join(plots, "compare", "*.png")))
            lines.append(f"  {name}: {'plots in ' + plots if ok else 'FAILED, see ' + log}")
            if not ok:
                failed.append(name + tag)
    return failed


