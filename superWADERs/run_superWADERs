CHAIN_TEXT = {"agmx": "A_GMX", "crowded": "A_GMX crowded mode", "unmodelled": "A_GMX unmodelled (hysteresis)",
              "threshold": "threshold clusterer"}


def clustering_lines(configs):
    """Per CCD: the clustering chain, why, the clusters per output (and how many the Bayesian finder made), the
    thresholds where the threshold clusterer ran, and every fallback."""
    lines = []
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        for e, c in sorted(r["summary"]["ccds"].items()):
            if "gain" not in c:
                continue
            outs = {k: v for k, v in c.items() if isinstance(v, dict) and "n_clusters" in v}
            if not outs:
                continue
            dec = c.get("decision") or {}
            first = next(iter(outs.values()))
            chain = dec.get("chain") or first.get("chain")
            txt = f"  {r['stem']} {e}: {CHAIN_TEXT.get(chain, chain)}"
            if dec.get("why"):
                txt += f" ({dec['why']})"
            parts = []
            for k, v in outs.items():
                p = f"{k} {v['n_clusters']}"
                nb = (v.get("n_by_finder") or {}).get("bayes")
                if nb:
                    p += f" (Bayes {nb})"
                if v.get("chain") and v["chain"] != chain:
                    p += f" [{CHAIN_TEXT.get(v['chain'], v['chain'])}]"
                parts.append(p)
            lines.append(txt + " -> " + ", ".join(parts))
            if chain == "threshold" and c.get("thresholds"):
                t = c["thresholds"]
                lines.append(f"      pixel > {t['pixel_e']:.2f} e-, seed >= {t['seed_e']:.2f} e- ({t['note']})")
            fe = ((dec.get("agmx_info") or {}).get("fewe") or {})
            if isinstance(fe, dict) and fe.get("mode") not in (None, "off"):
                if fe.get("used"):
                    b = fe.get("blocks") or {}
                    lines.append(f"      Bayesian few-electron switch: used in {b.get('bayes', 0) + b.get('both', 0)} of "
                                 f"{sum(b.values())} blocks, {fe.get('n_bayes')} events kept, {fe.get('n_agmx_replaced')} "
                                 f"A_GMX clusters replaced (dark charge {fe.get('lam', float('nan')):.2e} e-/pix, "
                                 f"{'run-pooled' if fe.get('pooled_lam') else 'single-image'})")
                else:
                    lines.append(f"      Bayesian few-electron switch: not used ({fe.get('reason')})")
            for fb in list(dec.get("fallbacks", [])) + list(c.get("fallbacks", [])) + list(c.get("fit_at_limit", [])):
                lines.append(f"      NOTE {fb}")
    return lines


def summary(run, configs, rows, roots, tool_lines):
    """fit_quality.csv and summary.txt (also printed): the verdict counts of every overview first, then the fits of
    every image of the campaign, the clustering per CCD, the gain choice, and the runs of the campaign."""
    args, camp = run.args, run.camp
    if rows:
        import csv
        with open(os.path.join(run.out, "fit_quality.csv"), "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
            w.writeheader()
            w.writerows(rows)
    rows = sorted(rows, key=lambda q: (q["image"], q["ext"]))
    wid = max([len(q["image"]) for q in rows] + [5])
    runs = camp.data.get("runs", [])
    L = [f"{PROG} summary: {os.path.basename(run.out)}  (campaign: {len(camp.data['inputs'])} input file(s), "
         f"{len(configs)} image(s), {len(runs)} run(s); this run {time.time() - run.t0:.0f} s)", "",
         f"overview pages (open {os.path.join(run.out, 'index.html')}):"] + tool_lines + ["",
         f"{'image':{wid}} {'ext':4} {'chi2/ndf':>8} {'gain [ADU/e-]':>19} {'noise [e-]':>17} {'DC [e-/pix]':>17} {'DC bias':>8}"]
    for q in rows:
        bias = f"{q['dc_bias']:+8.3f}" if q["dc_bias"] is not None else "       -"
        L.append(f"{q['image']:{wid}} {q['ext']:4} {q['chi2ndf']:8.2f} "
                 f"{q['gain']:8.4f} +- {q['gain_err_s']:.4f}{'*' if q['gain_held'] else ' '} "
                 f"{q['noise']:7.4f} +- {q['noise_err_s']:.4f} {q['dc']:7.4f} +- {q['dc_err_s']:.4f} {bias}")
    L += ["", "errors scaled by sqrt(chi2/ndf); * = gain held at the all-peaks fit; DC bias = fit - dark current from "
              "the 0e-/1e- pixel counts"]
    cl = clustering_lines(configs)
    if cl:
        L += ["", "clustering per CCD:"] + cl
    L += ["", "gain used per CCD (all-peaks fit vs 0e-/1e- fit; details in native_summary.json):"]
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        L.append(f"  {r['stem']}")
        L += [f"  {n}" for n in r["notes"]]
    L += ["", f"cluster files: {len(roots)} (list: {os.path.join(run.dirs['root'], 'root_files.txt')})"]
    L += ["", "runs of this campaign (newest last):"]
    for i, r in enumerate(runs):
        L.append(f"  run {i + 1}  {r['date']}  {r['new']} new, {r['skipped']} already there  ({r['command']})")
        L += [f"    {ln}" for ln in r.get("lines", [])]
    if run.failed:
        L += ["", "FAILED in this run: " + "; ".join(f"{s} {e} ({why})" for s, e, why in run.failed)]
    text = "\n".join(L)
    with open(os.path.join(run.out, "summary.txt"), "w") as fh:
        fh.write(text + "\n")
    print("\n" + text)


