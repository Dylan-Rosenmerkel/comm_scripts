def env_ready():
    return all(importlib.util.find_spec(m) is not None for m in NEEDED_MODULES)


def find_conda():
    """conda / mamba / micromamba executable, or None."""
    cands = [os.environ.get("CONDA_EXE"), os.environ.get("MAMBA_EXE"),
             shutil.which("conda"), shutil.which("mamba"), shutil.which("micromamba")]
    home = os.path.expanduser("~")
    for base in ("miniforge3", "mambaforge", "miniconda3", "anaconda3", "micromamba"):
        cands.append(os.path.join(home, base, "bin", "conda"))
    cands += ["/opt/conda/bin/conda", "/opt/homebrew/Caskroom/miniforge/base/bin/conda",
              "/usr/local/Caskroom/miniforge/base/bin/conda"]
    return next((c for c in cands if c and os.path.isfile(c)), None)


def _env_has(env, module):
    """True if the environment's site-packages hold `module` (a package folder or a module file)."""
    for sp in glob.glob(os.path.join(env, "lib", "python3*", "site-packages")) + \
            [os.path.join(env, "Lib", "site-packages")]:
        if os.path.isdir(os.path.join(sp, module)) or glob.glob(os.path.join(sp, module + "*.py")):
            return True
    return False


def find_env(conda, name):
    """Prefix of the environment to use: --env / $SUPERWADERS_ENV; else one named 'damic'; else the first environment
    whose site-packages hold numba and ROOT."""
    try:
        out = subprocess.run([conda, "env", "list", "--json"], capture_output=True, text=True, check=True).stdout
        envs = json.loads(out).get("envs", [])
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
        return None
    if name:
        return next((e for e in envs if os.path.basename(e) == name or e == name), None)
    named = [e for e in envs if os.path.basename(e) == "damic"]
    if named:
        return named[0]
    return next((e for e in envs if _env_has(e, "numba") and _env_has(e, "ROOT")), None)


def ensure_environment(env_name):
    """Return if this python has everything; otherwise re-run this script inside the conda environment."""
    if env_ready():
        return
    missing = [m for m in NEEDED_MODULES if importlib.util.find_spec(m) is None]
    if os.environ.get(INSIDE_FLAG):
        die(f"the environment is missing {', '.join(missing)}")
    conda = find_conda()
    if not conda:
        die(f"this python lacks {', '.join(missing)} and no conda was found; activate the damic environment")
    env = find_env(conda, env_name)
    if not env:
        die("no conda environment with numba and ROOT found" + (f" (looked for '{env_name}')" if env_name else "")
            + "; use --env NAME")
    print(f"{PROG}: using environment {env}", flush=True)
    cmd = [conda, "run"]
    if not os.path.basename(conda).startswith("micromamba"):
        cmd.append("--no-capture-output")
    cmd += ["-p", env, "python", SCRIPT_PATH] + sys.argv[1:]
    sys.exit(subprocess.run(cmd, env=dict(os.environ, **{INSIDE_FLAG: "1", "PYTHONUNBUFFERED": "1"})).returncode)


