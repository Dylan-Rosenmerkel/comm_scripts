@dataclass
class Run:
    """What the steps share. images: every input (images and raw files); dirs: root, logs (+ gc, root_gc)."""
    args: argparse.Namespace
    run_name: str
    images: list
    out: str
    modules: dict
    dirs: dict = field(default_factory=dict)
    t0: float = 0.0
    lines: dict = field(default_factory=lambda: {k: [] for k in ("raw", "front", "gc", "comp", "comm")})
    failed: list = field(default_factory=list)
    camp: object = None
    dataset: object = None                 # --dataset (None: inputs keep the data set they had)

    def stamp(self):
        return f"[{time.time() - self.t0:5.0f}s]"

    def say(self, msg):
        print(f"  {self.stamp()} {msg}", flush=True)


def reviews_only(args):
    """run_superWADERs --campaign DIR without INPUT: the reviews up to date, the review helper running, the
    campaign open in the browser (standard library only)."""
    if not args.campaign:
        die("give an INPUT (or --campaign DIR without INPUT to take in the reviews written on its pages)")
    out = os.path.abspath(os.path.expanduser(args.campaign))
    if not os.path.exists(os.path.join(out, "campaign.json")):
        die(f"{out} is not a campaign folder (no campaign.json)")
    import reviews as RV
    print(f"{PROG}: reviews of {out}")
    print("\n".join(RV.refresh(out, args.reviews)))
    url = None if args.no_review_helper else RV.ensure_helper(out, args.port)
    if url:
        print(f"\nreview helper running: comments typed on the pages are saved into {out}/reviews.js. Open the pages as "
              f"usual (double-click {os.path.join(out, 'index.html')}) or at {url}index.html")
        try:
            import webbrowser
            webbrowser.open(url + "index.html")
        except Exception:
