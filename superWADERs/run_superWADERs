def read_inputs(path):
    """(run name, [paths]) from an image, a raw DAQ file (.RJ45ADCDATA<ch>) or a .txt list of them."""
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        die(f"{path} not found")
    if path.endswith(".txt"):
        base, files = os.path.dirname(path), []
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line if os.path.isabs(line) else os.path.join(base, line)
                if not os.path.isfile(p):
                    die(f"{p} (from {os.path.basename(path)}) not found")
                files.append(os.path.abspath(p))
        if not files:
            die(f"nothing listed in {path}")
        return os.path.basename(path)[:-4], files
    if RAW_INPUT.search(path):
        return RAW_INPUT.sub("", os.path.basename(path)), [path]
    if not path.endswith(IMAGE_EXT):
        die(f"{path} is neither an image ({', '.join(IMAGE_EXT)}), a raw DAQ file (.RJ45ADCDATA<ch>) nor a .txt list")
    return image_stem(path), [path]


def parse_modules(items):
    """{ACM id: module name} from --module ACM=NAME arguments."""
    modules = {}
    for it in items:
        acm, sep, name = it.partition("=")
        if not sep or not acm.strip() or not name.strip():
            die(f"--module {it}: expected ACM=NAME, e.g. 109=DM02")
        modules[acm.strip()] = name.strip()
    return modules


def module_name(acm, src, modules):
    """(module name, where it came from) of an image: --module, else the DMa_DMb_DMc folder name, else ACM<id>."""
    if acm in modules:
        return modules[acm], "--module"
    m = re.search(r"(DM\d+)_(DM\d+)_(DM\d+)", os.path.dirname(src))
    if m and acm in ACM_ORDER:
        return m.group(ACM_ORDER.index(acm) + 1), "folder name"
    return (f"ACM{acm}" if acm else "DMXX"), "no module found"


def module_resolver(run):
    """Module name of a CCD: --module-list (per ACM or per CCD), else --module, else the data folder name, else
    ACM<id>. Returns f(acm, ext, ccd). The campaign keeps the module list (modules.csv): a later run without
    --module-list names the CCDs the same way (pages and reviews refer to the module names)."""
    import packet_report as PR
    import shutil
    kept = os.path.join(run.out, "modules.csv")
    if run.args.module_list:
        if not (os.path.exists(kept) and os.path.samefile(run.args.module_list, kept)):
            shutil.copyfile(run.args.module_list, kept)
    mods = PR.read_module_list(run.args.module_list or (kept if os.path.exists(kept) else None))

    def f(acm, ext=None, ccd=None):
        m = PR.module_for(mods, acm, ext, ccd)
        if m.startswith("ACM"):
            name, why = module_name(str(acm), run.images[0] if run.images else "", run.modules)
            if why != "no module found":
                m = name
        return m
    return f


