def has_clusters(core):
    return any(isinstance(v, dict) and "n_clusters" in v for c in core["summary"]["ccds"].values() for v in c.values())


def to_process(run, images, tools_now):
    """{image: record options} of the images that need processing (new, changed, --reprocess, or a part a tool asks
    for is missing), and the list of those already complete."""
    args, camp = run.args, run.camp
    want_sr = [args.sr_threshold, args.sr_min_length] if args.sr else None
    need, done = {}, []
    for p in images:
        stem = image_stem(p)
        core = camp.load_record("images", stem) if camp.current(p) and not args.reprocess else None
        parts = set((core or {}).get("parts", []))
        opts = dict(packet="packet" in tools_now or "packet" in parts,
                    sr=want_sr or (core.get("sr_settings") if core and "sr" in parts else None),
                    clusters=("images" in tools_now and not args.no_clusters) or (bool(core) and has_clusters(core)))
        why = None
        if core is None:
            why = "new" if not camp.entry(p) else "--reprocess" if args.reprocess else "changed or no record"
        elif opts["packet"] and "packet" not in parts:
            why = "packet pages need its viewer"
        elif want_sr and core.get("sr_settings") != want_sr:
            why = "serial-register streaks"
        elif opts["clusters"] and not has_clusters(core):
            why = "cluster files"
        if why:
            need[p] = (opts, why)
        else:
            done.append(p)
    return need, done


def render_all(run, crit, mods_of, fresh, scope, refresh=False):
    """The reports and overviews. fresh: {tool: inputs new to it in this run}; scope: the tools whose pages this run
    rebuilds (the tools it was given, and the images overview when images were processed); refresh: rebuild every tool
    (--refresh-all, --criteria, --reprocess). A tool outside the scope keeps its pages; its overview rows, kept in
    records/overviews/, feed the campaign index. summary.txt, native_summary.json and fit_quality.csv always cover
    every image of the campaign. Returns (configs, rows, roots, tool lines)."""
    import campaign as CA
    import gain_dc_split as G
    args, camp, out = run.args, run.camp, run.out
    st = camp.data.setdefault("settings", {})
    stems = sorted({e["stem"] for e in camp.data["inputs"].values() if e.get("stem")})
    cores = {s_: camp.load_record("images", s_) for s_ in stems}
    cores = {k: v for k, v in cores.items() if v}
    by_tool = {t: set(camp.stems(t)) for t in ("images", "packet", "dc_series", "defects", "sr")}
    has = dict(images=bool(cores), packet=bool(camp.inputs("packet")), dc_series=bool(by_tool["dc_series"]),
               defects=bool(by_tool["defects"]), sr=bool(by_tool["sr"]))
    back = lambda here: [["← campaign overview", "../index.html"]] + [
        [CA.TOOL_LABELS[t], f"../{t}/index.html"] for t in ("images", "packet", "dc_series", "defects", "sr")
        if t != here and has[t]]
    # ---- the run summary: every image of the campaign (cheap: from the records)
    configs = {c["path"]: native_record(c["path"], c["summary"]) for c in cores.values()}
    rows = []
    for r in configs.values():
        for e, fit in sorted(r["final"].items()):
            q = G.held_quality(fit, r["refs"].get(e), r["held"].get(e))
            rows.append(dict(image=r["stem"], ext=e, gain_held=e in r["held"], **q))
    with open(os.path.join(out, "native_summary.json"), "w") as fh:
        json.dump([c["summary"] for c in cores.values()], fh, indent=1, default=str)
    roots = file_list(run.dirs["root"])

    def images():
        return CA.images_overview(camp, list(cores.values()), crit, mods_of, os.path.join(out, "images", "index.html"),
                                  back("images"))

    def per_dataset(tool):                       # the module names of a data set: <module>@<data set>
        return lambda ds: (mods_of if not ds else (lambda *a, **k: CA.ds_module(mods_of(*a, **k), ds)))

    def packet():
        import packet_report as PR
        items, ds_stem = {}, camp.dataset_of_stem("packet")
        for p in camp.inputs("packet"):
            if (camp.entry(p) or {}).get("kind") in ("trace", "psd"):
                items.setdefault(camp.dataset(p, "packet"), []).extend(camp.load_record("packet", os.path.basename(p)) or [])
        for s_ in sorted(by_tool["packet"]):
            c, part = cores.get(s_), camp.load_record("images_packet", s_)
            if c and part:
                items.setdefault(ds_stem.get(s_, ""), []).extend(PR.image_items(
                    c["path"], c["meta"], {int(n): tuple(v) for n, v in part.items()},
                    {int(n): v for n, v in (c.get("packet_numbers") or {}).items()}, c.get("char")))
        prow = []
        for ds, its in sorted(items.items()):
            run.say(f"packet pages ({len(its)} item(s){', data set ' + ds if ds else ''})")
            lines, pr = PR.render(its, out, per_dataset("packet")(ds))
            run.lines["comm"] += lines + [""]
            prow += pr
        return PR.overview(camp, prow, crit, os.path.join(out, "packet", "index.html"), back("packet"))

    def dc_series():
        import dc_series as DCS
        recs = [cores[s_] for s_ in sorted(by_tool["dc_series"]) if s_ in cores]
        meta = {c["path"]: dict(c["meta"], ACMID=c["meta"].get("ACMID") or c.get("acm")) for c in recs}
        cards = {(os.path.basename(c["path"]), int(n)): v for c in recs for n, v in (c.get("fit_cards") or {}).items()}
        limit = args.dc_limit if args.dc_limit is not None else st.get("dc_limit")
        st["dc_limit"] = limit
        ds_stem, drows = camp.dataset_of_stem("dc_series"), []
        for ds in sorted({ds_stem.get(c["stem"], "") for c in recs}):
            sel = [c for c in recs if ds_stem.get(c["stem"], "") == ds]
            run.say(f"dark-current series ({len(sel)} image(s){', data set ' + ds if ds else ''})")
            lines, dr = DCS.report([(c["path"], c["summary"]) for c in sel], lambda path: meta[path],
                                   per_dataset("dc_series")(ds), out, limit, fit_cards=cards, tag=ds)
            run.lines["comm"] += lines + [""]
            drows += dr
        return DCS.overview(camp, drows, crit, os.path.join(out, "dc_series", "index.html"), back("dc_series"), limit)

    def defects():                               # only the groups with a new image are made again
        import defects as DF
        ins = camp.inputs("defects")
        stem_of = {p: (camp.entry(p) or {}).get("stem") for p in ins}
        paths = [cores[stem_of[p]]["path"] if stem_of[p] in cores else p for p in ins if os.path.exists(p) and stem_of[p]]
        orig_of = {cores[stem_of[p]]["path"]: p for p in ins if stem_of[p] in cores}
        missing = [p for p in ins if not os.path.exists(p)]
        nsig = args.defect_sigma if args.defect_sigma != 5.0 or "defect_sigma" not in st else st["defect_sigma"]
        st["defect_sigma"] = nsig
        run.say(f"defect maps ({len(paths)} image(s))")
        redo = None if args.reprocess else {p for p in paths if os.path.abspath(orig_of.get(p, p)) in fresh.get("defects", set())}
        ds_of = {cores[stem_of[p]]["path"] if stem_of[p] in cores else p: camp.dataset(p, "defects") for p in ins}
        lines = []
        for ds in sorted({ds_of.get(p, "") for p in paths}):
            lines += DF.run([p for p in paths if ds_of.get(p, "") == ds], out, per_dataset("defects")(ds),
                            shlex.split(args.autoconfig_args), log=lambda m: run.say(m.strip()), nsig=nsig, redo=redo,
                            write_index=False)
        if missing:
            lines.append(f"  images no longer on disk (left out of the composites): {', '.join(map(os.path.basename, missing))}")
        run.lines["comm"] += lines + [""]
        return DF.overview(camp, crit, os.path.join(out, "defects", "index.html"), back("defects"))

    def sr():
        import sr_images as SR
        per_ccd, ds_stem = {}, camp.dataset_of_stem("sr")
        recs = sorted([cores[s_] for s_ in by_tool["sr"] if s_ in cores], key=lambda c: (CA.record_time(c), c["stem"]))
        thr = ml = None
        for c in recs:
            part = camp.load_record("images_sr", c["stem"]) or {}
            thr, ml = c.get("sr_settings") or (args.sr_threshold, args.sr_min_length)
            t_eff = float(c["meta"].get("EXPOSURE", 0) or 0) + (CA.readout_seconds(c["meta"]) or 0) / 2
            for ext, it in sorted(part.items()):
                if it.get("resolved") and t_eff > 0:      # dark current of the SR image (exposure + half the readout)
                    it["dc_rate"] = it["dc"] / t_eff * 86400
                per_ccd.setdefault(ds_stem.get(c["stem"], ""), {}).setdefault((c.get("acm") or 0, int(ext[3:]), it["ccd"]), []).append(it)
        srows = []
        for ds, pc in sorted(per_ccd.items()):
            run.say(f"serial-register pages ({sum(len(v) for v in pc.values())} CCD image(s){', data set ' + ds if ds else ''})")
            lines, sr_ = SR.render(pc, out, per_dataset("sr")(ds), thr or args.sr_threshold, ml or args.sr_min_length, tag=ds)
            run.lines["comm"] += lines + [""]
            srows += sr_
        return SR.overview(camp, srows, crit, os.path.join(out, "sr", "index.html"), back("sr"))

    tool_views, tool_lines = {}, []
    for t, fn in (("images", images), ("packet", packet), ("dc_series", dc_series), ("defects", defects), ("sr", sr)):
        if not has[t]:
            continue
        kept = None if (refresh or t in scope) else camp.load_record("overviews", t)
        if kept is None:
            views = fn()
            camp.save_record("overviews", t, dict(views=views, made=CA._now()))
        else:
            views = kept["views"]
        tool_views[t] = (f"{t}/index.html", views)
        n = CA.counts([r for v in views for r in v["ccds"]])
        tool_lines.append(f"  {CA.TOOL_LABELS[t]:16s} {t + '/index.html':22s} {n['pass']} pass, {n['warn']} warn, "
                          f"{n['fail']} fail" + (f", {n['na']} n/a" if n["na"] else "")
                          + (f"  ({len(views)} views)" if len(views) > 1 else "")
                          + ("" if kept is None else f"  (kept from {kept.get('made', 'an earlier run')})"))
    CA.campaign_index(camp, tool_views, os.path.join(out, "index.html"), crit)
    return configs, rows, roots, tool_lines


def main(argv=None):
    args = parse_args(argv)
    if args.input is None:
        return reviews_only(args)
    run_name, files, out, modules = check_request(args)
    ensure_environment(args.env)                      # may re-run this script inside the conda environment and exit
    if args.temperature is not None:                  # read by pair_energy.py at import (g(n) and A_GMX energies)
        os.environ["COMM_TEMPERATURE_K"] = str(args.temperature)
    import campaign as CA
    import fit_quality as FQ
    import native_pipeline as NP
    run = Run(args=args, run_name=run_name, images=files, out=out, modules=modules)
    prepare_output(run)
    run.camp = CA.Campaign(out)
    run.dataset = None if args.dataset is None else CA.dataset_name(args.dataset)
    crit = CA.load_criteria(out, args.criteria)
    run.t0 = time.time()
    tools_now = (["packet"] if args.packet else ["images"]) + [t for t, on in (("dc_series", args.dc_series),
                                                                              ("defects", args.defect_map), ("sr", args.sr)) if on]
    print(f"{PROG} ({NP.VERSION}): {len(files)} input(s) -> {out}   ({args.jobs} images at a time, clusterer "
          f"{args.clusterer}; {'campaign' if args.campaign else 'new folder'}; tools: {', '.join(tools_now)})")
    mods_of = module_resolver(run)

    # ---- inputs: traces / L1 / images; which images need processing
    if args.packet:
        cls = packet_traces(run, files)
        run.images = cls["image"] + cls["l1"]
        images, l1_fits = raw_inputs(run, l1_skips="all")
    else:
        images, l1_fits = raw_inputs(run)
        if args.stitch and images:                   # continuous readout: consecutive images joined (engine/stitch.py)
            import stitch as ST
            made = ST.write_stitched(ST.group_images(images, args.stitch), os.path.join(out, "stitched"), log=run.say)
            run.say(f"stitching ({args.stitch}): {len(images)} images -> {len(made)} "
                    f"({sum(len(m) > 1 for _, m in made)} stitched readouts)")
            images = [p for p, _ in made]
            run.images = images
    need, done = to_process(run, images, tools_now)
    # the inputs that are new to a tool in this run (or changed): the tools that combine images (defect-map groups)
    # make only the groups with such an input again
    fresh = {t: {os.path.abspath(p) for p in images if not run.camp.has(p, t)} for t in tools_now}
    if images:
        run.say(f"images: {len(need)} to process, {len(done)} already in the campaign")
    if need:
        thr = args.thresholds if args.thresholds in ("auto", "sigma0") else tuple(float(v) for v in args.thresholds.split(","))
        base = dict(thresholds=thr, anchor=args.gain_anchor, autoconfig_args=shlex.split(args.autoconfig_args),
                    crowded="auto", crowded_shapes="on", all_ext=True, tune=args.tune, verbose=False)
        tasks, recs = front_end(run, NP, list(need), base)
        orig = {r["process_path"]: r["file"] for r in recs if r.get("process")}
        # ---- --gain-correction (the images of this run): fits first, then g(n)
        gc_dirs, curves = {}, {}
        if args.gain_correction and not args.packet:
            import gain_vs_charge as GVC
            run.say("fits of every CCD (for the g(n) groups)")
            pre = process(run, NP, [(p, out, dict(kw, outputs=[], write=False), None) for p, _, kw in tasks], records=False)
            gconf = {p: native_record(p, s_) for p, s_ in pre.items()}
            run.dirs["gc"] = os.path.join(out, "gain_vs_charge")
            os.makedirs(run.dirs["gc"], exist_ok=True)
            run_exts = sorted({int(e[3:]) for r in gconf.values() for e in r["final"]})
            modes = ["pooled", "per-image"] if args.gain_correction == "both" else [args.gain_correction]
            gc_dirs = {m: os.path.join(out, "root_gaincorr" if m == "pooled" else "root_gaincorr_per_image") for m in modes}
            run.dirs["root_gc"] = gc_dirs.get("pooled", gc_dirs.get("per-image"))
            curves = gain_curves(run, GVC, FQ, gconf, run_exts, modes)
            tasks = [t for t in tasks if t[0] in pre]

        def outputs(path, opts):
            if not opts["clusters"] or args.no_clusters:
                return []
            stem = image_stem(path)
            return ([("root", args.clusterer, run.dirs["root"], None)]
                    + [(f"gaincorr_{m}", args.clusterer, d, curves[(m, stem)]) for m, d in gc_dirs.items()
                       if (m, stem) in curves])
        final = process(run, NP, [(p, out, dict(kw, outputs=outputs(p, need[orig.get(p, p)][0]), plots=True),
                                   need[orig.get(p, p)][0]) for p, _, kw in tasks])
        NP.write_characterisation(out, recs, [c["summary"] for c in final.values()])
        bconf = {}
        for p, c in final.items():
            o = orig.get(p, p)
            for t in tools_now:
                run.camp.add(o, t, kind="image", stem=c["stem"], dataset=run.dataset)
            bconf[p] = native_record(o, c["summary"])
        if gc_dirs:
            for mode, d in gc_dirs.items():
                run.lines["gc"].append(f"  corrected cluster files ({mode}): {len(file_list(d))} (list: "
                                       f"{os.path.join(d, 'root_files.txt')}; the images of this run, energies with g(n))")
            if len(gc_dirs) == 2:
                run.lines["gc"] += compare_gain_corrections(run, bconf, curves, gc_dirs)
        if args.composite and bconf:
            run.failed += [(n, "composite", "MakeComposite failed") for n in composite(run, bconf, gc_dirs)]
        if l1_fits:                                   # images made from level-1 data: noise vs skips, fits side by side
            import gain_dc_split as G
            import raw_data as RD
            lrows = [dict(image=r["stem"], ext=e, gain_held=e in r["held"], **G.held_quality(fit, r["refs"].get(e), r["held"].get(e)))
                     for r in bconf.values() for e, fit in sorted(r["final"].items())]
            run.lines["raw"] += RD.l1_noise_summary(lrows, os.path.join(out, "L1"), l1_fits)
            run.lines["raw"] += RD.compare_skips(out, l1_fits, os.path.join(out, "L1")) + [""]
    for p in done:                                    # already processed: only the tool memberships of this run
        e = run.camp.entry(p)
        for t in tools_now:
            run.camp.add(p, t, kind="image", stem=e.get("stem") or image_stem(p), dataset=run.dataset)
    run.camp.add_run(sys.argv, tools_now, list(need), done,
                     [ln for k in ("raw", "front", "gc", "comp") for ln in run.lines[k]])
    run.camp.save()

    # ---- every report and overview from everything the campaign holds
    # the tools whose pages change: those of this run that got a new input, or whose images were processed now
    scope = {t for t in tools_now if fresh.get(t) or need} | ({"images"} if need else set())
    refresh = bool(args.refresh_all or args.criteria or args.reprocess)
    configs, rows, roots, tool_lines = render_all(run, crit, mods_of, fresh, scope, refresh)
    run.camp.save()
    import reviews as RV
    review_lines = RV.refresh(out, args.reviews, log=run.say)
    summary(run, configs, rows, roots, tool_lines + [""] + review_lines + [""] + run.lines["comm"])
    print(f"\nresults: {out}   (overview: {os.path.join(out, 'index.html')})")
    url = None if args.no_review_helper else RV.ensure_helper(out, args.port, log=run.say)
    if url:
        print(f"reviews: comments typed on the pages are saved into {os.path.join(out, 'reviews.js')} (review helper "
              f"running, {url})")
    return 1 if run.failed else 0


if __name__ == "__main__":
    sys.exit(main())
