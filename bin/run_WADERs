#!/usr/bin/env python3
"""run_WADERs: one command from raw skipper-CCD image(s) to panaSKImg (WADERs) results.

    run_WADERs <image.fz | image.fits | image.fits.bz2 | list.txt> [-o PARENT] [-j N] [options]
    run_WADERs -h        the options;   run_WADERs -h -v   the full guide (what each step does)

Engine (--engine): native (default) does steps 1-3d below in python, one process per image (src/native_pipeline.py,
run_native(); no panaSKImg needed; same output folders); waders runs panaSKImg per CCD, the steps below.

What happens, per image (each step is one function below)
---------------------------------------------------------
  check_request          inputs exist, output folder free, option combinations valid (standard library only)
  ensure_environment     if this python lacks ROOT/pysimdamicm, re-run inside the conda environment with panaSKImg
  step1_configure        one panaSKImg JSON per CCD (gain_dc_split.py + autoconfig_panaSKImg.py): settings measured
                         from the raw pixels; the gain from a many-peak fit where that is more precise, the dark
                         current from the Poisson-like 0e-/1e- peaks
  step2_run_panaskimg    panaSKImg once per CCD (--ext N), in parallel
  step3_collect_root_files   cluster files -> root/, dark-current fits -> root/dc_fits/
  step3b_gain_correction --gain-correction: gain vs charge per pixel g(n) measured from the images, corrected
                         cluster files (gain_vs_charge.py)
  step3d_agmx            --clusterer agmx|both: A_GMX clusters (src/agmx_root.py) written as panaSKImg cluster
                         files -> root_agmx/ (and root_agmx_gaincorr/ with --gain-correction)
  step3c_composite       --composite: MakeComposite_Fe55_Clusters_Extensions.cc on the cluster files
  step4_summary          fit_quality.csv and summary.txt (gain, noise, dark current per CCD with fit errors)

Output: WADERs_analysis_<run name>/   (run name = image name, or the .txt name for a list)
    *.pdf, *_waders.fits.bz2   panaSKImg plots and processed images
    json/<image>/final/        the JSONs that were run (one per CCD)
    json/<image>/gain/, dc/    the intermediate JSONs (many-peak gain / 0e-1e- fit)
    json/<image>/*_gain_dc_summary.txt   gain and dark-current fits compared
    root/                      cluster files, one per CCD (panaSKImg_clustersRec_<image>_extN.root)
    root/root_files.txt        full paths of those cluster files (input list for e.g.
                               MakeComposite_Fe55_Clusters_Extensions.cc)
    root/dc_fits/              the dark-current fits (histogram + fitted function) as ROOT
    logs/                      panaSKImg and autoconfig logs
    summary.txt, fit_quality.csv   gain, noise, dark current per CCD with fit errors
    gain_vs_charge/, root_gaincorr*/   with --gain-correction;   composite*/   with --composite
    root_agmx*/                with --clusterer agmx/both (A_GMX cluster files, same format as root/)

A list .txt has one image path per line (relative paths are relative to the .txt;
empty lines and lines starting with # are ignored).

Environment: it needs python with numpy, astropy, PyROOT and pysimdamicm (panaSKImg).
If the python running it does not have them, it looks for a conda/mamba environment
that has panaSKImg installed and re-runs itself inside it with "conda run" (nothing is
activated in your shell, nothing stays active afterwards). Choose the environment with
--env NAME (or $WADERS_ENV); give panaSKImg with --panaskimg (or $PANASKIMG).

How to read this file: Environment (finding conda) -> Inputs (image lists) -> --composite helpers (module names)
-> the help texts and the argument parser -> the --gain-correction both comparison -> the pipeline steps, one
function each, and main(), which calls them in order.

The scripts it uses (gain_dc_split.py, autoconfig_panaSKImg.py, fit_quality.py, gain_vs_charge.py, naming.py,
agmx_root.py) live in comm_scripts/src; keep the bin/, src/ and (for --clusterer) clustering_tests/ folders together.
The reference JSON is built into autoconfig_panaSKImg.py; --composite also needs the MakeComposite macro. User guide:
docs/usage/comm_scripts_usage.pdf; physics of each step: docs/PIPELINE_GUIDE.md.
"""
# Only the standard library at module level: this part has to run in any python, before
# the environment with ROOT/pysimdamicm is found.
import argparse
import concurrent.futures as cf
import glob
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field

SCRIPT_PATH = os.path.realpath(__file__)
SCRIPT_DIR = os.path.dirname(SCRIPT_PATH)
# the pipeline modules live in ../src (comm_scripts/src) next to this bin/ folder
SRC_DIR = os.path.join(os.path.dirname(SCRIPT_DIR), "src")
NEEDED_MODULES = ("numpy", "astropy", "ROOT", "pysimdamicm")
INSIDE_FLAG = "RUN_WADERS_IN_ENV"
sys.path.insert(0, SRC_DIR)
from naming import acm_id, image_stem  # noqa: E402  (standard library only, usable before the environment check)
# autoconfig options that run_WADERs sets itself and must not come through --autoconfig-args
RESERVED_AUTOCONFIG = ("--peaks", "--per-ext", "--tune", "-o", "--output")


# =============================================================================
# Environment
# =============================================================================
def env_ready(needed=NEEDED_MODULES):
    """True if this python can run everything."""
    return all(importlib.util.find_spec(m) is not None for m in needed)


def find_conda():
    """conda / mamba / micromamba executable, or None."""
    cands = [os.environ.get("CONDA_EXE"), os.environ.get("MAMBA_EXE"),
             shutil.which("conda"), shutil.which("mamba"), shutil.which("micromamba")]
    home = os.path.expanduser("~")
    for base in ("miniforge3", "mambaforge", "miniconda3", "anaconda3", "micromamba"):
        cands.append(os.path.join(home, base, "bin", "conda"))
    cands += ["/opt/conda/bin/conda", "/opt/homebrew/Caskroom/miniforge/base/bin/conda",
              "/usr/local/Caskroom/miniforge/base/bin/conda"]
    return next((c for c in cands if c and os.path.isfile(c)), None)


def find_env(conda, name):
    """Prefix of the environment to use: --env/$WADERS_ENV, else the first one with panaSKImg."""
    try:
        out = subprocess.run([conda, "env", "list", "--json"], capture_output=True, text=True, check=True).stdout
        envs = json.loads(out).get("envs", [])
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
        return None
    if name:
        return next((e for e in envs if os.path.basename(e) == name or e == name), None)
    for e in envs:
        if os.path.isfile(os.path.join(e, "bin", "panaSKImg")) or os.path.isfile(os.path.join(e, "Scripts", "panaSKImg")):
            return e
    return None


def ensure_environment(env_name, prog="run_WADERs", script=SCRIPT_PATH, inside_flag=INSIDE_FLAG, needed=NEEDED_MODULES):
    """Return if this python is ready (has the modules `needed`); otherwise re-run `script` (this one, or bin/run_AGMX)
    inside a conda env."""
    if env_ready(needed):
        return
    missing = [m for m in needed if importlib.util.find_spec(m) is None]
    if os.environ.get(inside_flag):
        sys.exit(f"{prog}: the environment is missing {', '.join(missing)}")
    conda = find_conda()
    if not conda:
        sys.exit(f"{prog}: this python lacks {', '.join(missing)} and no conda was found. "
                 "Activate the environment with pysimdamicm and run again.")
    env = find_env(conda, env_name)
    if not env:
        sys.exit(f"{prog}: no conda environment with panaSKImg found"
                 + (f" (looked for '{env_name}')" if env_name else "") + "; use --env NAME")
    print(f"{prog}: using environment {env}", flush=True)
    cmd = [conda, "run"]
    if not os.path.basename(conda).startswith("micromamba"):
        cmd.append("--no-capture-output")
    cmd += ["-p", env, "python", script] + sys.argv[1:]
    environ = dict(os.environ, **{inside_flag: "1", "PYTHONUNBUFFERED": "1"})
    sys.exit(subprocess.run(cmd, env=environ).returncode)


# =============================================================================
# Inputs
# =============================================================================
IMAGE_EXT = (".fz", ".fits", ".fits.bz2", ".fits.gz")


def read_inputs(path):
    """(run name, [image paths]) from an image or a .txt list of images."""
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        sys.exit(f"run_WADERs: {path} not found")
    if path.endswith(".txt"):
        base = os.path.dirname(path)
        images = []
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line if os.path.isabs(line) else os.path.join(base, line)
                if not os.path.isfile(p):
                    sys.exit(f"run_WADERs: {p} (from {os.path.basename(path)}) not found")
                images.append(os.path.abspath(p))
        if not images:
            sys.exit(f"run_WADERs: no images listed in {path}")
        return os.path.basename(path)[:-4], images
    if not path.endswith(IMAGE_EXT):
        sys.exit(f"run_WADERs: {path} is neither an image ({', '.join(IMAGE_EXT)}) nor a .txt list")
    return image_stem(path), [path]


# =============================================================================
# --composite (MakeComposite_Fe55_Clusters_Extensions.cc)
# =============================================================================
DEFAULT_COMPOSITE_MACRO = os.path.expanduser(
    "~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc")
# ACM ids in the order of the modules in a data folder named ..._DMa_DMb_DMc_... (FT1, FT2, FT4)
ACM_ORDER = ("110", "109", "106")


def parse_modules(items):
    """{ACM id: module name} from --module ACM=NAME arguments."""
    modules = {}
    for it in items:
        acm, sep, name = it.partition("=")
        if not sep or not acm.strip() or not name.strip():
            sys.exit(f"run_WADERs: --module {it}: expected ACM=NAME, e.g. 109=DM02")
        modules[acm.strip()] = name.strip()
    return modules


def module_name(acm, src, modules):
    """Module name for an image: --module, else the DMa_DMb_DMc folder name, else ACM<id>."""
    if acm in modules:
        return modules[acm], "--module"
    m = re.search(r"(DM\d+)_(DM\d+)_(DM\d+)", os.path.dirname(src))
    if m and acm in ACM_ORDER:
        return m.group(ACM_ORDER.index(acm) + 1), "folder name"
    return (f"ACM{acm}" if acm else "DMXX"), "no module found"


# =============================================================================
# Main
# =============================================================================
HELP_DESCRIPTION = """\
Raw skipper-CCD image(s) -> one panaSKImg JSON per CCD -> panaSKImg (WADERs) per CCD
-> plots, cluster ROOT files and a fit summary, all in WADERs_analysis_<run name>/.

usage in short:
  run_WADERs image.fz                 analyse one image (.fz, .fits, .fits.bz2)
  run_WADERs images.txt               analyse a list (one image path per line)
  run_WADERs images.txt -o DIR -j 6   output in DIR, 6 panaSKImg runs at a time

The run name is the image name (one image) or the .txt name (a list). In a list,
relative paths are relative to the .txt; empty lines and lines starting with # are
ignored. Works from any folder and any python: if this python lacks ROOT/pysimdamicm,
the conda environment with panaSKImg is found and used automatically.
"""

HELP_EPILOG = """\
engine (--engine, default native):
  native  comm_scripts' own implementation of steps 1-3 (src/native_pipeline.py), one process per image (-j images
          in parallel): autoconfig's measurements and settings, the per-row pedestal, the two dark-current fits and
          the gain choice of gain_dc_split, cluster finding, and cluster files in panaSKImg's format (same trees and
          branches; MakeComposite and gain_vs_charge read them unchanged). No panaSKImg / pysimdamicm needed. Same
          output folders (root/, root_gaincorr*/, root_agmx*/, gain_vs_charge/, composite*/, summary.txt,
          fit_quality.csv) and plots (*_FitDarkCurrentProcess_DCfit_EXTn.pdf, *_PedestalSubtractionProcess_
          Baseline/Sigma_EXTn.pdf, as panaSKImg --save-plots), plus native_summary.json (per CCD: fits, gain choice,
          pedestal, thresholds, timings). Not written: *_waders.fits.bz2, json/, root/dc_fits/.
          Cluster thresholds (--thresholds): auto (default) in electrons from the CCD's dark charge (pixel >= k e-,
          seed >= 9.5 e-), sigma0 = panaSKImg's 10 / 30 x pedestal sigma (reproduces panaSKImg's clusters), or
          PIX,SEED. Every pedestal method of panaSKImg (median, Gaussian fit, lowest-peak finder for a charged
          overscan) and --tune are done natively. Validated against panaSKImg (docs/native_pipeline.md,
          docs/native_pipeline_validation.md).
  waders  panaSKImg (pysimdamicm) once per CCD, as described below.

output (WADERs_analysis_<run name>/):
  *.pdf, *_waders.fits.bz2     panaSKImg plots and processed images
  summary.txt, fit_quality.csv gain, noise, dark current per CCD, with fit errors
                               (scaled by sqrt(chi2/ndf)) and the dark-current bias
  root/                        cluster files, one per CCD (..._extN.root)
  root/root_files.txt          full paths of those files (input list for e.g.
                               MakeComposite_Fe55_Clusters_Extensions.cc)
  root/dc_fits/                dark-current fits (histogram + function) as ROOT
  json/<image>/final/          the JSONs that were run, one per CCD
  json/<image>/gain/, dc/      intermediate JSONs (many-peak gain fit, 0e-/1e- fit)
  logs/                        panaSKImg and autoconfig logs
  composite/                   with --composite: MakeComposite plots and its input lists
  root_agmx/, root_agmx_gaincorr/   with --clusterer agmx/both: A_GMX cluster files

what it does, per image (gain_dc_split.py --per-ext, always on):
  1. autoconfig measures every CCD from the raw pixels and writes two JSONs per CCD:
       json/<image>/dc/    fits only the Poisson-like 0e-/1e- peaks (unbiased dark current)
       json/<image>/gain/  fits all peaks (more lever arm for the gain)
  2. both are fitted with panaSKImg (pedestal + fit only, fast); per CCD the gain with
     the smaller error (scaled by sqrt(chi2/ndf)) is kept: the all-peaks gain is held
     in the final JSON if it is more precise and agrees with the 2-peak gain (3 sigma)
       json/<image>/final/                      the JSONs that are run
       json/<image>/<image>_gain_dc_summary.txt all fits compared, with errors
  3. panaSKImg runs once per CCD (--ext N) with the final JSONs, in parallel;
     flooded/unresolved CCDs are skipped (see --all-ext; --autoconfig-args "--cluster-all" runs them
     with cluster finding)
  summary.txt lists, per CCD, which gain was used and why (* = all-peaks gain held)

--tune (optional, off by default; adds ~1 min per image):
  Instead of taking the pedestal method and fit window from rules, each CCD's
  0e-/1e- JSON is checked with panaSKImg itself before the final run:
  1. pedestal: the per-row pedestal is computed with each candidate method (median
     of the overscan, Gaussian fit, lowest-peak finder for charged overscans), the
     DC fit is run for each, and the one with the smallest total fit error is kept
     (gain/noise/dark-current errors scaled by sqrt(chi2/ndf), plus the dark-current
     bias against the 0e-/1e- pixel counts; a parameter stuck at a limit is penalised).
     Smallest error, not smallest noise: a wrong pedestal can make the noise look
     smaller while biasing the dark current.
  2. window: panaSKImg is run with a wide window; in its own histogram the 0e- peak
     is located and the fit window and mu limits are centred on it (useful when the
     pedestal leaves the 0e- peak away from 0 ADU). The number of fitted peaks stays
     the module-wide choice.
  3. a check fit; its results are in logs/<image>_autoconfig_dc.log.
  The all-peaks (gain) JSON then uses the same pedestal and 0e- position.

--gain-correction (optional): the gain falls slowly with the charge in a pixel (~3% at
  1000 e-), so cluster energies come out low at keV energies. With this flag, after the
  panaSKImg runs, gain_vs_charge.py measures g(n) from the images themselves (spacing of
  the electron comb at high charge, clean rows only; images of the same module together),
  and writes corrected cluster files (pixels_E and Energy recomputed) to root_gaincorr/,
  with root_gaincorr/root_files.txt. Curves and fits: gain_vs_charge/. Originals in root/.
  By default the comb's whole g(n) is used, including its low-charge gain (one curve for
  all images of a CCD; this removes image-to-image scatter of the 0e-/1e- gain fits);
  --gain-anchor fit keeps each image's fitted gain and corrects only the charge
  dependence. CCDs whose curve is not trustworthy (measured to < 400 e-, or rising) are
  copied unchanged. Each curve also gets <name>_nonlinearity.png in gain_vs_charge/:
  measured charge minus peak number against measured charge, A(n)/g(0) - n, with the
  curve's low-charge gain g(0) as reference (points from the measured local gains, the
  model, and a quadratic fit). Several images of a module are combined incoherently by default
  (--gain-combine incoherent): each image's comb power is added (comb search started at the mean
  low-charge gain of the images, so independent of the image order).
  --gain-combine coherent converts each image to electrons with its own curve first, so the comb
  teeth of all images line up and their pixels can be pooled into one comb; this reaches higher
  charge, but on the Am-241 lines (AMtest EXT4, 2026-10-26) it split the two gain periods by 0.6 %,
  so it is not the default (on Fe-55 it was as good or slightly better). The comb
  is measured with the run's --autoconfig-args (geometry, gain prior and range), as the JSONs.
  --temperature K: energy per electron-hole pair epsilon(T) = 3.752 eV x (1 - 1.31e-4/K (T - 123 K))
  (Rodrigues et al. 2021, skipper CCD at 5.9 keV and 123 K; slope Lowe & Sareen 2007), default 130 K
  -> 3.7486 eV (src/pair_energy.py; $COMM_TEMPERATURE_K also works). Used for the gain-corrected
  energies (root_gaincorr*/) and A_GMX; panaSKImg's own cluster files (root/) keep its fixed 3.74 eV.
  --gain-memory auto: before the comb is measured, remove the horizontal readout memory: the video
  signal of a pixel keeps ~3e-4 of the pixel read just before it (kL 1.6-3.8e-4 on the AMtest and
  DM24-26 CCDs), which inside clusters adds ~0.3 e- per 1000 e- and blurs the comb at high charge.
  The coefficients are fitted per CCD (in the JSON as 'memory'); the curve then reaches higher
  charge (e.g. 1500 -> 2000 e-). Only the measurement changes; cluster energies are converted as
  before (the memory itself shifts them by only ~+0.03 %). Default off.
  --gain-model smooth (default) | interpolated | broken | linear: the form of g(n): monotone
  interpolation through the measured points, two straight lines with a fitted knot, one
  straight line (see gain_vs_charge.py; the straight line does not follow the measured
  curvature, the others do), or smooth: above 200 e- windows of the same width overlapping
  (4x the points) and a weighted fit of g(n) as a cubic in log n through them instead of a
  curve through every point; below 200 e- the standard points, as interpolated (reaches
  higher charge; same g(0)). smooth is the default since 2026-11-02: on 141 Fe-55
  CCD-images (DM11-26) its K-alpha equals interpolated's within 1 eV on average, and on the
  Am-241 59.5 keV line (AMtest EXT4) it is closer (-0.32 % instead of -0.57 %).
  --gain-periods auto (default) | off: images of one module are pooled only within a gain
  period. A change of the readout settings between campaigns shifts the gain of all CCDs
  (AMtest 106: 2.5-3.5 % lower from 2026-05-21); pooling both puts two combs on top of each
  other, and every line in the corrected energies comes out doubled. auto: the images are put
  in time order (date in the name), each image's gain (0e-/1e- fit, mean over the CCDs relative
  to the module median) is compared, and the module is split where the gain steps by > 1 %
  and > 5x the image-to-image scatter (gain_vs_charge.gain_periods; a single image with a poor
  fit is not a period). Each period gets its own curve, module_<ACM>_period<k>_gain_vs_charge.json;
  a CCD whose period curve is not usable gets the curve of the whole module. summary.txt lists
  the periods and the step. off: one curve per module.
  --gain-correction per-image: every image gets its own curve, measured from that image
  alone (gain_vs_charge/image_<image>_gain_vs_charge.json), applied to its own clusters
  -> root_gaincorr_per_image/ (a CCD whose own comb is not usable, e.g. a noisy image,
  gets the module curve; noted in summary.txt). --gain-correction both: pooled and per-image, and
  gain_vs_charge/per_image_vs_pooled.csv compares them per image and CCD (curve a, drop
  at 1000 e-, cluster energies per-image/pooled, front-side Fe-55 K-alpha, sigma_xy < 1).

--composite (optional): after the panaSKImg runs, MakeComposite_Fe55_Clusters_Extensions.cc
  (front/back composite clusters, Fe-55 Kalpha/Kbeta fits, CTI) is run with ROOT on the
  cluster files, once per image type and module (the gain-corrected files if
  --gain-correction is on: root_gaincorr/, or root_gaincorr_per_image/ with
  --gain-correction per-image; else root/; with --gain-correction both also
  root_gaincorr_per_image/ -> composite_per_image/):
    composite/lists/Image_<N>_<module>_list.txt          the file list given to the macro
    composite/Fe_55_Analysis_Plots/<module>/Image_<N>_<module>_list/
                                     ext1..ext4/ per-CCD plots, compare/ 2x2 comparisons
    logs/composite_Image_<N>_<module>.log                ROOT output
  The image type N comes from "Image_<N>" in the image name (--image-number N to set it);
  it selects the CCD geometry in the macro (4, 5, 6, 7, 8, 11). The module comes from
  --module ACM=NAME, else from a data folder named ..._DMa_DMb_DMc_... (ACM 110 -> DMa,
  109 -> DMb, 106 -> DMc), else ACM<id>. Macro: --composite-macro, $MAKECOMPOSITE_MACRO,
  else ~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc.

--clusterer waders|agmx|both (default waders): which clusters the analysis gets.
  waders  panaSKImg's ClusterFinder only (root/), as before.
  agmx    also A_GMX (adaptive + Gaussian-mixture clustering, docs/aGMX/aGMX_clustering.tex) on the calibrated
          images panaSKImg saved (*_EXT<n>_waders.fits.bz2), after the panaSKImg runs and the gain correction:
            root_agmx/            the images as calibrated by panaSKImg
            root_agmx_gaincorr/   with --gain-correction: the images converted with the module's g(n) curve
                                  (root_agmx_gaincorr_per_image/ with --gain-correction per-image/both)
          The files have the WADERs ClusterFinder format (panaSKImg_clustersRec_<image>_ext<n>.root, trees
          clustersRec/info/process_config, every branch computed by pysimdamicm's Cluster class) plus agmx_*
          branches (class, blend, ped, peakfrac, chi2, significance, regime). Recommended for X-ray lines:
          agmx_blend < 0.02 and agmx_ped < 10 with the usual sigma_xy cut. --composite uses the A_GMX files.
          panaSKImg's ClusterFinder still runs (root/ is kept and gives info/process_config).
  both    as agmx, but --composite runs on the WADERs files (composite/) and on the A_GMX files (composite_agmx/).
  --agmx-crowded auto|on|off (default auto): A_GMX crowded mode for CCDs dense with tracks (core fill >= 0.10:
          the fraction of pixels whose smoothed charge is above max(60 e-, 5 noise); L2 surface runs ~0.29, Am-241
          ~0.45, Fe-55 production CCDs ~0.02, which are clustered exactly as before): regional background override,
          serial-register streaks as separate 'artifact-row' clusters, straight tracks found and given to GMX as
          hints (one 'muon' cluster each, A_GMX's own width and charge sharing at crossings), X-crossings split,
          collinear fragments linked. Recorded per file in agmx_config (crowded_mode).
  For a run that is already finished: bin/run_AGMX WADERs_analysis_<run>.

settings you can pass with --autoconfig-args "..." (all inside one quoted string):
  --cluster-threshold-e PIX SEED  cluster thresholds in e- (pixel > PIX, seed > SEED);
                                  much faster on images with high dark current
  --plot-peaks N                  DC-fit plot shown up to N e- (default 5)
  --reference my.json             start from your own JSON instead of the built-in one
  --gain G                        gain prior [ADU/e-] if the peaks are hard to resolve
  --gain-min / --gain-max         gain search range [ADU/e-] (default 0.6 / 3.0)
  --lam-max L                     leave out rows with more than L e-/pix (default 1.0)
  --min-rows N                    minimum rows in the fit (default 25)
  --ccd-cols N                    override the active/overscan column boundary
  --dead-frac F / --keep-dead     detection of channels without a CCD / keep them
  --cluster-all                   search clusters even on flooded CCDs
  --max-peaks N                   maximum number of peaks considered (default 10)
  --poisson-tol T                 how closely a peak must follow Poisson to be
                                  fitted (default 0.25)
  (do not pass --peaks, --per-ext or --tune here: use run_WADERs' own --tune)

examples:
  run_WADERs avg_Image_8_Low_Temp_106_20260330_123052_21.fz
  run_WADERs my_images.txt -o ~/analysis -j 8
  run_WADERs my_images.txt --autoconfig-args "--cluster-threshold-e 2 5"
  run_WADERs image.fits.bz2 --overwrite --all-ext
  run_WADERs my_images.txt --no-clusters        noise/gain/dark current only, fast
  run_WADERs image.fz --tune                     pedestal and window checked per CCD
  run_WADERs images.txt --gain-correction        also gain-corrected cluster files
  run_WADERs images.txt --gain-correction both   per-image and per-module curves, compared
  run_WADERs images.txt --composite --gain-correction --module 109=DM02
                                                 then MakeComposite on the corrected files
  run_WADERs images.txt --gain-correction --clusterer both --composite
                                                 WADERs and A_GMX clusters, both through MakeComposite

environment variables: WADERS_ENV (conda environment), PANASKIMG (panaSKImg script),
  MAKECOMPOSITE_MACRO (MakeComposite_Fe55_Clusters_Extensions.cc for --composite)
"""


SHORT_DESCRIPTION = """\
Raw skipper-CCD image(s) -> one JSON per CCD -> panaSKImg per CCD -> plots, cluster
ROOT files and a fit summary in WADERs_analysis_<run name>/."""

SHORT_EPILOG = """\
examples:
  run_WADERs image.fz
  run_WADERs images.txt -o ~/analysis -j 8 --no-clusters

run_WADERs -h -v   full guide: output folders, what each step does, --tune, and all
                   settings for --autoconfig-args"""


def build_parser(full=False):
    """The command-line parser; full=True uses the long guide (HELP_DESCRIPTION/HELP_EPILOG) for -h -v."""
    ap = argparse.ArgumentParser(
        prog="run_WADERs",
        usage="run_WADERs INPUT [options]      (-h: flags, -h -v: full guide)",
        description=HELP_DESCRIPTION if full else SHORT_DESCRIPTION,
        epilog=HELP_EPILOG if full else SHORT_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", metavar="INPUT",
                    help="an image (.fz, .fits, .fits.bz2) or a .txt with one image path per line")
    ap.add_argument("-o", "--parent", metavar="DIR", default=".",
                    help="folder in which WADERs_analysis_<run name> is created (default: current folder)")
    ap.add_argument("-j", "--jobs", metavar="N", type=int, default=min(4, os.cpu_count() or 1),
                    help="number of panaSKImg runs at the same time (default: 4, or fewer if fewer CPUs)")
    ap.add_argument("--overwrite", action="store_true",
                    help="replace an existing WADERs_analysis_<run name> folder (otherwise it stops)")
    ap.add_argument("--engine", choices=("native", "waders"), default="native",
                    help="native (default): comm_scripts' own pedestal, fits, clustering and cluster files "
                         "(src/native_pipeline.py; no panaSKImg; -j = images in parallel). waders: panaSKImg "
                         "(pysimdamicm) per CCD (details: -h -v)")
    ap.add_argument("--thresholds", metavar="auto|sigma0|PIX,SEED", default="auto",
                    help="--engine native: cluster thresholds. auto (default): in electrons from each CCD's dark "
                         "charge; sigma0: panaSKImg's 10 / 30 x pedestal sigma; PIX,SEED: fixed, in electrons")
    ap.add_argument("--all-ext", action="store_true",
                    help="also run CCDs flagged as flooded/unresolved (slow, fits not reliable); their clusters "
                         "are only searched with --autoconfig-args \"--cluster-all\" (which also runs them)")
    ap.add_argument("--no-clusters", action="store_true",
                    help="noise, gain and dark current only: leave out ClusterFinder and BuildClusterMask "
                         "(no cluster ROOT files; much faster)")
    ap.add_argument("--gain-correction", nargs="?", const="pooled", choices=("pooled", "per-image", "both"),
                    metavar="MODE",
                    help="measure the gain vs charge per pixel g(n) from the images and write gain-corrected "
                         "cluster files (originals kept). MODE: pooled (default: one curve per module from all "
                         "its images -> root_gaincorr/), per-image (each image's own curve -> "
                         "root_gaincorr_per_image/), both (both, plus a comparison; details: -h -v)")
    ap.add_argument("--gain-model", choices=("smooth", "interpolated", "broken", "linear"), default="smooth",
                    help="with --gain-correction: form of g(n): smooth (default; overlapping windows and a smooth "
                         "weighted fit above 200 e-, the standard points below; reaches higher charge), "
                         "interpolated (monotone interpolation through the measured points), broken (two straight "
                         "lines, fitted knot) or linear")
    ap.add_argument("--gain-combine", choices=("coherent", "incoherent"), default="incoherent",
                    help="with --gain-correction: how several images of a module are combined for the module curve: "
                         "incoherent (default; comb powers added - independent of the image order) or coherent "
                         "(each image converted with its own curve, then all pixels pooled; reaches higher charge)")
    ap.add_argument("--gain-memory", choices=("off", "auto"), default="off",
                    help="with --gain-correction: remove the horizontal readout memory (a pixel keeps ~3e-4 of the "
                         "pixel read before it) before measuring g(n): off (default) or auto (coefficients fitted "
                         "per CCD; the comb stays visible to higher charge)")
    ap.add_argument("--gain-periods", choices=("auto", "off"), default="auto",
                    help="with --gain-correction: auto (default): split a module's images into gain periods where "
                         "their fitted gain steps (> 1 %%, e.g. new readout settings) and measure one curve per "
                         "period; off: one curve per module")
    ap.add_argument("--gain-anchor", choices=("comb", "fit"), default="comb",
                    help="with --gain-correction: convert with the comb's g(n) including its low-charge gain "
                         "(comb, default), or keep each image's fitted gain and correct only the charge "
                         "dependence (fit)")
    ap.add_argument("--clusterer", choices=("waders", "agmx", "both"), default="waders",
                    help="waders (default): panaSKImg's ClusterFinder only. agmx: also A_GMX cluster files in the same "
                         "format (root_agmx*/), used by --composite. both: as agmx, --composite on both (details: -h -v)")
    ap.add_argument("--agmx-crowded", choices=("auto", "on", "off"), default=os.environ.get("AGMX_CROWDED", "auto"),
                    help="with --clusterer agmx/both: A_GMX crowded mode (clustering_tests/crowded.py). auto (default): on "
                         "for CCDs whose core fill is >= 0.10 (dense tracks, e.g. L2 surface runs, Am-241); on; off")
    ap.add_argument("--agmx-crowded-shapes", choices=("on", "off"), default=os.environ.get("AGMX_CROWDED_SHAPES", "on"),
                    help="with --agmx-crowded: muons as line components of the A_GMX mixture and a topology split of "
                         "clusters (clustering_tests/crowded_shapes.py; default on; only on crowded CCDs)")
    ap.add_argument("--temperature", type=float, default=None, metavar="K",
                    help="CCD operating temperature for the energy per electron epsilon(T) used for gain-corrected and A_GMX "
                         "energies (default: $COMM_TEMPERATURE_K or 130 K -> 3.7486 eV; details: -h -v)")
    ap.add_argument("--composite", action="store_true",
                    help="after panaSKImg, run MakeComposite_Fe55_Clusters_Extensions.cc on the cluster files, "
                         "once per image type and module (output in composite/; details: -h -v)")
    ap.add_argument("--composite-macro", metavar="PATH",
                    default=os.environ.get("MAKECOMPOSITE_MACRO", DEFAULT_COMPOSITE_MACRO),
                    help="with --composite: the macro to run (default: $MAKECOMPOSITE_MACRO, else "
                         "~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc)")
    ap.add_argument("--module", metavar="ACM=NAME", action="append", default=[],
                    help="with --composite: module name of an ACM, e.g. --module 109=DM02 (repeat per ACM; "
                         "default: from a ..._DMa_DMb_DMc_... data folder name, else ACM<id>)")
    ap.add_argument("--image-number", metavar="N", type=int,
                    help="with --composite: image type given to the macro (default: Image_<N> in the image name)")
    ap.add_argument("--tune", action="store_true",
                    help="check each CCD's pedestal method and fit window with panaSKImg before the "
                         "final run (smallest total fit error; ~1 min more per image)")
    ap.add_argument("--keep-work", action="store_true",
                    help="keep the intermediate gain and 0e-/1e- fit runs in work/ (normally deleted)")
    ap.add_argument("--autoconfig-args", metavar='"ARGS"', default="",
                    help="extra settings for the JSON generation, in one quoted string (list: -h -v)")
    ap.add_argument("--env", metavar="NAME", default=os.environ.get("WADERS_ENV"),
                    help="conda environment to use if this python lacks pysimdamicm "
                         "(default: $WADERS_ENV, else the first environment with panaSKImg)")
    ap.add_argument("--panaskimg", metavar="PATH", default=os.environ.get("PANASKIMG"),
                    help="panaSKImg script to use (default: $PANASKIMG, else found automatically)")
    ap.add_argument("-v", "--verbose", action="store_true", help="with -h: show the full guide")
    return ap


def parse_args():
    """Parse the command line; -h together with -v prints the full guide and exits."""
    argv = sys.argv[1:]
    if any(a in ("-h", "--help") for a in argv) and any(a in ("-v", "--verbose") for a in argv):
        build_parser(full=True).print_help()
        sys.exit(0)
    return build_parser().parse_args()


def front_kalpha(files):
    """Front-side Fe-55 K-alpha (clusters with sigma_xy = sqrt((fSTD_X^2+fSTD_Y^2)/2) < 1 and
    4.5 < E < 7 keV, as in MakeComposite_Fe55_Clusters_Extensions.cc): unbinned fit of K-alpha +
    K-beta (at 6.490/5.899 x K-alpha, same width) + flat background. Returns (mu, err, n) or None."""
    import numpy as np
    import ROOT
    from scipy import optimize
    E = []
    for f in files:
        tf = ROOT.TFile.Open(f)
        t = tf.Get("clustersRec") if tf else None
        if t and isinstance(t, ROOT.TTree):
            for i in range(t.GetEntries()):
                t.GetEntry(i)
                sx, sy = np.array(list(t.fSTD_X)), np.array(list(t.fSTD_Y))
                e = np.array(list(t.Energy))
                E.append(e[(np.sqrt(0.5 * (sx ** 2 + sy ** 2)) < 1) & (e > 4.5) & (e < 7.0)])
        if tf:
            tf.Close()
    e = np.concatenate(E) if E else np.array([])
    if e.size < 30:
        return None
    lo, hi, r = 4.5, 7.0, 6.490 / 5.899

    def nll(p):
        """Unbinned negative log-likelihood: K-alpha and K-beta Gaussians (fraction fb in K-beta) + flat background."""
        mu, s, fb, fbg = p
        g = lambda m: np.exp(-0.5 * ((e - m) / s) ** 2) / (s * np.sqrt(2 * np.pi))
        v = (1 - fbg) * ((1 - fb) * g(mu) + fb * g(mu * r)) + fbg / (hi - lo)
        return np.inf if np.any(v <= 0) else -np.sum(np.log(v))
    sel = e[(e > 5.0) & (e < 6.2)]
    res = optimize.minimize(nll, [np.median(sel) if sel.size else 5.8, 0.1, 0.15, 0.1], method="L-BFGS-B",
                            bounds=[(5.0, 6.3), (0.03, 0.5), (0.0, 0.5), (1e-4, 0.9)])
    h = 1e-3
    curv = (nll(res.x + [h, 0, 0, 0]) - 2 * nll(res.x) + nll(res.x - [h, 0, 0, 0])) / h ** 2
    return float(res.x[0]), float(1 / np.sqrt(curv)) if curv > 0 else float("nan"), int(e.size)


def compare_gain_corrections(configs, curves, gc_dirs, gcdir, no_clusters):
    """--gain-correction both: per image and CCD, the image's own curve vs the module curve.
    Writes gain_vs_charge/per_image_vs_pooled.csv; returns summary lines."""
    import csv
    import numpy as np
    import ROOT
    rows = []
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        mp = json.load(open(curves[("pooled", r["stem"])]))["extensions"]
        mi = json.load(open(curves[("per-image", r["stem"])]))["extensions"]
        for ext in sorted(set(mp) | set(mi)):
            p, q = mp.get(ext, {}), mi.get(ext, {})
            row = dict(image=r["stem"], ext=ext, pooled_ok=bool(p.get("ok")), per_image_ok=bool(q.get("ok")),
                       per_image_source=q.get("source", "image"))
            for tag, m in (("pooled", p), ("per_image", q)):
                row[f"a_{tag}"] = round(m["model"]["a"], 5) if m.get("ok") else ""
                row[f"drop1000_{tag}_pct"] = round(m["drop_at_1000"] * 100, 3) if m.get("ok") else ""
                row[f"nmax_{tag}"] = m.get("n_max_measured", "") if m.get("ok") else ""
            if not no_clusters:
                name = f"panaSKImg_clustersRec_{r['stem']}_ext{ext[3:]}.root"
                fp, fi = os.path.join(gc_dirs["pooled"], name), os.path.join(gc_dirs["per-image"], name)
                ratios = []
                if os.path.exists(fp) and os.path.exists(fi):
                    tp, ti = ROOT.TFile.Open(fp), ROOT.TFile.Open(fi)
                    a_, b_ = tp.Get("clustersRec"), ti.Get("clustersRec")
                    if a_ and b_ and isinstance(a_, ROOT.TTree) and isinstance(b_, ROOT.TTree):
                        for k in range(a_.GetEntries()):
                            a_.GetEntry(k); b_.GetEntry(k)
                            ep, ei = np.array(list(a_.Energy)), np.array(list(b_.Energy))
                            w = ep > 1.0
                            ratios += list(ei[w] / ep[w])
                    tp.Close(); ti.Close()
                    fk_p, fk_i = front_kalpha([fp]), front_kalpha([fi])
                else:
                    fk_p = fk_i = None
                ratios = np.array(ratios)
                row["median_E_per_image_over_pooled"] = round(float(np.median(ratios)), 5) if ratios.size else ""
                row["max_abs_E_diff_pct"] = round(float(np.max(np.abs(ratios - 1)) * 100), 3) if ratios.size else ""
                for tag, fk in (("pooled", fk_p), ("per_image", fk_i)):
                    row[f"front_kalpha_{tag}_keV"] = round(fk[0], 4) if fk else ""
                    row[f"front_kalpha_{tag}_err"] = round(fk[1], 4) if fk else ""
                row["front_clusters"] = fk_p[2] if fk_p else ""
            rows.append(row)
    path = os.path.join(gcdir, "per_image_vs_pooled.csv")
    if rows:
        keys = list(dict.fromkeys(k for row in rows for k in row))
        with open(path, "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=keys)
            w.writeheader()
            w.writerows(rows)
    lines = ["per-image vs pooled gain correction (--gain-correction both; details in " + path + "):"]
    for row in rows:
        if not (row["pooled_ok"] and row["per_image_ok"]):
            lines.append(f"  {row['image']} {row['ext']}: curve missing (pooled ok {row['pooled_ok']}, "
                         f"per-image ok {row['per_image_ok']})")
            continue
        da = (row["a_per_image"] / row["a_pooled"] - 1) * 100
        dd = row["drop1000_per_image_pct"] - row["drop1000_pooled_pct"]
        txt = f"  {row['image']} {row['ext']}: a {da:+.3f}%, drop at 1000 e- {dd:+.2f} points"
        if row["per_image_source"] == "module":
            txt += " (own comb not usable: module curve used, same as pooled)"
        if row.get("median_E_per_image_over_pooled", "") != "":
            txt += (f", cluster E per-image/pooled median {row['median_E_per_image_over_pooled']:.5f} "
                    f"(max |diff| {row['max_abs_E_diff_pct']:.2f}%)")
        if row.get("front_kalpha_pooled_keV", "") != "":
            txt += (f", front K-alpha {row['front_kalpha_pooled_keV']:.4f} (pooled) vs "
                    f"{row['front_kalpha_per_image_keV']:.4f} (per image) +- {row['front_kalpha_pooled_err']:.4f} keV, "
                    f"{row['front_clusters']} clusters")
        lines.append(txt)
    return lines


# =============================================================================
# The pipeline, one function per step
# =============================================================================
@dataclass
class Run:
    """What the pipeline steps share for one run_WADERs call.

    args       the parsed command line
    run_name   image name (one image) or .txt name (a list); the output folder is WADERs_analysis_<run_name>
    images     absolute paths of the raw images
    out        the output folder
    modules    {ACM id: module name} from --module (used by --composite)
    panaskimg  path of the panaSKImg script
    dirs       output sub-folders: json, root, logs, work, fits (root/dc_fits), and, when made, gc (gain_vs_charge)
               and root_gc (the corrected cluster files given to --composite)
    t0         start time (for the [  12s] progress stamps)
    A, FQ, G   the pipeline modules autoconfig_panaSKImg, fit_quality and gain_dc_split (imported once the
               environment with ROOT/pysimdamicm is known to be available)
    """
    args: argparse.Namespace
    run_name: str
    images: list
    out: str
    modules: dict
    panaskimg: str = ""
    dirs: dict = field(default_factory=dict)
    t0: float = 0.0
    A: object = None
    FQ: object = None
    G: object = None

    def stamp(self):
        """Seconds since the start, formatted as in the progress lines: '[  12s]'."""
        return f"[{time.time() - self.t0:5.0f}s]"


def check_request(args):
    """Checks that need only the standard library, done before any conda environment is looked for (so mistakes
    give a clear message quickly). Returns (run_name, images, out, modules); resolves args.composite_macro."""
    run_name, images = read_inputs(args.input)
    out = os.path.join(os.path.abspath(args.parent), f"WADERs_analysis_{run_name}")
    if os.path.exists(out) and os.listdir(out) and not args.overwrite:
        sys.exit(f"run_WADERs: {out} already exists; use --overwrite to replace it")
    modules = parse_modules(args.module)
    if args.jobs < 1:
        sys.exit("run_WADERs: -j/--jobs must be at least 1")
    stems = {}
    for p in images:
        stems.setdefault(image_stem(p), []).append(p)
    dup = {s: ps for s, ps in stems.items() if len(ps) > 1}
    if dup:
        sys.exit("run_WADERs: images with the same name would overwrite each other's results: "
                 + "; ".join(f"{s}: {', '.join(ps)}" for s, ps in sorted(dup.items())))
    try:
        auto = shlex.split(args.autoconfig_args)
    except ValueError as e:
        sys.exit(f"run_WADERs: --autoconfig-args cannot be parsed ({e})")
    check_engine(args, auto)
    bad = sorted({a.split("=")[0] for a in auto} & set(RESERVED_AUTOCONFIG))
    if bad:
        sys.exit(f"run_WADERs: {', '.join(bad)} cannot be given in --autoconfig-args (run_WADERs sets "
                 "them; use run_WADERs' own --tune)")
    if args.clusterer != "waders" and args.no_clusters:
        sys.exit(f"run_WADERs: --clusterer {args.clusterer} needs panaSKImg's cluster files; it cannot be used with --no-clusters")
    if args.composite:
        if args.no_clusters:
            sys.exit("run_WADERs: --composite needs the cluster files; it cannot be used with --no-clusters")
        args.composite_macro = os.path.abspath(os.path.expanduser(args.composite_macro))
        if not os.path.isfile(args.composite_macro):
            sys.exit(f"run_WADERs: MakeComposite macro {args.composite_macro} not found; give --composite-macro PATH")
    return run_name, images, out, modules


def load_pipeline_modules(run):
    """Import the pipeline modules from comm_scripts/src (needs ROOT/pysimdamicm, so only after ensure_environment)
    and find panaSKImg (--panaskimg, else the one autoconfig_panaSKImg finds)."""
    if not os.path.isfile(os.path.join(SRC_DIR, "gain_dc_split.py")):
        sys.exit(f"run_WADERs: pipeline modules not found in {SRC_DIR} (keep the comm_scripts layout: bin/, src/)")
    sys.path.insert(0, SRC_DIR)
    import autoconfig_panaSKImg as A
    import fit_quality as FQ
    import gain_dc_split as G
    run.A, run.FQ, run.G = A, FQ, G
    run.panaskimg = run.args.panaskimg or A.DEFAULT_PANASKIMG
    if not run.panaskimg or not os.path.isfile(run.panaskimg):
        sys.exit("run_WADERs: panaSKImg not found; give --panaskimg /path/to/panaSKImg")


def prepare_output(run):
    """Create the (emptied, with --overwrite) output folder and its json/, root/, root/dc_fits/, logs/, work/."""
    out = run.out
    if os.path.exists(out) and os.listdir(out):
        shutil.rmtree(out)                     # --overwrite (checked in check_request)
    D = {k: os.path.join(out, k) for k in ("json", "root", "logs", "work")}
    D["fits"] = os.path.join(D["root"], "dc_fits")
    for d in D.values():
        os.makedirs(d, exist_ok=True)
    if "_ext" in out:
        print("WARNING: the output path contains '_ext'; scripts that read the extension from "
              "'_ext<N>' in the path (MakeComposite_Fe55_Clusters_Extensions.cc) may misread it")
    run.dirs = D


def step1_configure(run):
    """Step 1: one panaSKImg JSON per CCD for every image (gain_dc_split.split_image), images in parallel.

    For each CCD, autoconfig measures the raw pixels; the image is fitted twice (0e-/1e- peaks only, for an unbiased
    dark current; all resolved peaks, for a more precise gain) and the more precise gain is kept in the final JSON.
    Returns {image path: result dict of split_image} (keys used later: stem, src, finals, held, refs, notes, skipped).
    """
    args, D = run.args, run.dirs

    def configure(img):
        """Run gain_dc_split on one image and move its autoconfig logs to logs/."""
        stem = run.G.image_stem(img)
        jdir = os.path.join(D["json"], stem)
        r = run.G.split_image(img, jdir, per_ext=True, panaskimg=run.panaskimg,
                              autoconfig_args=shlex.split(args.autoconfig_args),
                              work=os.path.join(D["work"], stem), final_fit=False, jobs=1, tune=args.tune)
        r["orig"] = img           # r["src"] may be a decompressed copy in work/ (deleted at the end)
        for lg in glob.glob(os.path.join(jdir, "autoconfig_*.log")):      # logs together
            shutil.move(lg, os.path.join(D["logs"], f"{stem}_{os.path.basename(lg)}"))
        return r

    configs = {}
    with cf.ThreadPoolExecutor(max_workers=args.jobs) as ex:
        futs = {ex.submit(configure, img): img for img in run.images}
        for f in cf.as_completed(futs):
            img = futs[f]
            try:
                r = f.result()
                configs[img] = r
                held = ", ".join(r["held"]) or "none"
                print(f"  {run.stamp()} JSONs ready: {r['stem']} (gain held: {held})")
            except Exception as err:                       # keep going with the other images
                print(f"  ERROR configuring {os.path.basename(img)}: {err}")
    return configs


def drop_cluster_finding(configs):
    """--no-clusters: remove ClusterFinder and BuildClusterMask from the final JSONs, so json/ shows what ran."""
    for r in configs.values():
        for ext, path, skip in r["finals"]:
            cfg = json.load(open(path))
            seq = cfg["process"]["sequence"].split(";")
            cfg["process"]["sequence"] = ";".join(
                p for p in seq if p.strip() not in ("ClusterFinder", "BuildClusterMask"))
            with open(path, "w") as fh:
                json.dump(cfg, fh, indent=4)
    print("  --no-clusters: ClusterFinder and BuildClusterMask removed from the final JSONs")


def _image_time(stem):
    """'YYYYMMDDhhmmss' from an image name (..._106_20250914_024425_6), '' if it has none."""
    m = re.search(r"_(\d{8})_(\d{6})(?:_|$)", stem)
    return m.group(1) + m.group(2) if m else ""


def module_groups(run, configs, GVC):
    """The images that share one g(n) curve: ({key: [config records]}, {key: module}, summary lines).

    Images of one module (ACM id in the name) share the CCDs: key = the ACM id. With --gain-periods auto a module
    is split into gain periods where the gain of all its CCDs steps (gain_vs_charge.gain_periods, on each image's
    0e-/1e- fit gain relative to the module median, averaged over the CCDs, in time order): key <ACM>_period<k>.
    """
    import numpy as np
    modules = {}
    for r in configs.values():
        modules.setdefault(acm_id(r["stem"]) or r["stem"], []).append(r)
    groups, parent, lines = {}, {}, []
    for key, rs in sorted(modules.items()):
        rs = sorted(rs, key=lambda r: (_image_time(r["stem"]), r["stem"]))
        gains = []                      # per image: {ext: (gain, error)} from the 0e-/1e- fit
        for r in rs:
            fits = r.get("fits", {}).get("dc", {})
            q = {e: run.FQ.quality(f) for e, f in fits.items() if e not in r.get("skipped", ())}
            gains.append({e: (v["gain"], max(v["gain_err_s"], 1e-4)) for e, v in q.items() if v.get("gain")})
        exts = sorted({e for g in gains for e in g})
        med = {e: float(np.median([g[e][0] for g in gains if e in g])) for e in exts}
        x, s, have = [], [], []
        for i, g in enumerate(gains):
            if g:
                d = np.array([np.log(v / med[e]) for e, (v, _) in g.items()])
                w = np.array([(v / err) ** 2 for e, (v, err) in g.items()])
                x.append(float(np.sum(w * d) / w.sum()))
                s.append(float(w.sum() ** -0.5))
                have.append(i)
        label = np.zeros(len(rs), int)
        if run.args.gain_periods == "auto" and len(have) >= 4:
            lab, bad = GVC.gain_periods(x, s)
            for i in range(len(rs)):            # an image without a gain fit: the period of the image before it
                j = max([k for k, h in enumerate(have) if h <= i], default=0)
                label[i] = lab[j]
        if label.max() == 0:
            groups[key], parent[key] = rs, key
            continue
        lines.append(f"  module {key}: {label.max() + 1} gain periods (the gain of its CCDs steps; one curve each):")
        rel = dict(zip(have, x))
        for k in range(label.max() + 1):
            members = [r for r, lb in zip(rs, label) if lb == k]
            ids = [i for i, lb in enumerate(label) if lb == k]
            gk = f"{key}_period{k + 1}"
            groups[gk], parent[gk] = members, key
            t0, t1 = _image_time(members[0]["stem"]), _image_time(members[-1]["stem"])
            when = (f"{t0[:4]}-{t0[4:6]}-{t0[6:8]} {t0[8:10]}:{t0[10:12]} .. {t1[:4]}-{t1[4:6]}-{t1[6:8]} "
                    f"{t1[8:10]}:{t1[10:12]}") if t0 and t1 else f"{members[0]['stem']} .. {members[-1]['stem']}"
            v = [rel[i] for i in ids if i in rel]
            lines.append(f"    period {k + 1}: {len(members)} image(s), {when}, gain "
                         f"{np.median(v) * 100:+.2f} % vs module median" if v else
                         f"    period {k + 1}: {len(members)} image(s), {when}")
        out = [rs[i]["stem"] for i, b in zip(have, bad) if b]
        if out:
            lines.append(f"    single-image gain outliers (poor 0e-/1e- fit?; kept in their period): {', '.join(out)}")
    return groups, parent, lines


def fallback_curve(path, images, res, other, source, E_PER_E):
    """A CCD whose own curve is not usable gets the curve of `other` (recorded as source / own_reason);
    rewrites the model file. Returns the CCDs replaced."""
    replaced = []
    for ext, rr in res.items():
        rr.setdefault("source", "own")
        if not rr.get("ok") and other.get(ext, {}).get("ok"):
            res[ext] = dict(other[ext], source=source, own_reason=rr.get("reason"))
            replaced.append(ext)
    if replaced:
        with open(path, "w") as fh:
            json.dump({"images": images, "e_per_electron_eV": E_PER_E, "extensions": res}, fh, indent=1)
    return replaced


def step2_run_panaskimg(run, configs):
    """Step 2: panaSKImg once per CCD (--ext N) with its final JSON, all runs in parallel.

    CCDs flagged as flooded/unresolved by autoconfig are skipped unless --all-ext. A run counts as successful when
    its log contains "Finished correctly". Returns (tasks, failed): tasks = [(config, ext, json path)] that were run,
    failed = [(stem, ext, log path)].
    """
    args, D = run.args, run.dirs
    tasks = []
    for img, r in configs.items():
        for ext, path, skip in r["finals"]:
            if skip and not args.all_ext:
                print(f"  {r['stem']} {ext}: skipped (unresolved outlier CCD; --all-ext to run it)")
                continue
            tasks.append((r, ext, path))

    def run_one(task):
        """panaSKImg on one CCD; returns (stem, ext, ok, log path)."""
        r, ext, path = task
        cfg = json.load(open(path))
        cmd = [sys.executable, run.panaskimg, r["src"], "-j", path, "-o", run.out + "/", "--save-plots", "--ext", ext[3:]]
        if cfg["input"]["image"].get("ACM_multi_extension", False):
            cmd.append("--acm")
        log = os.path.join(D["logs"], f"{r['stem']}_{ext}_panaSKImg.log")
        with open(log, "w") as fh:
            subprocess.run(cmd, stdout=fh, stderr=subprocess.STDOUT)
        with open(log) as fh:
            ok = "Finished correctly" in fh.read()
        return r["stem"], ext, ok, log

    print(f"  running panaSKImg: {len(tasks)} CCD run(s)")
    failed = []
    with cf.ThreadPoolExecutor(max_workers=args.jobs) as ex:
        for fut in cf.as_completed([ex.submit(run_one, t) for t in tasks]):
            stem, ext, ok, log = fut.result()
            print(f"  {run.stamp()} {stem} {ext}: {'done' if ok else 'FAILED, see ' + log}")
            if not ok:
                failed.append((stem, ext, log))
    return tasks, failed


def step3_collect_root_files(run):
    """Step 3: move panaSKImg's cluster files to root/ and its dark-current fits to root/dc_fits/, and write
    root/root_files.txt (full paths, the input list for e.g. MakeComposite). Returns the sorted cluster files."""
    out, D = run.out, run.dirs
    for f in glob.glob(os.path.join(out, "panaSKImg_clustersRec_*.root")):
        shutil.move(f, os.path.join(D["root"], os.path.basename(f)))
    for f in glob.glob(os.path.join(out, "*_FitDarkCurrentProcess_side*.root")):
        shutil.move(f, os.path.join(D["fits"], os.path.basename(f)))
    roots = sorted(glob.glob(os.path.join(D["root"], "panaSKImg_clustersRec_*.root")))
    with open(os.path.join(D["root"], "root_files.txt"), "w") as fh:
        fh.write("".join(p + "\n" for p in roots))
    return roots


def measure_curve(run, GVC, rs, name, title, run_exts):
    """Measure g(n) from the images of the configured images rs (gain_vs_charge.measure), save it as
    gain_vs_charge/<name>_gain_vs_charge.json (with the original image paths) and its plots
    (<name>_gain_vs_charge.png, <name>_nonlinearity.png). Returns (json path, result per CCD)."""
    res = GVC.measure([r["src"] for r in rs], run_exts, verbose=False, model=run.args.gain_model,
                      combine=run.args.gain_combine, autoconfig_args=shlex.split(run.args.autoconfig_args),
                      memory=run.args.gain_memory)
    mpath = os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.json")
    with open(mpath, "w") as fh:
        json.dump({"images": [r["orig"] for r in rs], "e_per_electron_eV": GVC.E_PER_E, "extensions": res}, fh, indent=1)
    GVC.plot(res, os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.png"), title)
    GVC.plot_nonlinearity(res, os.path.join(run.dirs["gc"], f"{name}_nonlinearity.png"), title)
    return mpath, res


def report_curve(gc_lines, title, res):
    """Append one summary line per CCD describing a measured g(n) curve (or why there is none) to gc_lines."""
    for ext, rr in sorted(res.items()):
        if rr.get("ok"):
            m = rr["model"]
            gc_lines.append(f"  {title} {ext}: g(0) = {m['a']:.4f} ADU/e- (autoconfig comb gain {rr['g_1e']:.4f}), "
                            f"{rr['drop_at_1000'] * 100:.1f}% lower at 1000 e-, measured to "
                            f"{rr['n_max_measured']:.0f} e-"
                            + (f", nonlinearity {rr['nonlinearity']['c2']:.2e} x^2 {rr['nonlinearity']['c1']:+.4f} x"
                               if rr.get("nonlinearity") else "")
                            + (f" -- module curve: own comb not usable ({rr.get('own_reason')})"
                               if rr.get("source") == "module" else "")
                            + (f" [coherent, {len(rr['images_used'])} images; single images to "
                               f"{'/'.join(f'{v:.0f}' for v in rr['per_image_n_max'])} e-]"
                               if rr.get("combine") == "coherent" and rr.get("source") != "module" else "")
                            + (f" [readout memory removed, kL {rr['memory']['kL']:.2e}]" if rr.get("memory") else ""))
        else:
            gc_lines.append(f"  {title} {ext}: no correction ({rr.get('reason')})")


def apply_curve(run, GVC, gc_lines, mpath, rs, outdir):
    """Rewrite the cluster files of the images rs with the curve mpath into outdir (gain_vs_charge.apply), adding a
    summary line per file. Nothing to do with --no-clusters."""
    if run.args.no_clusters:
        return
    files = [f for r in rs for f in glob.glob(os.path.join(run.dirs["root"], f"panaSKImg_clustersRec_{r['stem']}_ext*.root"))]
    for src_f, dst_f, n, med in GVC.apply(mpath, sorted(files), outdir, verbose=False, anchor=run.args.gain_anchor):
        m = re.search(r"_ext(\d+)\.root$", dst_f)
        if m and GVC.load_model(mpath, m.group(1)) is None:
            what = "copied unchanged (no reliable curve for this CCD)"
        else:
            what = f"median E_corrected/E_original = {med:.4f}" if n else "corrected (no cluster above 1 keV to compare)"
        gc_lines.append(f"    {os.path.basename(dst_f)}: {what}")


def measure_gain_curves(run, GVC, configs, run_exts, modes, gc_lines, on_curve=None):
    """The g(n) curves of step 3b, written to gain_vs_charge/ with their plots: one per module, or per gain period of
    a module (module_groups), and with 'per-image' in modes one per image (the module curve where the image's own comb
    is not usable). Appends the summary lines to gc_lines; on_curve(mode, model file, records) is called after each
    curve (step 3b: correct those images' cluster files with it). Returns {(mode, image stem): model file}."""
    args = run.args
    # images of the same module (ACM id in the name, e.g. ..._106_20250914_024425_6) share the CCDs; split into
    # gain periods where the gain steps (--gain-periods auto)
    groups, parent, period_lines = module_groups(run, configs, GVC)
    if not groups:
        gc_lines.append("gain vs charge: nothing to correct, no image was configured")
    curves = {}                     # (mode, image stem) -> model file
    # module curves: used by 'pooled', and by 'per-image' for CCDs whose own comb is not usable
    module_res = {}
    gc_lines.append(f"gain vs charge per pixel (--gain-correction, --gain-model {args.gain_model}; one curve per "
                    f"module from all its images, from the electron comb in clean rows):")
    gc_lines += period_lines
    whole = {}                      # module -> curve from all its images (fallback for a period's unusable CCDs)
    for key, rs in sorted(groups.items()):
        print(f"  {run.stamp()} g(n) for module {key} ({len(rs)} image(s))")
        mpath, res = measure_curve(run, GVC, rs, f"module_{key}", f"module {key}", run_exts)
        if key != parent[key] and not all(rr.get("ok") for rr in res.values()):
            m = parent[key]
            if m not in whole:
                print(f"  {run.stamp()} g(n) for module {m}, all periods (for the CCDs without a period curve)")
                whole[m] = measure_curve(run, GVC, [r for k, v in groups.items() if parent[k] == m for r in v],
                                         f"module_{m}", f"module {m}", run_exts)[1]
            fallback_curve(mpath, [r["orig"] for r in rs], res, whole[m], "module", GVC.E_PER_E)
        report_curve(gc_lines, f"module {key}", res)
        module_res[key] = res
        if "pooled" in modes:
            curves.update({("pooled", r["stem"]): mpath for r in rs})
            if on_curve:
                on_curve("pooled", mpath, rs)
    if "per-image" in modes:
        gc_lines.append("gain vs charge per pixel, one curve per image (--gain-correction per-image; a CCD whose "
                        "own comb is not usable gets the module curve):")
        for key, rs in sorted(groups.items()):
            for r in sorted(rs, key=lambda r: r["stem"]):
                print(f"  {run.stamp()} g(n) for image {r['stem']}")
                mpath, res = measure_curve(run, GVC, [r], f"image_{r['stem']}", r["stem"], run_exts)
                for ext, rr in res.items():       # fallback to the module curve, recorded in the file
                    rr["source"] = "image"
                    mod = module_res[key].get(ext, {})
                    if not rr.get("ok") and mod.get("ok"):
                        res[ext] = dict(mod, source="module", own_reason=rr.get("reason"))
                with open(mpath, "w") as fh:
                    json.dump({"images": [r["orig"]], "e_per_electron_eV": GVC.E_PER_E, "extensions": res},
                              fh, indent=1)
                report_curve(gc_lines, r["stem"], res)
                curves[("per-image", r["stem"])] = mpath
                if on_curve:
                    on_curve("per-image", mpath, [r])
    return curves


def step3b_gain_correction(run, configs, tasks):
    """Step 3b, --gain-correction: measure the gain vs charge per pixel g(n) and write corrected cluster files.

    Why: the gain falls slowly with the charge in a pixel (~3 % at 1000 e-), so keV clusters come out low when every
    pixel is converted with the low-charge gain. g(n) is measured from the images themselves (the spacing of the
    electron comb at high charge) and each pixel's ADU is converted with it.
    Images of one module (ACM id in the name) share the CCDs and are grouped:
      pooled     one curve per module from all its images            -> root_gaincorr/
      per-image  one curve per image (module curve where the image's own comb is not usable) -> root_gaincorr_per_image/
      both       both, plus gain_vs_charge/per_image_vs_pooled.csv comparing them
    Returns (gc_lines, gc_dirs): summary lines and {mode: folder of corrected cluster files}; also sets
    run.dirs["gc"] and run.dirs["root_gc"].
    """
    args, D = run.args, run.dirs
    gc_lines = []
    gc_dirs = {}                        # mode -> folder of corrected cluster files
    if not args.gain_correction:
        return gc_lines, gc_dirs
    import gain_vs_charge as GVC
    D["gc"] = os.path.join(run.out, "gain_vs_charge")
    os.makedirs(D["gc"], exist_ok=True)
    run_exts = sorted({int(ext[3:]) for _, ext, _ in tasks})
    modes = ["pooled", "per-image"] if args.gain_correction == "both" else [args.gain_correction]
    gc_dirs = {m: os.path.join(run.out, "root_gaincorr" if m == "pooled" else "root_gaincorr_per_image") for m in modes}
    for d in gc_dirs.values():
        os.makedirs(d, exist_ok=True)
    D["root_gc"] = gc_dirs.get("pooled", gc_dirs.get("per-image"))

    curves = measure_gain_curves(run, GVC, configs, run_exts, modes, gc_lines,
                                 on_curve=lambda mode, mpath, rs: apply_curve(run, GVC, gc_lines, mpath, rs, gc_dirs[mode]))
    if not args.no_clusters:
        for mode, d in gc_dirs.items():
            gcroots = sorted(glob.glob(os.path.join(d, "panaSKImg_clustersRec_*.root")))
            with open(os.path.join(d, "root_files.txt"), "w") as fh:
                fh.write("".join(p + "\n" for p in gcroots))
            gc_lines.append(f"  corrected cluster files ({mode}): {len(gcroots)} (list: "
                            f"{os.path.join(d, 'root_files.txt')})")
    if len(modes) == 2:
        gc_lines += compare_gain_corrections(configs, curves, gc_dirs, D["gc"], args.no_clusters)
    return gc_lines, gc_dirs


def step3d_agmx(run, gc_dirs):
    """Step 3d, --clusterer agmx|both: A_GMX clusters as panaSKImg cluster files (src/agmx_root.py).

    A_GMX runs on each CCD's calibrated image (<image>_EXT<n>_waders.fits.bz2, from step 2); its clusters become
    pysimdamicm Cluster objects (the ClusterFinder's class) and are written with the trees info/process_config of
    the CCD's panaSKImg file (root/). With --gain-correction the image is first converted to electrons with the
    same g(n) curves as root_gaincorr*/ (gain_vs_charge/, same --gain-anchor). Returns (lines, dirs, failed):
    summary lines, {'plain': root_agmx, 'pooled' / 'per-image': root_agmx_gaincorr*} and failed CCDs.
    """
    args, D = run.args, run.dirs
    if args.clusterer == "waders" or args.no_clusters:
        return [], {}, []
    import agmx_root as AR
    sets = {"plain": (os.path.join(run.out, "root_agmx"), None)}
    for mode in gc_dirs:
        name = "root_agmx_gaincorr" if mode == "pooled" else "root_agmx_gaincorr_per_image"
        sets[mode] = (os.path.join(run.out, name), D["gc"] + (":per-image" if mode == "per-image" else ""))
    lines = [f"A_GMX clusters (--clusterer {args.clusterer}, src/agmx_root.py, version {AR.AGMX_VERSION}; "
             f"recommended: agmx_blend < 0.02, agmx_ped < 10):"]
    failed = []
    dirs = {}
    for key, (outdir, curve) in sets.items():
        print(f"  {run.stamp()} A_GMX -> {os.path.basename(outdir)}/")
        files, bad = AR.run(run.out, outdir, curve, args.gain_anchor, args.jobs,
                            log=lambda m: print(f"  {run.stamp()} {m.strip()}", flush=True))
        dirs[key] = outdir
        lines.append(f"  {os.path.basename(outdir)}/: {len(files)} cluster files (list: "
                     f"{os.path.join(outdir, 'root_files.txt')})" + (f"; FAILED: {len(bad)} CCD(s)" if bad else ""))
        lines += [f"    FAILED {s} EXT{e}: {why}" for s, e, why in bad]
        failed += [f"A_GMX {s} EXT{e}" for s, e, _ in bad]
    return lines, dirs, failed


def step3c_composite(run, configs, gc_dirs, agmx_dirs=None):
    """Step 3c, --composite: MakeComposite_Fe55_Clusters_Extensions.cc once per image type and module.

    Runs on the gain-corrected cluster files if there are any (root_gaincorr/, or root_gaincorr_per_image/ with
    --gain-correction per-image), else on root/; with
    --gain-correction both also on root_gaincorr_per_image/ -> composite_per_image/. With --clusterer agmx the
    A_GMX files (root_agmx_gaincorr*/ or root_agmx/) are used instead; with --clusterer both they go to
    composite_agmx/ (composite_per_image_agmx/) in addition. The image type N (CCD geometry
    in the macro) comes from Image_<N> in the name or --image-number; the module from module_name(). Returns
    (comp_lines, comp_failed): summary lines and the names of failed runs.
    """
    args, D = run.args, run.dirs
    comp_lines = []
    comp_failed = []
    if not args.composite:
        return comp_lines, comp_failed
    comp_sets = [(D.get("root_gc", D["root"]), os.path.join(run.out, "composite"), "")]
    if len(gc_dirs) == 2:           # --gain-correction both: also the per-image corrected files
        comp_sets.append((gc_dirs["per-image"], os.path.join(run.out, "composite_per_image"), "_per_image"))
    if agmx_dirs:                   # --clusterer agmx: the A_GMX files instead; both: in addition
        a_sets = [(agmx_dirs.get("pooled", agmx_dirs.get("per-image", agmx_dirs["plain"])), "composite", "")]
        if "pooled" in agmx_dirs and "per-image" in agmx_dirs:
            a_sets.append((agmx_dirs["per-image"], "composite_per_image", "_per_image"))
        if args.clusterer == "both":
            comp_sets += [(d, os.path.join(run.out, c + "_agmx"), t + "_agmx") for d, c, t in a_sets]
        else:
            comp_sets = [(d, os.path.join(run.out, c), t) for d, c, t in a_sets]
    root_exe = shutil.which("root") or os.path.join(os.path.dirname(sys.executable), "root")
    for rootdir, cdir, tag in comp_sets:
        os.makedirs(os.path.join(cdir, "lists"), exist_ok=True)
        groups = {}
        comp_lines.append(f"MakeComposite (--composite, {args.composite_macro}) on the cluster files in {rootdir}:")
        for r in sorted(configs.values(), key=lambda r: r["stem"]):
            m = re.search(r"Image_(\d+)", r["stem"])
            num = args.image_number if args.image_number is not None else (int(m.group(1)) if m else None)
            module, why = module_name(acm_id(r["stem"]), r["orig"], run.modules)
            comp_lines.append(f"  {r['stem']}: Image {num if num is not None else '?'}, module {module} ({why})")
            if num is None:
                comp_lines.append("    not run: no Image_<N> in the name (use --image-number N)")
                continue
            files = sorted(glob.glob(os.path.join(rootdir, f"panaSKImg_clustersRec_{r['stem']}_ext*.root")))
            groups.setdefault((num, module), []).extend(files)
        # one at a time: the first run compiles the macro (ACLiC "+"), parallel runs would race on that
        for (num, module), files in sorted(groups.items()):
            name = f"Image_{num}_{module}"
            if not files:
                comp_lines.append(f"  {name}: not run (no cluster files)")
                continue
            lst = os.path.join(cdir, "lists", f"{name}_list.txt")
            with open(lst, "w") as fh:
                fh.write("".join(f + "\n" for f in files))
            log = os.path.join(D["logs"], f"composite{tag}_{name}.log")
            call = f'{args.composite_macro}+("{lst}",{num},"{module}","{cdir}")'
            print(f"  {run.stamp()} MakeComposite {name}{tag} ({len(files)} file(s))")
            with open(log, "w") as fh:
                rc = subprocess.run([root_exe, "-l", "-q", "-b", call], stdout=fh, stderr=subprocess.STDOUT).returncode
            plots = os.path.join(cdir, "Fe_55_Analysis_Plots", module, f"{name}_list")
            ok = rc == 0 and bool(glob.glob(os.path.join(plots, "compare", "*.png")))
            print(f"  {run.stamp()} MakeComposite {name}{tag}: {'done' if ok else 'FAILED, see ' + log}")
            comp_lines.append(f"  {name}: {'plots in ' + plots if ok else 'FAILED, see ' + log}")
            if not ok:
                comp_failed.append(name + tag)
    return comp_lines, comp_failed


# =============================================================================
# --engine native: steps 1-3d without panaSKImg (src/native_pipeline.py)
# =============================================================================
NATIVE_MODULES = ("numpy", "astropy", "scipy", "numba", "ROOT")


def check_engine(args, auto):
    """--engine / --thresholds checks (standard library only). auto: the --autoconfig-args, split."""
    if args.engine == "waders":
        if args.thresholds != "auto":
            sys.exit("run_WADERs: --thresholds belongs to --engine native; with --engine waders give the thresholds "
                     "with --autoconfig-args \"--cluster-threshold-e PIX SEED\" (or auto)")
        return
    if "--cluster-threshold-e" in auto:
        sys.exit("run_WADERs: with --engine native the cluster thresholds are set with --thresholds "
                 "(auto, sigma0 or PIX,SEED), not --autoconfig-args --cluster-threshold-e")
    if args.thresholds not in ("auto", "sigma0"):
        try:
            pix, seed = (float(v) for v in args.thresholds.split(","))
        except ValueError:
            sys.exit("run_WADERs: --thresholds: auto, sigma0 or PIX,SEED in electrons (e.g. 2.5,9.5)")


def native_record(img, s):
    """The per-image record the shared steps use (module_groups, measure_gain_curves, step3c_composite,
    compare_gain_corrections, step4_summary), from a native_pipeline.process_image summary."""
    ccds = s["ccds"]
    notes = []
    for e, c in sorted(ccds.items()):
        if "gain_note" in c:
            notes.append(f"  {e}: {c['gain_note']}")
            if c.get("pedestal_note"):
                notes.append(f"  {e}: NOTE {c['pedestal_note']}")
        elif not c.get("outlier"):              # skipped outliers are listed by step4_summary (r["skipped"])
            notes.append(f"  {e}: not run ({c.get('skipped')})")
    return dict(stem=s["stem"], src=img, orig=img, summary=s, notes=notes,
                fits={"dc": {e: c["fits"]["dc"] for e, c in ccds.items() if "fits" in c and "dc" in c["fits"]}},
                final={e: c["fits"]["final"] for e, c in ccds.items() if "fits" in c},
                held={e: tuple(c["held"]) for e, c in ccds.items() if c.get("held")},
                refs={e: c["lam01"] for e, c in ccds.items() if c.get("lam01") is not None},
                skipped=sorted(e for e, c in ccds.items() if c.get("outlier") and "skipped" in c))


def native_process(run, NP, tasks, failed):
    """native_pipeline.process_image on every (image, keyword arguments), -j images at a time (one process each).
    Failures are appended to `failed` as (stem, 'all', reason). Returns {image: summary}."""
    from multiprocessing import get_context
    done = {}
    with cf.ProcessPoolExecutor(max_workers=max(1, min(run.args.jobs, len(tasks))), mp_context=get_context("spawn")) as ex:
        futs = {ex.submit(NP._job, (img, run.out, kw)): img for img, kw in tasks}
        for fut in cf.as_completed(futs):
            img = futs[fut]
            s, err = fut.result()
            if err:
                print(f"  {run.stamp()} {image_stem(img)}: FAILED ({err.splitlines()[0]})")
                with open(os.path.join(run.dirs["logs"], f"{image_stem(img)}_native.log"), "w") as fh:
                    fh.write(err)
                failed.append((image_stem(img), "all", err.splitlines()[0]))
                continue
            done[img] = s
            for e, c in sorted(s["ccds"].items()):
                if "gain" in c:
                    nc = ", ".join(f"{k} {v['n_clusters']}" for k, v in c.items()
                                   if isinstance(v, dict) and "n_clusters" in v)
                    print(f"  {run.stamp()} {s['stem']} {e}: gain {c['gain']:.4f} ADU/e-, noise {c['noise_e']:.3f} e-, "
                          f"DC {c['dc_e']:.4f} e-/pix" + (f"; clusters: {nc}" if nc else ""))
                else:
                    print(f"  {run.stamp()} {s['stem']} {e}: not run ({c.get('skipped')})")
    return done


def run_native(run):
    """--engine native: steps 1-3d in python (src/native_pipeline.py), then --composite and the summary as with
    --engine waders. Per image one process (-j images at a time) does the pedestal, the two dark-current fits and the
    gain choice once and writes every requested set of cluster files from them:
      root/                  threshold clusters, energies with the fitted gain (3.74 eV/e-, as panaSKImg's root/)
      root_gaincorr*/        --gain-correction: the same clusters with g(n) energies (epsilon(T))
      root_agmx*/            --clusterer agmx|both: A_GMX on the calibrated image, and on the g(n) image
    With --gain-correction the fits run once beforehand without cluster files (they give each image's gain for the
    gain periods); g(n) is then measured from the raw images as in step 3b (measure_gain_curves).
    Returns the exit code."""
    args = run.args
    sys.path.insert(0, SRC_DIR)
    import fit_quality as FQ
    import gain_dc_split as G
    import native_pipeline as NP
    run.FQ, run.G = FQ, G
    prepare_output(run)
    D = run.dirs
    for k in ("json", "work"):                 # panaSKImg's folders: not used here
        shutil.rmtree(D.pop(k), ignore_errors=True)
    shutil.rmtree(D.pop("fits"), ignore_errors=True)
    run.t0 = time.time()
    thr = args.thresholds if args.thresholds in ("auto", "sigma0") else tuple(float(v) for v in args.thresholds.split(","))
    print(f"run_WADERs (engine native, {NP.VERSION}): {len(run.images)} image(s) -> {run.out}   "
          f"({args.jobs} images at a time; thresholds {args.thresholds})")
    kw = dict(thresholds=thr, anchor=args.gain_anchor, autoconfig_args=shlex.split(args.autoconfig_args),
              crowded=args.agmx_crowded, crowded_shapes=args.agmx_crowded_shapes, all_ext=args.all_ext, tune=args.tune,
              verbose=False)
    failed = []
    images = list(run.images)

    # ---- --gain-correction: fits first (each image's gain, for the gain periods), then g(n) from the raw images
    gc_lines, gc_dirs, curves = [], {}, {}
    if args.gain_correction:
        print(f"  {run.stamp()} fits of every CCD (for the g(n) groups)")
        pre = native_process(run, NP, [(img, dict(kw, outputs=[], write=False)) for img in images], failed)
        images = [img for img in images if img in pre]
        configs = {img: native_record(img, pre[img]) for img in images}
        import gain_vs_charge as GVC
        D["gc"] = os.path.join(run.out, "gain_vs_charge")
        os.makedirs(D["gc"], exist_ok=True)
        run_exts = sorted({int(e[3:]) for r in configs.values() for e in r["final"]})
        modes = ["pooled", "per-image"] if args.gain_correction == "both" else [args.gain_correction]
        gc_dirs = {m: os.path.join(run.out, "root_gaincorr" if m == "pooled" else "root_gaincorr_per_image") for m in modes}
        D["root_gc"] = gc_dirs.get("pooled", gc_dirs.get("per-image"))
        curves = measure_gain_curves(run, GVC, configs, run_exts, modes, gc_lines)

    # ---- the cluster files (all sets of one image from the same fits)
    agmx_dirs = {}
    if args.clusterer != "waders" and not args.no_clusters:
        agmx_dirs = {"plain": os.path.join(run.out, "root_agmx")}
        agmx_dirs.update({m: os.path.join(run.out, "root_agmx_gaincorr" + ("" if m == "pooled" else "_per_image"))
                          for m in gc_dirs})

    def outputs(img):
        """[(key, clusterer, folder, curve)] of one image"""
        if args.no_clusters:
            return []
        stem = image_stem(img)
        o = [("root", "threshold", D["root"], None)]
        o += [(f"gaincorr_{m}", "threshold", d, curves[(m, stem)]) for m, d in gc_dirs.items()]
        for key, d in agmx_dirs.items():
            o.append((f"agmx_{key}", "agmx", d, None if key == "plain" else curves[(key, stem)]))
        return o

    print(f"  {run.stamp()} " + ("fits only (--no-clusters)" if args.no_clusters else
                                 "cluster files: " + ", ".join(os.path.basename(d) + "/" for _, _, d, _ in outputs(images[0]))
                                 if images else "nothing to do"))
    final = native_process(run, NP, [(img, dict(kw, outputs=outputs(img), plots=True)) for img in images], failed)
    configs = {img: native_record(img, final[img]) for img in images if img in final}
    with open(os.path.join(run.out, "native_summary.json"), "w") as fh:
        json.dump([final[img] for img in images if img in final], fh, indent=1, default=str)

    # ---- file lists, the per-image vs pooled comparison, A_GMX lines
    def file_list(d):
        fs = sorted(glob.glob(os.path.join(d, "panaSKImg_clustersRec_*.root")))
        with open(os.path.join(d, "root_files.txt"), "w") as fh:
            fh.write("".join(f + "\n" for f in fs))
        return fs
    roots = [] if args.no_clusters else file_list(D["root"])
    if gc_dirs and not args.no_clusters:
        for mode, d in gc_dirs.items():
            gc_lines.append(f"  corrected cluster files ({mode}): {len(file_list(d))} (list: "
                            f"{os.path.join(d, 'root_files.txt')}; same clusters as root/, energies with g(n))")
    if len(gc_dirs) == 2:
        gc_lines += compare_gain_corrections(configs, curves, gc_dirs, D["gc"], args.no_clusters)
    agmx_lines = []
    if agmx_dirs:
        agmx_lines.append(f"A_GMX clusters (--clusterer {args.clusterer}, native: clustering_tests/adaptive.py engine "
                          f"'gmx'; recommended: agmx_blend < 0.02, agmx_ped < 10):")
        agmx_lines += [f"  {os.path.basename(d)}/: {len(file_list(d))} cluster files (list: "
                       f"{os.path.join(d, 'root_files.txt')})" for d in agmx_dirs.values()]

    # ---- --composite and the summary (shared with --engine waders)
    comp_lines, comp_failed = step3c_composite(run, configs, gc_dirs, agmx_dirs)
    rows = []
    for r in configs.values():
        for e, fit in sorted(r["final"].items()):
            q = G.held_quality(fit, r["refs"].get(e), r["held"].get(e))
            rows.append(dict(image=r["stem"], ext=e, gain_held=e in r["held"], **q))
    thr_lines = ["cluster thresholds (--engine native, --thresholds " + args.thresholds + "):"]
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        for e, c in sorted(r["summary"]["ccds"].items()):
            if "thresholds" in c:
                thr_lines.append(f"  {r['stem']} {e}: pixel > {c['thresholds']['pixel_e']:.2f} e-, seed >= "
                                 f"{c['thresholds']['seed_e']:.2f} e- ({c['thresholds']['note']})")
    step4_summary(run, configs, roots, failed, ([] if args.no_clusters else thr_lines + [""]) + gc_lines, comp_lines,
                  comp_failed, agmx_lines, fit_rows=rows, gain_details="native_summary.json")
    print(f"\nresults: {run.out}")
    return 1 if failed or comp_failed else 0


def step4_summary(run, configs, roots, failed, gc_lines, comp_lines, comp_failed, agmx_lines=(), agmx_failed=(),
                  fit_rows=None, gain_details="json/<image>/<image>_gain_dc_summary.txt"):
    """Step 4: fit_quality.csv and summary.txt (also printed).

    Per CCD, the dark-current fit of panaSKImg (root/dc_fits/) gives gain, noise and dark current; their errors are
    scaled by sqrt(chi2/ndf) (a fit with chi2/ndf > 1 underestimates its errors) and the dark current is compared with
    the one from the 0e-/1e- pixel counts (the "DC bias"). summary.txt then lists which gain was used per CCD and why,
    the cluster files, and the gain-correction and MakeComposite results. fit_rows: the per-CCD rows (held_quality
    dicts with image, ext, gain_held) when they do not come from panaSKImg's root/dc_fits/ (--engine native);
    gain_details: where the gain choice is documented.
    """
    args, D, G, FQ = run.args, run.dirs, run.G, run.FQ
    refs = {r["stem"]: r["refs"] for r in configs.values()}
    held = {r["stem"]: r["held"] for r in configs.values()}
    rows = list(fit_rows or [])
    for path in ([] if fit_rows is not None else sorted(glob.glob(os.path.join(D["fits"], "*_FitDarkCurrentProcess_side*.root")))):
        m = FQ.SIDE_RE.match(os.path.basename(path))
        if not m:
            continue
        stem, ext = m.group(1), m.group(2)
        fit = FQ.read_side_fit(path, ext)
        if fit is None:
            continue
        q = G.held_quality(fit, refs.get(stem, {}).get(ext), held.get(stem, {}).get(ext))
        rows.append(dict(image=stem, ext=ext, gain_held=ext in held.get(stem, {}), **q))
    if rows:
        import csv
        with open(os.path.join(run.out, "fit_quality.csv"), "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
            w.writeheader()
            w.writerows(rows)
    rows.sort(key=lambda q: (q["image"], q["ext"]))
    wid = max([len(q["image"]) for q in rows] + [5])
    lines = [f"run_WADERs summary: {run.run_name}  ({len(run.images)} image(s), {time.time() - run.t0:.0f} s)", "",
             f"{'image':{wid}} {'ext':4} {'chi2/ndf':>8} {'gain [ADU/e-]':>19} {'noise [e-]':>17} "
             f"{'DC [e-/pix]':>17} {'DC bias':>8}"]
    for q in rows:
        bias = f"{q['dc_bias']:+8.3f}" if q["dc_bias"] is not None else "       -"
        lines.append(f"{q['image']:{wid}} {q['ext']:4} {q['chi2ndf']:8.2f} "
                     f"{q['gain']:8.4f} +- {q['gain_err_s']:.4f}{'*' if q['gain_held'] else ' '} "
                     f"{q['noise']:7.4f} +- {q['noise_err_s']:.4f} {q['dc']:7.4f} +- {q['dc_err_s']:.4f} {bias}")
    lines += ["", "errors scaled by sqrt(chi2/ndf); * = gain held at the all-peaks fit; "
                  "DC bias = fit - dark current from the 0e-/1e- pixel counts", "",
              f"gain used per CCD (gain_dc_split: all-peaks fit vs 0e-/1e- fit; details in {gain_details}):"]
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        lines.append(f"  {r['stem']}")
        lines += [f"  {n}" for n in r["notes"]]
        if r["skipped"]:
            lines.append(f"    not run (flooded/unresolved CCD): {', '.join(r['skipped'])}"
                         + ("" if not args.all_ext else " -- run anyway (--all-ext)"))
    lines.append("")
    lines.append("cluster files: none (--no-clusters)" if args.no_clusters else
                 f"cluster files: {len(roots)} (list: {os.path.join(D['root'], 'root_files.txt')})")
    if gc_lines:
        lines += [""] + gc_lines
    if agmx_lines:
        lines += [""] + list(agmx_lines)
    if comp_lines:
        lines += [""] + comp_lines
    if failed:
        lines.append("FAILED runs: " + ", ".join(f"{s} {e}" for s, e, _ in failed))
    if comp_failed:
        lines.append("FAILED MakeComposite runs: " + ", ".join(comp_failed))
    if agmx_failed:
        lines.append("FAILED A_GMX CCDs: " + ", ".join(agmx_failed))
    text = "\n".join(lines)
    with open(os.path.join(run.out, "summary.txt"), "w") as fh:
        fh.write(text + "\n")
    print("\n" + text)


def main():
    """The whole pipeline: checks, environment, then steps 1-4 (see the module docstring)."""
    args = parse_args()
    run_name, images, out, modules = check_request(args)
    ensure_environment(args.env, needed=NATIVE_MODULES if args.engine == "native" else NEEDED_MODULES)  # may re-run
    # this script inside the conda environment and exit
    os.environ["AGMX_CROWDED"] = args.agmx_crowded   # read by clustering_tests/adaptive.py (A_GMX workers)
    os.environ["AGMX_CROWDED_SHAPES"] = args.agmx_crowded_shapes
    if args.temperature is not None:                 # read by src/pair_energy.py (gain_vs_charge, A_GMX) at import
        os.environ["COMM_TEMPERATURE_K"] = str(args.temperature)
    run = Run(args=args, run_name=run_name, images=images, out=out, modules=modules)
    if args.engine == "native":           # --engine native: steps 1-3d without panaSKImg
        sys.exit(run_native(run))
    load_pipeline_modules(run)
    prepare_output(run)

    run.t0 = time.time()
    print(f"run_WADERs: {len(images)} image(s) -> {out}   ({args.jobs} parallel runs)")
    configs = step1_configure(run)                                  # one JSON per CCD
    if args.no_clusters:
        drop_cluster_finding(configs)
    tasks, failed = step2_run_panaskimg(run, configs)               # panaSKImg per CCD
    roots = step3_collect_root_files(run)                           # cluster files -> root/
    gc_lines, gc_dirs = step3b_gain_correction(run, configs, tasks) # --gain-correction
    agmx_lines, agmx_dirs, agmx_failed = step3d_agmx(run, gc_dirs)  # --clusterer agmx|both
    comp_lines, comp_failed = step3c_composite(run, configs, gc_dirs, agmx_dirs)   # --composite
    step4_summary(run, configs, roots, failed, gc_lines, comp_lines, comp_failed, agmx_lines, agmx_failed)

    if not args.keep_work:
        shutil.rmtree(run.dirs["work"], ignore_errors=True)
    print(f"\nresults: {out}")
    sys.exit(1 if failed or comp_failed or agmx_failed else 0)


if __name__ == "__main__":
    main()
