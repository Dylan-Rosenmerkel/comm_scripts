#!/usr/bin/env python3
"""run_CICERO: starts CICERO/run_CICERO (a separate program with its own engine and modules; it does
not use bin/run_WADERs or src/). See CICERO/README.md, or run_CICERO -h / -h -v."""
import os
import runpy
import sys

script = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "CICERO", "run_CICERO")
sys.argv[0] = script
runpy.run_path(script, run_name="__main__")
