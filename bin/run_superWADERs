#!/usr/bin/env python3
"""run_superWADERs: the old name of run_CICERO (renamed 2026-11-23). Forwards everything to bin/run_CICERO."""
import os
import runpy
import sys

sys.stderr.write("run_superWADERs has been renamed to run_CICERO; running run_CICERO.\n")
script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "run_CICERO")
sys.argv[0] = script
runpy.run_path(script, run_name="__main__")
