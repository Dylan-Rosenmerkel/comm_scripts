#!/usr/bin/env python3
"""run_superWADERs: starts superWADERs/run_superWADERs (a separate program with its own engine and modules; it does
not use bin/run_WADERs or src/). See superWADERs/README.md, or run_superWADERs -h / -h -v."""
import os
import runpy
import sys

script = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "superWADERs", "run_superWADERs")
sys.argv[0] = script
runpy.run_path(script, run_name="__main__")
