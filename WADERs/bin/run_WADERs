#!/usr/bin/env python3
"""run_WADERs (WADERs version): one command from raw skipper-CCD image(s) to panaSKImg (WADERs) results, with the
comm_scripts additions done inside panaSKImg.

    run_WADERs <image.fz | image.fits | image.fits.bz2 | list.txt> [-o PARENT] [-j N] [options]
    run_WADERs -h        the options;   run_WADERs -h -v   the full guide (what each step does)

What happens, per image (each step is one function below)
---------------------------------------------------------
  check_request          inputs exist, output folder free, option combinations valid (standard library only)
  ensure_environment     if this python lacks ROOT/pysimdamicm, re-run inside the conda environment with panaSKImg
  step1_configure        one panaSKImg JSON per CCD (pysimdamicm.comm.gain_dc_split + autoconfig_panaSKImg):
                         settings measured from the raw pixels; the gain from a many-peak fit where that is more
                         precise, the dark current from the Poisson-like 0e-/1e- peaks
  step1b_gain_curves     --gain-correction: g(n) measured from the raw images (gain_vs_charge; plots of g(n),
                         the nonlinearity and A(n) in gain_vs_charge/); GainNonlinearityProcess added to the JSONs
  step1c_cluster_options --clusterer, --agmx-*, --auto-threshold written into the final JSONs (ClusterFinder
                         algorithm / agmx / spr_threshold_auto); --clusterer both: a second set of JSONs (final_agmx/)
  step2_run_panaskimg    panaSKImg once per CCD (--ext N), in parallel (twice with --clusterer both)
  step3_collect_root_files   cluster files -> root/ (and root_agmx/), dark-current fits -> root/dc_fits/
  step3c_composite       --composite: MakeComposite_Fe55_Clusters_Extensions.cc on the cluster files
  step4_summary          fit_quality.csv and summary.txt (gain, noise, dark current per CCD with fit errors)

Output: WADERs_analysis_<run name>/   (run name = image name, or the .txt name for a list)
    *.pdf, *_waders.fits.bz2   panaSKImg plots and processed images
    json/<image>/final/        the JSONs that were run (one per CCD): they show every option used
    json/<image>/final_agmx/   with --clusterer both: the JSONs of the A_GMX runs
    json/<image>/gain/, dc/    the intermediate JSONs (many-peak gain / 0e-1e- fit)
    root/                      cluster files, one per CCD (panaSKImg_clustersRec_<image>_extN.root): gain-corrected
                               with --gain-correction, A_GMX clusters with --clusterer agmx
    root_agmx/                 with --clusterer both: the A_GMX cluster files
    root/root_files.txt        full paths of the cluster files (input list for MakeComposite)
    root/dc_fits/              the dark-current fits (histogram + fitted function) as ROOT
    gain_vs_charge/            with --gain-correction: g(n) models (*_gain_vs_charge.json) and plots
    logs/                      panaSKImg and autoconfig logs
    summary.txt, fit_quality.csv   gain, noise, dark current per CCD with fit errors

Environment: python with numpy, astropy, PyROOT and pysimdamicm (this WADERs copy); A_GMX also needs numba, scipy,
scikit-image. If the python running it lacks them, a conda environment with panaSKImg is found and used ("conda run").
Run from a WADERs checkout without installing it: the checkout is put first on PYTHONPATH automatically.
Made from comm_scripts' bin/run_WADERs by utils/make_waders_run_script.py.
"""
# Only the standard library at module level: this part has to run in any python, before
# the environment with ROOT/pysimdamicm is found.
import argparse
import concurrent.futures as cf
import glob
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field

SCRIPT_PATH = os.path.realpath(__file__)
SCRIPT_DIR = os.path.dirname(SCRIPT_PATH)
# a WADERs checkout (bin/ next to pysimdamicm/): use it before any installed pysimdamicm, here and in the
# panaSKImg / conda subprocesses
WADERS_ROOT = os.path.dirname(SCRIPT_DIR)
if os.path.isdir(os.path.join(WADERS_ROOT, "pysimdamicm", "comm")):
    sys.path.insert(0, WADERS_ROOT)
    os.environ["PYTHONPATH"] = os.pathsep.join([WADERS_ROOT] + [p for p in os.environ.get("PYTHONPATH", "").split(os.pathsep) if p])
NEEDED_MODULES = ("numpy", "astropy", "ROOT", "pysimdamicm")
INSIDE_FLAG = "RUN_WADERS_IN_ENV"


def _comm_file(name):
    """path of pysimdamicm/comm/<name> without importing pysimdamicm (its __init__ needs ROOT)"""
    spec = importlib.util.find_spec("pysimdamicm")
    base = os.path.dirname(spec.origin) if spec and spec.origin else os.path.join(WADERS_ROOT, "pysimdamicm")
    return os.path.join(base, "comm", name)


_spec = importlib.util.spec_from_file_location("_waders_naming", _comm_file("naming.py"))
_naming = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_naming)
acm_id, image_stem = _naming.acm_id, _naming.image_stem      # standard library only, usable before the environment check
RESERVED_AUTOCONFIG = ("--peaks", "--per-ext", "--tune", "-o", "--output")


# =============================================================================
# Environment
# =============================================================================
def env_ready():
    """True if this python can run everything."""
    return all(importlib.util.find_spec(m) is not None for m in NEEDED_MODULES)


def find_conda():
    """conda / mamba / micromamba executable, or None."""
    cands = [os.environ.get("CONDA_EXE"), os.environ.get("MAMBA_EXE"),
             shutil.which("conda"), shutil.which("mamba"), shutil.which("micromamba")]
    home = os.path.expanduser("~")
    for base in ("miniforge3", "mambaforge", "miniconda3", "anaconda3", "micromamba"):
        cands.append(os.path.join(home, base, "bin", "conda"))
    cands += ["/opt/conda/bin/conda", "/opt/homebrew/Caskroom/miniforge/base/bin/conda",
              "/usr/local/Caskroom/miniforge/base/bin/conda"]
    return next((c for c in cands if c and os.path.isfile(c)), None)


def find_env(conda, name):
    """Prefix of the environment to use: --env/$WADERS_ENV, else the first one with panaSKImg."""
    try:
        out = subprocess.run([conda, "env", "list", "--json"], capture_output=True, text=True, check=True).stdout
        envs = json.loads(out).get("envs", [])
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
        return None
    if name:
        return next((e for e in envs if os.path.basename(e) == name or e == name), None)
    for e in envs:
        if os.path.isfile(os.path.join(e, "bin", "panaSKImg")) or os.path.isfile(os.path.join(e, "Scripts", "panaSKImg")):
            return e
    return None


def ensure_environment(env_name, prog="run_WADERs", script=SCRIPT_PATH, inside_flag=INSIDE_FLAG):
    """Return if this python is ready; otherwise re-run `script` (this one, or bin/run_AGMX) inside a conda env."""
    if env_ready():
        return
    missing = [m for m in NEEDED_MODULES if importlib.util.find_spec(m) is None]
    if os.environ.get(inside_flag):
        sys.exit(f"{prog}: the environment is missing {', '.join(missing)}")
    conda = find_conda()
    if not conda:
        sys.exit(f"{prog}: this python lacks {', '.join(missing)} and no conda was found. "
                 "Activate the environment with pysimdamicm and run again.")
    env = find_env(conda, env_name)
    if not env:
        sys.exit(f"{prog}: no conda environment with panaSKImg found"
                 + (f" (looked for '{env_name}')" if env_name else "") + "; use --env NAME")
    print(f"{prog}: using environment {env}", flush=True)
    cmd = [conda, "run"]
    if not os.path.basename(conda).startswith("micromamba"):
        cmd.append("--no-capture-output")
    cmd += ["-p", env, "python", script] + sys.argv[1:]
    environ = dict(os.environ, **{inside_flag: "1", "PYTHONUNBUFFERED": "1"})
    sys.exit(subprocess.run(cmd, env=environ).returncode)


# =============================================================================
# Inputs
# =============================================================================
IMAGE_EXT = (".fz", ".fits", ".fits.bz2", ".fits.gz")


def read_inputs(path):
    """(run name, [image paths]) from an image or a .txt list of images."""
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        sys.exit(f"run_WADERs: {path} not found")
    if path.endswith(".txt"):
        base = os.path.dirname(path)
        images = []
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line if os.path.isabs(line) else os.path.join(base, line)
                if not os.path.isfile(p):
                    sys.exit(f"run_WADERs: {p} (from {os.path.basename(path)}) not found")
                images.append(os.path.abspath(p))
        if not images:
            sys.exit(f"run_WADERs: no images listed in {path}")
        return os.path.basename(path)[:-4], images
    if not path.endswith(IMAGE_EXT):
        sys.exit(f"run_WADERs: {path} is neither an image ({', '.join(IMAGE_EXT)}) nor a .txt list")
    return image_stem(path), [path]


# =============================================================================
# --composite (MakeComposite_Fe55_Clusters_Extensions.cc)
# =============================================================================
DEFAULT_COMPOSITE_MACRO = os.path.expanduser(
    "~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc")
# ACM ids in the order of the modules in a data folder named ..._DMa_DMb_DMc_... (FT1, FT2, FT4)
ACM_ORDER = ("110", "109", "106")


def parse_modules(items):
    """{ACM id: module name} from --module ACM=NAME arguments."""
    modules = {}
    for it in items:
        acm, sep, name = it.partition("=")
        if not sep or not acm.strip() or not name.strip():
            sys.exit(f"run_WADERs: --module {it}: expected ACM=NAME, e.g. 109=DM02")
        modules[acm.strip()] = name.strip()
    return modules


def module_name(acm, src, modules):
    """Module name for an image: --module, else the DMa_DMb_DMc folder name, else ACM<id>."""
    if acm in modules:
        return modules[acm], "--module"
    m = re.search(r"(DM\d+)_(DM\d+)_(DM\d+)", os.path.dirname(src))
    if m and acm in ACM_ORDER:
        return m.group(ACM_ORDER.index(acm) + 1), "folder name"
    return (f"ACM{acm}" if acm else "DMXX"), "no module found"


# =============================================================================
# Main
# =============================================================================
HELP_DESCRIPTION = """\
Raw skipper-CCD image(s) -> one panaSKImg JSON per CCD -> panaSKImg (WADERs) per CCD
-> plots, cluster ROOT files and a fit summary, all in WADERs_analysis_<run name>/.

usage in short:
  run_WADERs image.fz                 analyse one image (.fz, .fits, .fits.bz2)
  run_WADERs images.txt               analyse a list (one image path per line)
  run_WADERs images.txt -o DIR -j 6   output in DIR, 6 panaSKImg runs at a time

The run name is the image name (one image) or the .txt name (a list). In a list,
relative paths are relative to the .txt; empty lines and lines starting with # are
ignored. Works from any folder and any python: if this python lacks ROOT/pysimdamicm,
the conda environment with panaSKImg is found and used automatically.
"""

HELP_EPILOG = """\
output (WADERs_analysis_<run name>/):
  *.pdf, *_waders.fits.bz2     panaSKImg plots and processed images
  summary.txt, fit_quality.csv gain, noise, dark current per CCD, with fit errors
                               (scaled by sqrt(chi2/ndf)) and the dark-current bias
  root/                        cluster files, one per CCD (..._extN.root)
  root/root_files.txt          full paths of those files (input list for e.g.
                               MakeComposite_Fe55_Clusters_Extensions.cc)
  root/dc_fits/                dark-current fits (histogram + function) as ROOT
  json/<image>/final/          the JSONs that were run, one per CCD
  json/<image>/gain/, dc/      intermediate JSONs (many-peak gain fit, 0e-/1e- fit)
  logs/                        panaSKImg and autoconfig logs
  composite/                   with --composite: MakeComposite plots and its input lists
  root_agmx/                   with --clusterer both: the A_GMX cluster files
  gain_vs_charge/              with --gain-correction: g(n) models and plots (g(n), nonlinearity, A(n))

what it does, per image (gain_dc_split.py --per-ext, always on):
  1. autoconfig measures every CCD from the raw pixels and writes two JSONs per CCD:
       json/<image>/dc/    fits only the Poisson-like 0e-/1e- peaks (unbiased dark current)
       json/<image>/gain/  fits all peaks (more lever arm for the gain)
  2. both are fitted with panaSKImg (pedestal + fit only, fast); per CCD the gain with
     the smaller error (scaled by sqrt(chi2/ndf)) is kept: the all-peaks gain is held
     in the final JSON if it is more precise and agrees with the 2-peak gain (3 sigma)
       json/<image>/final/                      the JSONs that are run
       json/<image>/<image>_gain_dc_summary.txt all fits compared, with errors
  3. panaSKImg runs once per CCD (--ext N) with the final JSONs, in parallel;
     flooded/unresolved CCDs are skipped (see --all-ext; --autoconfig-args "--cluster-all" runs them
     with cluster finding)
  summary.txt lists, per CCD, which gain was used and why (* = all-peaks gain held)

--tune (optional, off by default; adds ~1 min per image):
  Instead of taking the pedestal method and fit window from rules, each CCD's
  0e-/1e- JSON is checked with panaSKImg itself before the final run:
  1. pedestal: the per-row pedestal is computed with each candidate method (median
     of the overscan, Gaussian fit, lowest-peak finder for charged overscans), the
     DC fit is run for each, and the one with the smallest total fit error is kept
     (gain/noise/dark-current errors scaled by sqrt(chi2/ndf), plus the dark-current
     bias against the 0e-/1e- pixel counts; a parameter stuck at a limit is penalised).
     Smallest error, not smallest noise: a wrong pedestal can make the noise look
     smaller while biasing the dark current.
  2. window: panaSKImg is run with a wide window; in its own histogram the 0e- peak
     is located and the fit window and mu limits are centred on it (useful when the
     pedestal leaves the 0e- peak away from 0 ADU). The number of fitted peaks stays
     the module-wide choice.
  3. a check fit; its results are in logs/<image>_autoconfig_dc.log.
  The all-peaks (gain) JSON then uses the same pedestal and 0e- position.

--gain-correction pooled|per-image (optional): the gain falls slowly with the charge in a pixel
  (~3% at 1000 e-), so cluster energies come out low at keV energies. With this flag, BEFORE the
  panaSKImg runs, gain_vs_charge measures g(n) from the raw images (spacing of the electron comb at
  high charge, clean rows only; images of the same module together), and the final JSONs get
  GainNonlinearityProcess (after CalibrationProcess): panaSKImg's ClusterFinder corrects every
  cluster's pixel energies with n = A^-1(ADU), A(n) = integral of g (the correction of comm_scripts'
  gain_vs_charge apply). root/ then holds the corrected clusters; run without the flag for the
  uncorrected ones. Curves and plots in gain_vs_charge/: <name>_gain_vs_charge.png (g(n)),
  <name>_nonlinearity.png (A(n)/g(0) - n) and <name>_adu_of_n.png (A(n) and A(n) - g(0) n).
  --gain-anchor comb (default) uses the comb's whole g(n) including its low-charge gain; fit keeps
  each image's fitted gain at low charge. --gain-combine incoherent (default) | coherent: how the
  images of a module are combined. --gain-memory auto: remove the horizontal readout memory before
  measuring. --temperature K: energy per electron epsilon(T) of the corrected and A_GMX energies
  (default 130 K -> 3.7486 eV).
  --gain-model interpolated (default) | broken | linear | smooth: the form of g(n): monotone
  interpolation through the measured points, two straight lines with a fitted knot, one
  straight line (see gain_vs_charge.py; the straight line does not follow the measured
  curvature, the others do), or smooth: above 200 e- windows of the same width overlapping
  (4x the points) and a weighted fit of g(n) as a cubic in log n through them instead of a
  curve through every point; below 200 e- the standard points, as interpolated (reaches
  higher charge; same g(0)).
  --gain-periods auto (default) | off: images of one module are pooled only within a gain
  period. A change of the readout settings between campaigns shifts the gain of all CCDs
  (AMtest 106: 2.5-3.5 % lower from 2026-05-21); pooling both puts two combs on top of each
  other, and every line in the corrected energies comes out doubled. auto: the images are put
  in time order (date in the name), each image's gain (0e-/1e- fit, mean over the CCDs relative
  to the module median) is compared, and the module is split where the gain steps by > 1 %
  and > 5x the image-to-image scatter (gain_vs_charge.gain_periods; a single image with a poor
  fit is not a period). Each period gets its own curve, module_<ACM>_period<k>_gain_vs_charge.json;
  a CCD whose period curve is not usable gets the curve of the whole module. summary.txt lists
  the periods and the step. off: one curve per module.
  --gain-correction per-image: every image gets its own curve (the module curve for a CCD whose
  own comb is not usable).

--composite (optional): after the panaSKImg runs, MakeComposite_Fe55_Clusters_Extensions.cc
  (front/back composite clusters, Fe-55 Kalpha/Kbeta fits, CTI) is run with ROOT on the
  cluster files, once per image type and module (the gain-corrected files if
  --gain-correction is on: root_gaincorr/, or root_gaincorr_per_image/ with
  --gain-correction per-image; else root/; with --gain-correction both also
  root_gaincorr_per_image/ -> composite_per_image/):
    composite/lists/Image_<N>_<module>_list.txt          the file list given to the macro
    composite/Fe_55_Analysis_Plots/<module>/Image_<N>_<module>_list/
                                     ext1..ext4/ per-CCD plots, compare/ 2x2 comparisons
    logs/composite_Image_<N>_<module>.log                ROOT output
  The image type N comes from "Image_<N>" in the image name (--image-number N to set it);
  it selects the CCD geometry in the macro (4, 5, 6, 7, 8, 11). The module comes from
  --module ACM=NAME, else from a data folder named ..._DMa_DMb_DMc_... (ACM 110 -> DMa,
  109 -> DMb, 106 -> DMc), else ACM<id>. Macro: --composite-macro, $MAKECOMPOSITE_MACRO,
  else ~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc.

--clusterer waders|agmx|both (default waders): ClusterFinder's algorithm, set in the final JSONs.
  waders  threshold + connect (panaSKImg's ClusterFinder as always).
  agmx    A_GMX (model-based clustering that shares each pixel's charge; pysimdamicm/comm/adaptive.py):
          root/ holds A_GMX cluster files (same trees, plus agmx_* branches and agmx_config).
          Recommended for X-ray lines: agmx_blend < 0.02 and agmx_ped < 10 with the usual sigma_xy cut.
  both    waders in root/, and a second panaSKImg run per CCD with A_GMX (json/<image>/final_agmx/)
          -> root_agmx/; --composite runs on both (composite/, composite_agmx/).
  --agmx-crowded auto|on|off, --agmx-crowded-shapes on|off: A_GMX crowded mode and its muon lines and
          topology split (ClusterFinder agmx options crowded / crowded_shapes).
--auto-threshold: WADERs pixel and seed thresholds in electrons from each CCD's dark charge
  (ClusterFinder spr_threshold_auto: smallest k >= 2 with P(Poisson(lambda) >= k) <= 0.10, seed
  max(9.5, k + 0.5) e-); CCDs whose electron peaks are not resolved keep the configured thresholds.

settings you can pass with --autoconfig-args "..." (all inside one quoted string):
  --cluster-threshold-e PIX SEED  cluster thresholds in e- (pixel > PIX, seed > SEED);
                                  much faster on images with high dark current
  --plot-peaks N                  DC-fit plot shown up to N e- (default 5)
  --reference my.json             start from your own JSON instead of the built-in one
  --gain G                        gain prior [ADU/e-] if the peaks are hard to resolve
  --gain-min / --gain-max         gain search range [ADU/e-] (default 0.6 / 3.0)
  --lam-max L                     leave out rows with more than L e-/pix (default 1.0)
  --min-rows N                    minimum rows in the fit (default 25)
  --ccd-cols N                    override the active/overscan column boundary
  --dead-frac F / --keep-dead     detection of channels without a CCD / keep them
  --cluster-all                   search clusters even on flooded CCDs
  --max-peaks N                   maximum number of peaks considered (default 10)
  --poisson-tol T                 how closely a peak must follow Poisson to be
                                  fitted (default 0.25)
  (do not pass --peaks, --per-ext or --tune here: use run_WADERs' own --tune)

examples:
  run_WADERs avg_Image_8_Low_Temp_106_20260330_123052_21.fz
  run_WADERs my_images.txt -o ~/analysis -j 8
  run_WADERs my_images.txt --autoconfig-args "--cluster-threshold-e 2 5"
  run_WADERs image.fits.bz2 --overwrite --all-ext
  run_WADERs my_images.txt --no-clusters        noise/gain/dark current only, fast
  run_WADERs image.fz --tune                     pedestal and window checked per CCD
  run_WADERs images.txt --gain-correction        gain-corrected cluster files (g(n) inside panaSKImg)
  run_WADERs images.txt --auto-threshold         WADERs thresholds from the dark charge
  run_WADERs images.txt --gain-correction --clusterer both --composite
                                                 WADERs and A_GMX clusters, both through MakeComposite

environment variables: WADERS_ENV (conda environment), PANASKIMG (panaSKImg script),
  MAKECOMPOSITE_MACRO (MakeComposite_Fe55_Clusters_Extensions.cc for --composite)
"""


SHORT_DESCRIPTION = """\
Raw skipper-CCD image(s) -> one JSON per CCD -> panaSKImg per CCD -> plots, cluster
ROOT files and a fit summary in WADERs_analysis_<run name>/."""

SHORT_EPILOG = """\
examples:
  run_WADERs image.fz
  run_WADERs images.txt -o ~/analysis -j 8 --no-clusters

run_WADERs -h -v   full guide: output folders, what each step does, --tune, and all
                   settings for --autoconfig-args"""


def build_parser(full=False):
    """The command-line parser; full=True uses the long guide (HELP_DESCRIPTION/HELP_EPILOG) for -h -v."""
    ap = argparse.ArgumentParser(
        prog="run_WADERs",
        usage="run_WADERs INPUT [options]      (-h: flags, -h -v: full guide)",
        description=HELP_DESCRIPTION if full else SHORT_DESCRIPTION,
        epilog=HELP_EPILOG if full else SHORT_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", metavar="INPUT",
                    help="an image (.fz, .fits, .fits.bz2) or a .txt with one image path per line")
    ap.add_argument("-o", "--parent", metavar="DIR", default=".",
                    help="folder in which WADERs_analysis_<run name> is created (default: current folder)")
    ap.add_argument("-j", "--jobs", metavar="N", type=int, default=min(4, os.cpu_count() or 1),
                    help="number of panaSKImg runs at the same time (default: 4, or fewer if fewer CPUs)")
    ap.add_argument("--overwrite", action="store_true",
                    help="replace an existing WADERs_analysis_<run name> folder (otherwise it stops)")
    ap.add_argument("--all-ext", action="store_true",
                    help="also run CCDs flagged as flooded/unresolved (slow, fits not reliable); their clusters "
                         "are only searched with --autoconfig-args \"--cluster-all\" (which also runs them)")
    ap.add_argument("--no-clusters", action="store_true",
                    help="noise, gain and dark current only: leave out ClusterFinder and BuildClusterMask "
                         "(no cluster ROOT files; much faster)")
    ap.add_argument("--gain-correction", nargs="?", const="pooled", choices=("pooled", "per-image"),
                    metavar="MODE",
                    help="measure the gain vs charge per pixel g(n) from the raw images and correct the cluster "
                         "energies inside panaSKImg (GainNonlinearityProcess). MODE: pooled (default: one curve "
                         "per module) or per-image (details: -h -v)")
    ap.add_argument("--gain-model", choices=("interpolated", "broken", "linear", "smooth"), default="interpolated",
                    help="with --gain-correction: form of g(n): interpolated (default; monotone interpolation "
                         "through the measured points), broken (two straight lines, fitted knot), linear, or smooth (overlapping "
                         "windows and a smooth weighted fit above 200 e-, the standard points below; reaches higher "
                         "charge)")
    ap.add_argument("--gain-combine", choices=("coherent", "incoherent"), default="incoherent",
                    help="with --gain-correction: how several images of a module are combined for the module curve: "
                         "incoherent (default; comb powers added - independent of the image order) or coherent "
                         "(each image converted with its own curve, then all pixels pooled; reaches higher charge)")
    ap.add_argument("--gain-memory", choices=("off", "auto"), default="off",
                    help="with --gain-correction: remove the horizontal readout memory (a pixel keeps ~3e-4 of the "
                         "pixel read before it) before measuring g(n): off (default) or auto (coefficients fitted "
                         "per CCD; the comb stays visible to higher charge)")
    ap.add_argument("--gain-periods", choices=("auto", "off"), default="auto",
                    help="with --gain-correction: auto (default): split a module's images into gain periods where "
                         "their fitted gain steps (> 1 %%, e.g. new readout settings) and measure one curve per "
                         "period; off: one curve per module")
    ap.add_argument("--gain-anchor", choices=("comb", "fit"), default="comb",
                    help="with --gain-correction: convert with the comb's g(n) including its low-charge gain "
                         "(comb, default), or keep each image's fitted gain and correct only the charge "
                         "dependence (fit)")
    ap.add_argument("--clusterer", choices=("waders", "agmx", "both"), default="waders",
                    help="ClusterFinder algorithm in the final JSONs: waders (default; threshold + connect), agmx "
                         "(A_GMX clusters in root/) or both (waders in root/, A_GMX in root_agmx/; details: -h -v)")
    ap.add_argument("--agmx-crowded", choices=("auto", "on", "off"), default=os.environ.get("AGMX_CROWDED", "auto"),
                    help="with --clusterer agmx/both: A_GMX crowded mode (ClusterFinder agmx option crowded). auto (default): on "
                         "for CCDs whose core fill is >= 0.10 (dense tracks, e.g. L2 surface runs, Am-241); on; off")
    ap.add_argument("--agmx-crowded-shapes", choices=("on", "off"), default=os.environ.get("AGMX_CROWDED_SHAPES", "on"),
                    help="with --agmx-crowded: muons as line components of the A_GMX mixture and a topology split of "
                         "clusters (ClusterFinder agmx option crowded_shapes; default on; only on crowded CCDs)")
    ap.add_argument("--auto-threshold", action="store_true",
                    help="WADERs pixel/seed thresholds in e- from each CCD's dark charge (ClusterFinder "
                         "spr_threshold_auto; details: -h -v)")
    ap.add_argument("--temperature", type=float, default=None, metavar="K",
                    help="CCD operating temperature for the energy per electron epsilon(T) used for gain-corrected and A_GMX "
                         "energies (default: $COMM_TEMPERATURE_K or 130 K -> 3.7486 eV; details: -h -v)")
    ap.add_argument("--composite", action="store_true",
                    help="after panaSKImg, run MakeComposite_Fe55_Clusters_Extensions.cc on the cluster files, "
                         "once per image type and module (output in composite/; details: -h -v)")
    ap.add_argument("--composite-macro", metavar="PATH",
                    default=os.environ.get("MAKECOMPOSITE_MACRO", DEFAULT_COMPOSITE_MACRO),
                    help="with --composite: the macro to run (default: $MAKECOMPOSITE_MACRO, else "
                         "~/Documents/LSM_Module_Testing_Analysis/src/MakeComposite_Fe55_Clusters_Extensions.cc)")
    ap.add_argument("--module", metavar="ACM=NAME", action="append", default=[],
                    help="with --composite: module name of an ACM, e.g. --module 109=DM02 (repeat per ACM; "
                         "default: from a ..._DMa_DMb_DMc_... data folder name, else ACM<id>)")
    ap.add_argument("--image-number", metavar="N", type=int,
                    help="with --composite: image type given to the macro (default: Image_<N> in the image name)")
    ap.add_argument("--tune", action="store_true",
                    help="check each CCD's pedestal method and fit window with panaSKImg before the "
                         "final run (smallest total fit error; ~1 min more per image)")
    ap.add_argument("--keep-work", action="store_true",
                    help="keep the intermediate gain and 0e-/1e- fit runs in work/ (normally deleted)")
    ap.add_argument("--autoconfig-args", metavar='"ARGS"', default="",
                    help="extra settings for the JSON generation, in one quoted string (list: -h -v)")
    ap.add_argument("--env", metavar="NAME", default=os.environ.get("WADERS_ENV"),
                    help="conda environment to use if this python lacks pysimdamicm "
                         "(default: $WADERS_ENV, else the first environment with panaSKImg)")
    ap.add_argument("--panaskimg", metavar="PATH", default=os.environ.get("PANASKIMG"),
                    help="panaSKImg script to use (default: $PANASKIMG, else found automatically)")
    ap.add_argument("-v", "--verbose", action="store_true", help="with -h: show the full guide")
    return ap


def parse_args():
    """Parse the command line; -h together with -v prints the full guide and exits."""
    argv = sys.argv[1:]
    if any(a in ("-h", "--help") for a in argv) and any(a in ("-v", "--verbose") for a in argv):
        build_parser(full=True).print_help()
        sys.exit(0)
    return build_parser().parse_args()


@dataclass
class Run:
    """What the pipeline steps share for one run_WADERs call.

    args       the parsed command line
    run_name   image name (one image) or .txt name (a list); the output folder is WADERs_analysis_<run_name>
    images     absolute paths of the raw images
    out        the output folder
    modules    {ACM id: module name} from --module (used by --composite)
    panaskimg  path of the panaSKImg script
    dirs       output sub-folders: json, root, logs, work, fits (root/dc_fits), and, when made, gc (gain_vs_charge)
               and root_gc (the corrected cluster files given to --composite)
    t0         start time (for the [  12s] progress stamps)
    A, FQ, G   the pipeline modules autoconfig_panaSKImg, fit_quality and gain_dc_split (imported once the
               environment with ROOT/pysimdamicm is known to be available)
    """
    args: argparse.Namespace
    run_name: str
    images: list
    out: str
    modules: dict
    panaskimg: str = ""
    dirs: dict = field(default_factory=dict)
    t0: float = 0.0
    A: object = None
    FQ: object = None
    G: object = None

    def stamp(self):
        """Seconds since the start, formatted as in the progress lines: '[  12s]'."""
        return f"[{time.time() - self.t0:5.0f}s]"


def check_request(args):
    """Checks that need only the standard library, done before any conda environment is looked for (so mistakes
    give a clear message quickly). Returns (run_name, images, out, modules); resolves args.composite_macro."""
    run_name, images = read_inputs(args.input)
    out = os.path.join(os.path.abspath(args.parent), f"WADERs_analysis_{run_name}")
    if os.path.exists(out) and os.listdir(out) and not args.overwrite:
        sys.exit(f"run_WADERs: {out} already exists; use --overwrite to replace it")
    modules = parse_modules(args.module)
    if args.jobs < 1:
        sys.exit("run_WADERs: -j/--jobs must be at least 1")
    stems = {}
    for p in images:
        stems.setdefault(image_stem(p), []).append(p)
    dup = {s: ps for s, ps in stems.items() if len(ps) > 1}
    if dup:
        sys.exit("run_WADERs: images with the same name would overwrite each other's results: "
                 + "; ".join(f"{s}: {', '.join(ps)}" for s, ps in sorted(dup.items())))
    try:
        auto = shlex.split(args.autoconfig_args)
    except ValueError as e:
        sys.exit(f"run_WADERs: --autoconfig-args cannot be parsed ({e})")
    bad = sorted({a.split("=")[0] for a in auto} & set(RESERVED_AUTOCONFIG))
    if bad:
        sys.exit(f"run_WADERs: {', '.join(bad)} cannot be given in --autoconfig-args (run_WADERs sets "
                 "them; use run_WADERs' own --tune)")
    if args.clusterer != "waders" and args.no_clusters:
        sys.exit(f"run_WADERs: --clusterer {args.clusterer} needs panaSKImg's cluster files; it cannot be used with --no-clusters")
    if args.composite:
        if args.no_clusters:
            sys.exit("run_WADERs: --composite needs the cluster files; it cannot be used with --no-clusters")
        args.composite_macro = os.path.abspath(os.path.expanduser(args.composite_macro))
        if not os.path.isfile(args.composite_macro):
            sys.exit(f"run_WADERs: MakeComposite macro {args.composite_macro} not found; give --composite-macro PATH")
    return run_name, images, out, modules


def load_pipeline_modules(run):
    """Import the pipeline modules from pysimdamicm.comm (needs ROOT/pysimdamicm, so only after ensure_environment)
    and find panaSKImg (--panaskimg, else the one next to this script, else the one autoconfig_panaSKImg finds)."""
    from pysimdamicm.comm import autoconfig_panaSKImg as A
    from pysimdamicm.comm import fit_quality as FQ
    from pysimdamicm.comm import gain_dc_split as G
    run.A, run.FQ, run.G = A, FQ, G
    here = os.path.join(SCRIPT_DIR, "panaSKImg")
    run.panaskimg = run.args.panaskimg or (here if os.path.isfile(here) else A.DEFAULT_PANASKIMG)
    if not run.panaskimg or not os.path.isfile(run.panaskimg):
        sys.exit("run_WADERs: panaSKImg not found; give --panaskimg /path/to/panaSKImg")


def prepare_output(run):
    """Create the (emptied, with --overwrite) output folder and its json/, root/, root/dc_fits/, logs/, work/."""
    out = run.out
    if os.path.exists(out) and os.listdir(out):
        shutil.rmtree(out)                     # --overwrite (checked in check_request)
    D = {k: os.path.join(out, k) for k in ("json", "root", "logs", "work")}
    D["fits"] = os.path.join(D["root"], "dc_fits")
    for d in D.values():
        os.makedirs(d, exist_ok=True)
    if "_ext" in out:
        print("WARNING: the output path contains '_ext'; scripts that read the extension from "
              "'_ext<N>' in the path (MakeComposite_Fe55_Clusters_Extensions.cc) may misread it")
    run.dirs = D


def step1_configure(run):
    """Step 1: one panaSKImg JSON per CCD for every image (gain_dc_split.split_image), images in parallel.

    For each CCD, autoconfig measures the raw pixels; the image is fitted twice (0e-/1e- peaks only, for an unbiased
    dark current; all resolved peaks, for a more precise gain) and the more precise gain is kept in the final JSON.
    Returns {image path: result dict of split_image} (keys used later: stem, src, finals, held, refs, notes, skipped).
    """
    args, D = run.args, run.dirs

    def configure(img):
        """Run gain_dc_split on one image and move its autoconfig logs to logs/."""
        stem = run.G.image_stem(img)
        jdir = os.path.join(D["json"], stem)
        r = run.G.split_image(img, jdir, per_ext=True, panaskimg=run.panaskimg,
                              autoconfig_args=shlex.split(args.autoconfig_args),
                              work=os.path.join(D["work"], stem), final_fit=False, jobs=1, tune=args.tune)
        r["orig"] = img           # r["src"] may be a decompressed copy in work/ (deleted at the end)
        for lg in glob.glob(os.path.join(jdir, "autoconfig_*.log")):      # logs together
            shutil.move(lg, os.path.join(D["logs"], f"{stem}_{os.path.basename(lg)}"))
        return r

    configs = {}
    with cf.ThreadPoolExecutor(max_workers=args.jobs) as ex:
        futs = {ex.submit(configure, img): img for img in run.images}
        for f in cf.as_completed(futs):
            img = futs[f]
            try:
                r = f.result()
                configs[img] = r
                held = ", ".join(r["held"]) or "none"
                print(f"  {run.stamp()} JSONs ready: {r['stem']} (gain held: {held})")
            except Exception as err:                       # keep going with the other images
                print(f"  ERROR configuring {os.path.basename(img)}: {err}")
    return configs


def drop_cluster_finding(configs):
    """--no-clusters: remove ClusterFinder and BuildClusterMask from the final JSONs, so json/ shows what ran."""
    for r in configs.values():
        for ext, path, skip in r["finals"]:
            cfg = json.load(open(path))
            seq = cfg["process"]["sequence"].split(";")
            cfg["process"]["sequence"] = ";".join(
                p for p in seq if p.strip() not in ("ClusterFinder", "BuildClusterMask"))
            with open(path, "w") as fh:
                json.dump(cfg, fh, indent=4)
    print("  --no-clusters: ClusterFinder and BuildClusterMask removed from the final JSONs")


def _image_time(stem):
    """'YYYYMMDDhhmmss' from an image name (..._106_20250914_024425_6), '' if it has none."""
    m = re.search(r"_(\d{8})_(\d{6})(?:_|$)", stem)
    return m.group(1) + m.group(2) if m else ""


def module_groups(run, configs, GVC):
    """The images that share one g(n) curve: ({key: [config records]}, {key: module}, summary lines).

    Images of one module (ACM id in the name) share the CCDs: key = the ACM id. With --gain-periods auto a module
    is split into gain periods where the gain of all its CCDs steps (gain_vs_charge.gain_periods, on each image's
    0e-/1e- fit gain relative to the module median, averaged over the CCDs, in time order): key <ACM>_period<k>.
    """
    import numpy as np
    modules = {}
    for r in configs.values():
        modules.setdefault(acm_id(r["stem"]) or r["stem"], []).append(r)
    groups, parent, lines = {}, {}, []
    for key, rs in sorted(modules.items()):
        rs = sorted(rs, key=lambda r: (_image_time(r["stem"]), r["stem"]))
        gains = []                      # per image: {ext: (gain, error)} from the 0e-/1e- fit
        for r in rs:
            fits = r.get("fits", {}).get("dc", {})
            q = {e: run.FQ.quality(f) for e, f in fits.items() if e not in r.get("skipped", ())}
            gains.append({e: (v["gain"], max(v["gain_err_s"], 1e-4)) for e, v in q.items() if v.get("gain")})
        exts = sorted({e for g in gains for e in g})
        med = {e: float(np.median([g[e][0] for g in gains if e in g])) for e in exts}
        x, s, have = [], [], []
        for i, g in enumerate(gains):
            if g:
                d = np.array([np.log(v / med[e]) for e, (v, _) in g.items()])
                w = np.array([(v / err) ** 2 for e, (v, err) in g.items()])
                x.append(float(np.sum(w * d) / w.sum()))
                s.append(float(w.sum() ** -0.5))
                have.append(i)
        label = np.zeros(len(rs), int)
        if run.args.gain_periods == "auto" and len(have) >= 4:
            lab, bad = GVC.gain_periods(x, s)
            for i in range(len(rs)):            # an image without a gain fit: the period of the image before it
                j = max([k for k, h in enumerate(have) if h <= i], default=0)
                label[i] = lab[j]
        if label.max() == 0:
            groups[key], parent[key] = rs, key
            continue
        lines.append(f"  module {key}: {label.max() + 1} gain periods (the gain of its CCDs steps; one curve each):")
        rel = dict(zip(have, x))
        for k in range(label.max() + 1):
            members = [r for r, lb in zip(rs, label) if lb == k]
            ids = [i for i, lb in enumerate(label) if lb == k]
            gk = f"{key}_period{k + 1}"
            groups[gk], parent[gk] = members, key
            t0, t1 = _image_time(members[0]["stem"]), _image_time(members[-1]["stem"])
            when = (f"{t0[:4]}-{t0[4:6]}-{t0[6:8]} {t0[8:10]}:{t0[10:12]} .. {t1[:4]}-{t1[4:6]}-{t1[6:8]} "
                    f"{t1[8:10]}:{t1[10:12]}") if t0 and t1 else f"{members[0]['stem']} .. {members[-1]['stem']}"
            v = [rel[i] for i in ids if i in rel]
            lines.append(f"    period {k + 1}: {len(members)} image(s), {when}, gain "
                         f"{np.median(v) * 100:+.2f} % vs module median" if v else
                         f"    period {k + 1}: {len(members)} image(s), {when}")
        out = [rs[i]["stem"] for i, b in zip(have, bad) if b]
        if out:
            lines.append(f"    single-image gain outliers (poor 0e-/1e- fit?; kept in their period): {', '.join(out)}")
    return groups, parent, lines


def fallback_curve(path, images, res, other, source, E_PER_E):
    """A CCD whose own curve is not usable gets the curve of `other` (recorded as source / own_reason);
    rewrites the model file. Returns the CCDs replaced."""
    replaced = []
    for ext, rr in res.items():
        rr.setdefault("source", "own")
        if not rr.get("ok") and other.get(ext, {}).get("ok"):
            res[ext] = dict(other[ext], source=source, own_reason=rr.get("reason"))
            replaced.append(ext)
    if replaced:
        with open(path, "w") as fh:
            json.dump({"images": images, "e_per_electron_eV": E_PER_E, "extensions": res}, fh, indent=1)
    return replaced


def step2_run_panaskimg(run, configs, variant="final"):
    """Step 2: panaSKImg once per CCD (--ext N) with its JSON of json/<image>/<variant>/, all runs in parallel.
    variant "final" writes into the output folder; "final_agmx" (--clusterer both) into agmx_run/.

    CCDs flagged as flooded/unresolved by autoconfig are skipped unless --all-ext. A run counts as successful when
    its log contains "Finished correctly". Returns (tasks, failed): tasks = [(config, ext, json path)] that were run,
    failed = [(stem, ext, log path)].
    """
    args, D = run.args, run.dirs
    outdir = run.out if variant == "final" else os.path.join(run.out, "agmx_run")
    os.makedirs(outdir, exist_ok=True)
    tasks = []
    for img, r in configs.items():
        for ext, path, skip in r["finals"]:
            if skip and not args.all_ext:
                if variant == "final":
                    print(f"  {r['stem']} {ext}: skipped (unresolved outlier CCD; --all-ext to run it)")
                continue
            tasks.append((r, ext, path if variant == "final" else path.replace(os.sep + "final" + os.sep,
                                                                             os.sep + variant + os.sep)))

    def run_one(task):
        """panaSKImg on one CCD; returns (stem, ext, ok, log path)."""
        r, ext, path = task
        cfg = json.load(open(path))
        cmd = [sys.executable, run.panaskimg, r["src"], "-j", path, "-o", outdir + "/", "--save-plots", "--ext", ext[3:]]
        if cfg["input"]["image"].get("ACM_multi_extension", False):
            cmd.append("--acm")
        tag = "" if variant == "final" else "_agmx"
        log = os.path.join(D["logs"], f"{r['stem']}_{ext}_panaSKImg{tag}.log")
        with open(log, "w") as fh:
            subprocess.run(cmd, stdout=fh, stderr=subprocess.STDOUT)
        with open(log) as fh:
            ok = "Finished correctly" in fh.read()
        return r["stem"], ext, ok, log

    print(f"  running panaSKImg{' (A_GMX)' if variant != 'final' else ''}: {len(tasks)} CCD run(s)")
    failed = []
    with cf.ThreadPoolExecutor(max_workers=args.jobs) as ex:
        for fut in cf.as_completed([ex.submit(run_one, t) for t in tasks]):
            stem, ext, ok, log = fut.result()
            print(f"  {run.stamp()} {stem} {ext}: {'done' if ok else 'FAILED, see ' + log}")
            if not ok:
                failed.append((stem, ext, log))
    return tasks, failed


def step3_collect_root_files(run, variant="final"):
    """Step 3: move panaSKImg's cluster files to root/ (root_agmx/ for the A_GMX runs of --clusterer both) and its
    dark-current fits to root/dc_fits/, and write root_files.txt (full paths, the input list for e.g.
    MakeComposite). Returns the sorted cluster files."""
    out, D = run.out, run.dirs
    src = out if variant == "final" else os.path.join(out, "agmx_run")
    dst = D["root"] if variant == "final" else os.path.join(out, "root_agmx")
    os.makedirs(dst, exist_ok=True)
    for f in glob.glob(os.path.join(src, "panaSKImg_clustersRec_*.root")):
        shutil.move(f, os.path.join(dst, os.path.basename(f)))
    for f in glob.glob(os.path.join(src, "*_FitDarkCurrentProcess_side*.root")):
        if variant == "final":
            shutil.move(f, os.path.join(D["fits"], os.path.basename(f)))
        else:
            os.remove(f)                    # the same fit as the main run
    roots = sorted(glob.glob(os.path.join(dst, "panaSKImg_clustersRec_*.root")))
    with open(os.path.join(dst, "root_files.txt"), "w") as fh:
        fh.write("".join(p + "\n" for p in roots))
    if variant != "final":
        D["root_agmx"] = dst
    return roots


def measure_curve(run, GVC, rs, name, title, run_exts):
    """Measure g(n) from the raw images rs (gain_vs_charge.measure), save it as
    gain_vs_charge/<name>_gain_vs_charge.json (with the original image paths) and its plots
    (<name>_gain_vs_charge.png, <name>_nonlinearity.png, <name>_adu_of_n.png). Returns (json path, result per CCD)."""
    res = GVC.measure([r["src"] for r in rs], run_exts, verbose=False, model=run.args.gain_model,
                      combine=run.args.gain_combine, autoconfig_args=shlex.split(run.args.autoconfig_args),
                      memory=run.args.gain_memory)
    mpath = os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.json")
    with open(mpath, "w") as fh:
        json.dump({"images": [r["orig"] for r in rs], "e_per_electron_eV": GVC.E_PER_E, "extensions": res}, fh, indent=1)
    GVC.plot(res, os.path.join(run.dirs["gc"], f"{name}_gain_vs_charge.png"), title)
    GVC.plot_nonlinearity(res, os.path.join(run.dirs["gc"], f"{name}_nonlinearity.png"), title)
    GVC.plot_adu(res, os.path.join(run.dirs["gc"], f"{name}_adu_of_n.png"), title)
    return mpath, res


def report_curve(gc_lines, title, res):
    """Append one summary line per CCD describing a measured g(n) curve (or why there is none) to gc_lines."""
    for ext, rr in sorted(res.items()):
        if rr.get("ok"):
            m = rr["model"]
            gc_lines.append(f"  {title} {ext}: g(0) = {m['a']:.4f} ADU/e- (autoconfig comb gain {rr['g_1e']:.4f}), "
                            f"{rr['drop_at_1000'] * 100:.1f}% lower at 1000 e-, measured to "
                            f"{rr['n_max_measured']:.0f} e-"
                            + (f", nonlinearity {rr['nonlinearity']['c2']:.2e} x^2 {rr['nonlinearity']['c1']:+.4f} x"
                               if rr.get("nonlinearity") else "")
                            + (f" -- module curve: own comb not usable ({rr.get('own_reason')})"
                               if rr.get("source") == "module" else "")
                            + (f" [readout memory removed, kL {rr['memory']['kL']:.2e}]" if rr.get("memory") else ""))
        else:
            gc_lines.append(f"  {title} {ext}: no correction ({rr.get('reason')})")


def _edit_finals(configs, edit, variant="final"):
    """Apply edit(cfg dict, r, ext) to every final JSON (or to a copy in json/<image>/<variant>/)."""
    for r in configs.values():
        for ext, path, skip in r["finals"]:
            cfg = json.load(open(path))
            edit(cfg, r, ext)
            dst = path if variant == "final" else path.replace(os.sep + "final" + os.sep, os.sep + variant + os.sep)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "w") as fh:
                json.dump(cfg, fh, indent=4)


def step1b_gain_curves(run, configs):
    """Step 1b, --gain-correction: measure g(n) from the RAW images and put GainNonlinearityProcess into the final
    JSONs (after CalibrationProcess), so that panaSKImg writes gain-corrected cluster energies (root/).

    Why: the gain falls slowly with the charge in a pixel (~3 % at 1000 e-), so keV clusters come out low when every
    pixel is converted with the low-charge gain. g(n) is the spacing of the electron comb at high charge.
    Images of one module (ACM id in the name) share the CCDs:
      pooled     one curve per module from all its images
      per-image  one curve per image (the module curve where the image's own comb is not usable)
    Returns gc_lines (summary lines); sets run.dirs["gc"].
    """
    args, D = run.args, run.dirs
    gc_lines = []
    if not args.gain_correction:
        return gc_lines
    from pysimdamicm.comm import gain_vs_charge as GVC
    D["gc"] = os.path.join(run.out, "gain_vs_charge")
    os.makedirs(D["gc"], exist_ok=True)
    run_exts = sorted({int(ext[3:]) for r in configs.values() for ext, _, _ in r["finals"]})
    groups, parent, period_lines = module_groups(run, configs, GVC)      # modules, split into gain periods
    model_of = {}                       # image stem -> model file
    gc_lines.append(f"gain vs charge per pixel (--gain-correction {args.gain_correction}, --gain-model {args.gain_model}, "
                    f"--gain-anchor {args.gain_anchor}): measured from the raw images, applied inside panaSKImg by "
                    f"GainNonlinearityProcess (root/ holds the corrected clusters):")
    gc_lines += period_lines
    whole = {}                          # module -> curve from all its images (fallback for a period's unusable CCDs)
    for key, rs in sorted(groups.items()):
        print(f"  {run.stamp()} g(n) for module {key} ({len(rs)} image(s))")
        mpath, res = measure_curve(run, GVC, rs, f"module_{key}", f"module {key}", run_exts)
        if key != parent[key] and not all(rr.get("ok") for rr in res.values()):
            m = parent[key]
            if m not in whole:
                print(f"  {run.stamp()} g(n) for module {m}, all periods (for the CCDs without a period curve)")
                whole[m] = measure_curve(run, GVC, [r for k, v in groups.items() if parent[k] == m for r in v],
                                         f"module_{m}", f"module {m}", run_exts)[1]
            fallback_curve(mpath, [r["orig"] for r in rs], res, whole[m], "module", GVC.E_PER_E)
        report_curve(gc_lines, f"module {key}", res)
        if args.gain_correction == "pooled":
            model_of.update({r["stem"]: mpath for r in rs})
            continue
        for r in sorted(rs, key=lambda r: r["stem"]):
            print(f"  {run.stamp()} g(n) for image {r['stem']}")
            ipath, ires = measure_curve(run, GVC, [r], f"image_{r['stem']}", r["stem"], run_exts)
            for ext, rr in ires.items():       # fallback to the module curve, recorded in the file
                rr["source"] = "image"
                mod = res.get(ext, {})
                if not rr.get("ok") and mod.get("ok"):
                    ires[ext] = dict(mod, source="module", own_reason=rr.get("reason"))
            with open(ipath, "w") as fh:
                json.dump({"images": [r["orig"]], "e_per_electron_eV": GVC.E_PER_E, "extensions": ires}, fh, indent=1)
            report_curve(gc_lines, r["stem"], ires)
            model_of[r["stem"]] = ipath

    def edit(cfg, r, ext):
        p = cfg["process"]
        seq = [s for s in p["sequence"].split(";") if s and s != "GainNonlinearityProcess"]
        k = seq.index("CalibrationProcess") + 1 if "CalibrationProcess" in seq else len(seq)
        seq.insert(k, "GainNonlinearityProcess")
        p["sequence"] = ";".join(seq)
        p["GainNonlinearityProcess"] = {"model_file": model_of[r["stem"]], "anchor": args.gain_anchor,
                                        "temperature": args.temperature}
    _edit_finals(configs, edit)
    return gc_lines


def step1c_cluster_options(run, configs):
    """Step 1c: the clustering options in the final JSONs (ClusterFinder):
      --auto-threshold      spr_threshold_auto (thresholds in e- from each CCD's dark charge)
      --clusterer agmx      algorithm "agmx" with the --agmx-* options (and --temperature)
      --clusterer both      as waders in final/, and a copy with algorithm "agmx" in final_agmx/
    Returns summary lines."""
    args = run.args
    lines = []
    if args.no_clusters:
        return lines

    def agmx_opts(cfg):
        return {"crowded": args.agmx_crowded, "crowded_shapes": args.agmx_crowded_shapes,
                "fe_candidates": os.environ.get("AGMX_FE_CANDIDATES", "1") != "0", "temperature": args.temperature,
                "first_row": cfg["input"]["image"].get("id_row_start", 0)}

    def edit(cfg, r, ext, algorithm):
        cf_ = cfg["process"].setdefault("ClusterFinder", {})
        cf_["algorithm"] = algorithm
        if algorithm == "agmx":
            cf_["agmx"] = agmx_opts(cfg)
        if args.auto_threshold:
            cf_["spr_threshold_auto"] = True
    main = "agmx" if args.clusterer == "agmx" else "waders"
    _edit_finals(configs, lambda c, r, e: edit(c, r, e, main))
    if args.clusterer == "both":
        _edit_finals(configs, lambda c, r, e: edit(c, r, e, "agmx"), variant="final_agmx")
    lines.append(f"clustering (ClusterFinder, set in json/<image>/final/): algorithm {main}"
                 + (f" (crowded {args.agmx_crowded}, shapes {args.agmx_crowded_shapes})" if main == "agmx" else "")
                 + (", thresholds from the dark charge (spr_threshold_auto)" if args.auto_threshold else ""))
    if args.clusterer == "both":
        lines.append(f"  --clusterer both: A_GMX runs with json/<image>/final_agmx/ (crowded {args.agmx_crowded}, "
                     f"shapes {args.agmx_crowded_shapes}) -> root_agmx/ (recommended: agmx_blend < 0.02, agmx_ped < 10)")
    elif main == "agmx":
        lines.append("  A_GMX cluster files in root/ (recommended: agmx_blend < 0.02, agmx_ped < 10)")
    return lines


def step3c_composite(run, configs, gc_dirs, agmx_dirs=None):
    """Step 3c, --composite: MakeComposite_Fe55_Clusters_Extensions.cc once per image type and module.

    Runs on the gain-corrected cluster files if there are any (root_gaincorr/, or root_gaincorr_per_image/ with
    --gain-correction per-image), else on root/; with
    --gain-correction both also on root_gaincorr_per_image/ -> composite_per_image/. With --clusterer agmx the
    A_GMX files (root_agmx_gaincorr*/ or root_agmx/) are used instead; with --clusterer both they go to
    composite_agmx/ (composite_per_image_agmx/) in addition. The image type N (CCD geometry
    in the macro) comes from Image_<N> in the name or --image-number; the module from module_name(). Returns
    (comp_lines, comp_failed): summary lines and the names of failed runs.
    """
    args, D = run.args, run.dirs
    comp_lines = []
    comp_failed = []
    if not args.composite:
        return comp_lines, comp_failed
    comp_sets = [(D["root"], os.path.join(run.out, "composite"), "")]       # root/: as configured (corrected, A_GMX)
    if D.get("root_agmx"):          # --clusterer both: also the A_GMX files
        comp_sets.append((D["root_agmx"], os.path.join(run.out, "composite_agmx"), "_agmx"))
    root_exe = shutil.which("root") or os.path.join(os.path.dirname(sys.executable), "root")
    for rootdir, cdir, tag in comp_sets:
        os.makedirs(os.path.join(cdir, "lists"), exist_ok=True)
        groups = {}
        comp_lines.append(f"MakeComposite (--composite, {args.composite_macro}) on the cluster files in {rootdir}:")
        for r in sorted(configs.values(), key=lambda r: r["stem"]):
            m = re.search(r"Image_(\d+)", r["stem"])
            num = args.image_number if args.image_number is not None else (int(m.group(1)) if m else None)
            module, why = module_name(acm_id(r["stem"]), r["orig"], run.modules)
            comp_lines.append(f"  {r['stem']}: Image {num if num is not None else '?'}, module {module} ({why})")
            if num is None:
                comp_lines.append("    not run: no Image_<N> in the name (use --image-number N)")
                continue
            files = sorted(glob.glob(os.path.join(rootdir, f"panaSKImg_clustersRec_{r['stem']}_ext*.root")))
            groups.setdefault((num, module), []).extend(files)
        # one at a time: the first run compiles the macro (ACLiC "+"), parallel runs would race on that
        for (num, module), files in sorted(groups.items()):
            name = f"Image_{num}_{module}"
            if not files:
                comp_lines.append(f"  {name}: not run (no cluster files)")
                continue
            lst = os.path.join(cdir, "lists", f"{name}_list.txt")
            with open(lst, "w") as fh:
                fh.write("".join(f + "\n" for f in files))
            log = os.path.join(D["logs"], f"composite{tag}_{name}.log")
            call = f'{args.composite_macro}+("{lst}",{num},"{module}","{cdir}")'
            print(f"  {run.stamp()} MakeComposite {name}{tag} ({len(files)} file(s))")
            with open(log, "w") as fh:
                rc = subprocess.run([root_exe, "-l", "-q", "-b", call], stdout=fh, stderr=subprocess.STDOUT).returncode
            plots = os.path.join(cdir, "Fe_55_Analysis_Plots", module, f"{name}_list")
            ok = rc == 0 and bool(glob.glob(os.path.join(plots, "compare", "*.png")))
            print(f"  {run.stamp()} MakeComposite {name}{tag}: {'done' if ok else 'FAILED, see ' + log}")
            comp_lines.append(f"  {name}: {'plots in ' + plots if ok else 'FAILED, see ' + log}")
            if not ok:
                comp_failed.append(name + tag)
    return comp_lines, comp_failed


def step4_summary(run, configs, roots, failed, gc_lines, comp_lines, comp_failed, agmx_lines=(), agmx_failed=()):
    """Step 4: fit_quality.csv and summary.txt (also printed).

    Per CCD, the dark-current fit of panaSKImg (root/dc_fits/) gives gain, noise and dark current; their errors are
    scaled by sqrt(chi2/ndf) (a fit with chi2/ndf > 1 underestimates its errors) and the dark current is compared with
    the one from the 0e-/1e- pixel counts (the "DC bias"). summary.txt then lists which gain was used per CCD and why,
    the cluster files, and the gain-correction and MakeComposite results.
    """
    args, D, G, FQ = run.args, run.dirs, run.G, run.FQ
    refs = {r["stem"]: r["refs"] for r in configs.values()}
    held = {r["stem"]: r["held"] for r in configs.values()}
    rows = []
    for path in sorted(glob.glob(os.path.join(D["fits"], "*_FitDarkCurrentProcess_side*.root"))):
        m = FQ.SIDE_RE.match(os.path.basename(path))
        if not m:
            continue
        stem, ext = m.group(1), m.group(2)
        fit = FQ.read_side_fit(path, ext)
        if fit is None:
            continue
        q = G.held_quality(fit, refs.get(stem, {}).get(ext), held.get(stem, {}).get(ext))
        rows.append(dict(image=stem, ext=ext, gain_held=ext in held.get(stem, {}), **q))
    if rows:
        import csv
        with open(os.path.join(run.out, "fit_quality.csv"), "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=list(rows[0].keys()))
            w.writeheader()
            w.writerows(rows)
    rows.sort(key=lambda q: (q["image"], q["ext"]))
    wid = max([len(q["image"]) for q in rows] + [5])
    lines = [f"run_WADERs summary: {run.run_name}  ({len(run.images)} image(s), {time.time() - run.t0:.0f} s)", "",
             f"{'image':{wid}} {'ext':4} {'chi2/ndf':>8} {'gain [ADU/e-]':>19} {'noise [e-]':>17} "
             f"{'DC [e-/pix]':>17} {'DC bias':>8}"]
    for q in rows:
        bias = f"{q['dc_bias']:+8.3f}" if q["dc_bias"] is not None else "       -"
        lines.append(f"{q['image']:{wid}} {q['ext']:4} {q['chi2ndf']:8.2f} "
                     f"{q['gain']:8.4f} +- {q['gain_err_s']:.4f}{'*' if q['gain_held'] else ' '} "
                     f"{q['noise']:7.4f} +- {q['noise_err_s']:.4f} {q['dc']:7.4f} +- {q['dc_err_s']:.4f} {bias}")
    lines += ["", "errors scaled by sqrt(chi2/ndf); * = gain held at the all-peaks fit; "
                  "DC bias = fit - dark current from the 0e-/1e- pixel counts", "",
              "gain used per CCD (gain_dc_split: all-peaks fit vs 0e-/1e- fit; details in "
              "json/<image>/<image>_gain_dc_summary.txt):"]
    for r in sorted(configs.values(), key=lambda r: r["stem"]):
        lines.append(f"  {r['stem']}")
        lines += [f"  {n}" for n in r["notes"]]
        if r["skipped"]:
            lines.append(f"    not run (flooded/unresolved CCD): {', '.join(r['skipped'])}"
                         + ("" if not args.all_ext else " -- run anyway (--all-ext)"))
    lines.append("")
    lines.append("cluster files: none (--no-clusters)" if args.no_clusters else
                 f"cluster files: {len(roots)} (list: {os.path.join(D['root'], 'root_files.txt')})")
    if gc_lines:
        lines += [""] + gc_lines
    if agmx_lines:
        lines += [""] + list(agmx_lines)
    if comp_lines:
        lines += [""] + comp_lines
    if failed:
        lines.append("FAILED runs: " + ", ".join(f"{s} {e}" for s, e, _ in failed))
    if comp_failed:
        lines.append("FAILED MakeComposite runs: " + ", ".join(comp_failed))
    if agmx_failed:
        lines.append("FAILED A_GMX CCDs: " + ", ".join(agmx_failed))
    text = "\n".join(lines)
    with open(os.path.join(run.out, "summary.txt"), "w") as fh:
        fh.write(text + "\n")
    print("\n" + text)


def main():
    """The whole pipeline: checks, environment, then steps 1-4 (see the module docstring)."""
    args = parse_args()
    run_name, images, out, modules = check_request(args)
    ensure_environment(args.env)          # may re-run this script inside the conda environment and exit
    os.environ["AGMX_CROWDED"] = args.agmx_crowded   # read by clustering_tests/adaptive.py (A_GMX workers)
    os.environ["AGMX_CROWDED_SHAPES"] = args.agmx_crowded_shapes
    if args.temperature is not None:                 # read by src/pair_energy.py (gain_vs_charge, A_GMX) at import
        os.environ["COMM_TEMPERATURE_K"] = str(args.temperature)
    run = Run(args=args, run_name=run_name, images=images, out=out, modules=modules)
    load_pipeline_modules(run)
    prepare_output(run)

    run.t0 = time.time()
    print(f"run_WADERs: {len(images)} image(s) -> {out}   ({args.jobs} parallel runs)")
    configs = step1_configure(run)                                  # one JSON per CCD
    gc_lines = step1b_gain_curves(run, configs)                     # --gain-correction: g(n) -> JSONs
    if args.no_clusters:
        drop_cluster_finding(configs)
    agmx_lines = step1c_cluster_options(run, configs)               # --clusterer, --agmx-*, --auto-threshold
    tasks, failed = step2_run_panaskimg(run, configs)               # panaSKImg per CCD
    roots = step3_collect_root_files(run)                           # cluster files -> root/
    if args.clusterer == "both" and not args.no_clusters:
        _, failed_a = step2_run_panaskimg(run, configs, "final_agmx")   # A_GMX runs -> root_agmx/
        step3_collect_root_files(run, "final_agmx")
        shutil.rmtree(os.path.join(run.out, "agmx_run"), ignore_errors=True)
        failed += [(s, e + " (A_GMX)", lg) for s, e, lg in failed_a]
    comp_lines, comp_failed = step3c_composite(run, configs, {}, None)    # --composite
    step4_summary(run, configs, roots, failed, gc_lines, comp_lines, comp_failed, agmx_lines, ())

    if not args.keep_work:
        shutil.rmtree(run.dirs["work"], ignore_errors=True)
    print(f"\nresults: {out}")
    sys.exit(1 if failed or comp_failed else 0)


if __name__ == "__main__":
    main()
